# The outside libraries of Nano's CMake build (docs/linux/IMPLEMENTATION.md C.2), each behind one
# name, nano::<name>, an INTERFACE target that links the library and carries its include dirs.
# Buildroot's recipe (linux/package/thimsy-nano/thimsy-nano.mk) depends on every package named
# here; its toolchain file points find_package and pkg-config at the staging directory.
#
#   nano_dep(<name> [REQUIRED] [PKG <pkg-config module>] [LIBS <names...>] [HEADER <header>]
#            [PATH_SUFFIXES <dirs...>])
#       sets NANO_HAVE_<name>. Tries pkg-config first (PKG), then find_library(LIBS) with
#       find_path(HEADER). A REQUIRED dependency that is not found is a configure error.
#   nano_dep_standard(<name> [REQUIRED])
#       the ones CMake has a find module (or a package config) for: zlib, openssl, curl, freetype,
#       png, jpeg, gif, alsa, tinyxml2, threads.

find_package(PkgConfig QUIET)

function(nano_dep name)
    cmake_parse_arguments(D "REQUIRED" "PKG;HEADER" "LIBS;PATH_SUFFIXES" ${ARGN})
    if(TARGET nano::${name})
        return()
    endif()
    set(_found FALSE)
    if(D_PKG AND PKG_CONFIG_FOUND)
        pkg_check_modules(NANO_PC_${name} QUIET IMPORTED_TARGET GLOBAL ${D_PKG})
        if(NANO_PC_${name}_FOUND)
            add_library(nano::${name} INTERFACE IMPORTED GLOBAL)
            set_property(TARGET nano::${name} PROPERTY INTERFACE_LINK_LIBRARIES PkgConfig::NANO_PC_${name})
            set(_found TRUE)
        endif()
    endif()
    if(NOT _found AND (D_LIBS OR D_HEADER))
        set(_ok TRUE)
        set(_libs "")
        set(_inc "")
        foreach(_l IN LISTS D_LIBS)
            find_library(NANO_LIB_${name}_${_l} NAMES ${_l})
            if(NANO_LIB_${name}_${_l})
                list(APPEND _libs "${NANO_LIB_${name}_${_l}}")
            else()
                set(_ok FALSE)
            endif()
        endforeach()
        if(D_HEADER)
            find_path(NANO_INC_${name} NAMES ${D_HEADER} PATH_SUFFIXES ${D_PATH_SUFFIXES})
            if(NANO_INC_${name})
                set(_inc "${NANO_INC_${name}}")
            else()
                set(_ok FALSE)
            endif()
        endif()
        if(_ok)
            add_library(nano::${name} INTERFACE IMPORTED GLOBAL)
            if(_libs)
                set_property(TARGET nano::${name} PROPERTY INTERFACE_LINK_LIBRARIES "${_libs}")
            endif()
            if(_inc)
                set_property(TARGET nano::${name} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
            endif()
            set(_found TRUE)
        endif()
    endif()
    set(NANO_HAVE_${name} ${_found} PARENT_SCOPE)
    if(NOT _found AND D_REQUIRED)
        message(FATAL_ERROR "nano: ${name} not found (pkg-config '${D_PKG}', libraries '${D_LIBS}', "
                            "header '${D_HEADER}'); docs/linux/IMPLEMENTATION.md C.2 lists what each "
                            "target links")
    endif()
endfunction()

# Wraps a target a find module (or package config) made in nano::<name>.
function(_nano_dep_alias name target)
    add_library(nano::${name} INTERFACE IMPORTED GLOBAL)
    set_property(TARGET nano::${name} PROPERTY INTERFACE_LINK_LIBRARIES ${target})
endfunction()

function(nano_dep_standard name)
    cmake_parse_arguments(D "REQUIRED" "" "" ${ARGN})
    if(TARGET nano::${name})
        set(NANO_HAVE_${name} TRUE PARENT_SCOPE)
        return()
    endif()
    set(_found FALSE)
    if(name STREQUAL "zlib")
        find_package(ZLIB QUIET)
        if(TARGET ZLIB::ZLIB)
            _nano_dep_alias(zlib ZLIB::ZLIB)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "crypto" OR name STREQUAL "ssl")
        find_package(OpenSSL QUIET)
        if(name STREQUAL "crypto" AND TARGET OpenSSL::Crypto)
            _nano_dep_alias(crypto OpenSSL::Crypto)
            set(_found TRUE)
        elseif(name STREQUAL "ssl" AND TARGET OpenSSL::SSL)
            _nano_dep_alias(ssl OpenSSL::SSL)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "curl")
        find_package(CURL QUIET)
        if(TARGET CURL::libcurl)
            _nano_dep_alias(curl CURL::libcurl)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "freetype")
        find_package(Freetype QUIET)
        if(TARGET Freetype::Freetype)
            _nano_dep_alias(freetype Freetype::Freetype)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "png")
        find_package(PNG QUIET)
        if(TARGET PNG::PNG)
            _nano_dep_alias(png PNG::PNG)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "jpeg")
        find_package(JPEG QUIET)
        if(TARGET JPEG::JPEG)
            _nano_dep_alias(jpeg JPEG::JPEG)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "gif")
        find_package(GIF QUIET)
        if(TARGET GIF::GIF)
            _nano_dep_alias(gif GIF::GIF)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "alsa")
        find_package(ALSA QUIET)
        if(TARGET ALSA::ALSA)
            _nano_dep_alias(alsa ALSA::ALSA)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "tinyxml2")
        find_package(tinyxml2 CONFIG QUIET)
        if(TARGET tinyxml2::tinyxml2)
            _nano_dep_alias(tinyxml2 tinyxml2::tinyxml2)
            set(_found TRUE)
        endif()
    elseif(name STREQUAL "threads")
        find_package(Threads REQUIRED)
        _nano_dep_alias(threads Threads::Threads)
        set(_found TRUE)
    else()
        message(FATAL_ERROR "nano: nano_dep_standard: no rule for ${name}")
    endif()
    # Before CMake 3.12 some modules had no imported target; the generic search covers those, and
    # tinyxml2 without a package config (pkg-config, or the bare library).
    if(NOT _found)
        if(name STREQUAL "tinyxml2")
            nano_dep(tinyxml2 PKG tinyxml2 LIBS tinyxml2 HEADER tinyxml2.h)
        elseif(name STREQUAL "curl")
            nano_dep(curl PKG libcurl LIBS curl HEADER curl/curl.h)
        elseif(name STREQUAL "jpeg")
            nano_dep(jpeg PKG libjpeg LIBS jpeg HEADER jpeglib.h)
        elseif(name STREQUAL "gif")
            nano_dep(gif LIBS gif HEADER gif_lib.h)
        elseif(name STREQUAL "alsa")
            nano_dep(alsa PKG alsa LIBS asound HEADER alsa/asoundlib.h)
        endif()
        if(TARGET nano::${name})
            set(_found TRUE)
        endif()
    endif()
    set(NANO_HAVE_${name} ${_found} PARENT_SCOPE)
    if(NOT _found AND D_REQUIRED)
        message(FATAL_ERROR "nano: ${name} not found; docs/linux/IMPLEMENTATION.md C.2 lists what each "
                            "target links, nano/test/host/DEPS.md the Ubuntu packages")
    endif()
endfunction()
