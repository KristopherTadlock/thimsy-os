From 17618e788577be1924aaf2a28b1f154e25946f83 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Se=C3=A1n=20Roche?=
 <35078186+senroche@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:22:00 +0000
Subject: [PATCH] kernel: free unused low RAM for Halo campaign allocations

---
 native/kernel/kernel.c | 1 +
 native/kernel/kernel.h | 5 ++++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/native/kernel/kernel.c b/native/kernel/kernel.c
index 801f0ffc80a..a65e950ed03 100644
--- a/native/kernel/kernel.c
+++ b/native/kernel/kernel.c
@@ -39,6 +39,7 @@ static const NcKExport *k_by_ordinal[NC_KORDINAL_MAX];
 #define K_IDT      0x11000u /* 256 gates of 8 bytes */
 #define K_FAST     0x12000u /* exports run as guest code (install_fast_paths) */
 #define K_FAST_END 0x13000u
+_Static_assert(K_FAST_END <= NC_KERNEL_SIZE, "kernel code fits in reserved physical RAM");
 
 /* Kernel pool: starts with one 64 KiB chunk of physical RAM, reached through
  * the contiguous window, and grows a chunk at a time as needed (pool.c), as
diff --git a/native/kernel/kernel.h b/native/kernel/kernel.h
index 68d2c9fb346..d284befc4fb 100644
--- a/native/kernel/kernel.h
+++ b/native/kernel/kernel.h
@@ -25,7 +25,10 @@ extern "C" {
 
 #define NC_KERNEL_VA     0x80010000u
 #define NC_KERNEL_PA     0x00010000u
-#define NC_KERNEL_SIZE   0x00040000u
+/* The HLE layout ends at offset 0x13000 (checked in kernel.c). Keep the
+ * reservation small: unused low physical pages are needed by titles that
+ * request constrained allocations after laying out their fixed heaps. */
+#define NC_KERNEL_SIZE   0x00020000u
 #define NC_KCALL_VECTOR  0x3Fu
 /* In the KPCR's page, past its fields (guest code reads it at fs:): 1 while
  * DPCs are queued (timer.c), for the guest-code KfLowerIrql (kernel.c). */
