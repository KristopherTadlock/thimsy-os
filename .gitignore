# Firmware downloads and build outputs are multi-GB and never committed.
/work/
/out/
*.7z
*.7z.[0-9][0-9][0-9]
*.img
*.pac
__pycache__/

# Signing keys and their passwords (tools/hakux KEY_PROPERTIES), e.g. in keys/.
/keys/
key.properties
*.jks
*.keystore

# tools/bbread's static binaries (tools/bbread/build.sh makes them).
/tools/bbread/bbread-*

# Personal editor settings.
/.vscode/
