bind event1 -> h700-gamepad
setup pad name="Thimsy Gamepad" bus=0x06 vendor=0x5448 product=0x0001 version=1
setup pad keys BTN_SOUTH BTN_EAST BTN_NORTH BTN_WEST BTN_TL BTN_TR BTN_TL2 BTN_TR2 BTN_SELECT BTN_START BTN_MODE BTN_THUMBL BTN_THUMBR
setup pad abs ABS_X -32768 32767
setup pad abs ABS_Y -32768 32767
setup pad abs ABS_RX -32768 32767
setup pad abs ABS_RY -32768 32767
setup pad abs ABS_HAT0X -1 1
setup pad abs ABS_HAT0Y -1 1
100 pad EV_KEY BTN_SOUTH 1
100 pad EV_SYN SYN_REPORT 0
120 pad EV_KEY BTN_SOUTH 0
120 pad EV_KEY BTN_MODE 1
120 pad EV_SYN SYN_REPORT 0
130 pad EV_KEY BTN_MODE 0
130 pad EV_SYN SYN_REPORT 0
200 pad EV_ABS ABS_X 16087
200 pad EV_ABS ABS_Y -32768
200 pad EV_ABS ABS_RY 32767
200 pad EV_SYN SYN_REPORT 0
210 pad EV_ABS ABS_X 0
210 pad EV_ABS ABS_Y 0
210 pad EV_SYN SYN_REPORT 0
220 pad EV_ABS ABS_X 32767
220 pad EV_SYN SYN_REPORT 0
300 pad EV_ABS ABS_HAT0X 1
300 pad EV_ABS ABS_HAT0Y 1
300 pad EV_SYN SYN_REPORT 0
400 intercept on
400 pad EV_ABS ABS_X 0
400 pad EV_ABS ABS_RY 0
400 pad EV_ABS ABS_HAT0X 0
400 pad EV_ABS ABS_HAT0Y 0
400 pad EV_SYN SYN_REPORT 0
400 tap EV_ABS ABS_X 32767
400 tap EV_ABS ABS_RY 32767
400 tap EV_SYN SYN_REPORT 0
410 tap EV_ABS ABS_X 0
410 tap EV_SYN SYN_REPORT 0
430 intercept off
430 tap EV_ABS ABS_RY 0
430 tap EV_SYN SYN_REPORT 0
430 pad EV_ABS ABS_RY 32767
430 pad EV_SYN SYN_REPORT 0
