bind event0 -> virtio-keyboard
setup pad name="Thimsy Gamepad" bus=0x06 vendor=0x5448 product=0x0001 version=1
setup pad keys BTN_SOUTH BTN_EAST BTN_NORTH BTN_WEST BTN_TL BTN_TR BTN_TL2 BTN_TR2 BTN_SELECT BTN_START BTN_MODE
setup pad abs ABS_X -32768 32767
setup pad abs ABS_Y -32768 32767
setup pad abs ABS_HAT0X -1 1
setup pad abs ABS_HAT0Y -1 1
100 pad EV_KEY BTN_SOUTH 1
100 pad EV_SYN SYN_REPORT 0
150 pad EV_KEY BTN_SOUTH 0
150 pad EV_SYN SYN_REPORT 0
300 pad EV_KEY BTN_MODE 1
300 pad EV_ABS ABS_HAT0X -1
300 pad EV_SYN SYN_REPORT 0
310 pad EV_KEY BTN_MODE 0
310 pad EV_ABS ABS_HAT0X 0
310 pad EV_SYN SYN_REPORT 0
