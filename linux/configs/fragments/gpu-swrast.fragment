# Mesa's software rasteriser (softpipe, no LLVM) for QEMU's virtio-gpu without
# virgl (decision I8), packed as gpu-swrast.erofs.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# BR2_PACKAGE_MESA3D_LLVM is not set
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_THIMSY_GPU_PACK=y
BR2_PACKAGE_THIMSY_GPU_PACK_SWRAST=y
