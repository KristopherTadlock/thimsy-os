# v1 adds to apps-alpha.fragment (a v1 target lists both): the other 19 cores
# of plan 6.2's Linux column, PPSSPP and ScummVM (IMPLEMENTATION.md E.3).
BR2_PACKAGE_LIBRETRO_FBNEO=y
BR2_PACKAGE_LIBRETRO_MAME2003_PLUS=y
BR2_PACKAGE_LIBRETRO_MAMEARCADE=y
BR2_PACKAGE_LIBRETRO_STELLA=y
BR2_PACKAGE_LIBRETRO_PROSYSTEM=y
BR2_PACKAGE_LIBRETRO_A5200=y
BR2_PACKAGE_LIBRETRO_GEARCOLECO=y
BR2_PACKAGE_LIBRETRO_BLUEMSX=y
BR2_PACKAGE_LIBRETRO_MEDNAFEN_VB=y
BR2_PACKAGE_LIBRETRO_MEDNAFEN_NGP=y
BR2_PACKAGE_LIBRETRO_MEDNAFEN_PCE_FAST=y
BR2_PACKAGE_LIBRETRO_MEDNAFEN_WSWAN=y
BR2_PACKAGE_LIBRETRO_MEDNAFEN_LYNX=y
BR2_PACKAGE_LIBRETRO_FAKE08=y
BR2_PACKAGE_LIBRETRO_OPERA=y
BR2_PACKAGE_LIBRETRO_YABASANSHIRO=y
BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT=y
BR2_PACKAGE_LIBRETRO_MELONDSDS=y
BR2_PACKAGE_LIBRETRO_FLYCAST=y

# Standalones on SDL's KMSDRM back end with OpenGL ES (until sdl2-compat on
# SDL3 replaces Buildroot's SDL2, decision I43).
BR2_PACKAGE_PPSSPP=y
BR2_PACKAGE_SCUMMVM=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
