# Development images: never published (decision I37; tools/defconfig.py
# --check refuses a publishable target that includes this fragment). adbd, a
# serial console (Buildroot's BR2_TARGET_GENERIC_GETTY, which release.fragment
# turns off; post-build.d/30-permissions.sh writes its inittab line), root
# login, and debugging tools. SSH at boot follows from the build type
# (ro.thimsy.build.type=dev, which root login makes): D50ssh decides.
BR2_THIMSY_FLAVOUR_DEV=y
# override: dev images allow root login, with an empty password; they stay with
# their developer
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
# override: the dev overlay goes on top of the common one: for now only its
# etc/motd (adbd's USB gadget set-up is G10's, on a device)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_THIMSY_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_THIMSY_PATH)/board/common/rootfs-overlay-dev"
BR2_PACKAGE_ANDROID_TOOLS=y
# BR2_PACKAGE_ANDROID_TOOLS_FASTBOOT is not set
# BR2_PACKAGE_ANDROID_TOOLS_ADB is not set
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
