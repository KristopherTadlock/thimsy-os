# The userland every tier carries (IMPLEMENTATION.md E.4's tier row): Nano and
# its services, sound, Wi-Fi, SSH and the filesystems' tools. Kept apart from
# the tier fragments, which differ only in CPU tuning, so the list is written
# once (principle 5).
BR2_PACKAGE_LIBTHIMSY=y
BR2_PACKAGE_THIMSY_NANO=y
BR2_PACKAGE_THIMSY_NANO_SCRAPE=y
BR2_PACKAGE_THIMSY_DATA=y
BR2_PACKAGE_THIMSY_SESSION=y
BR2_PACKAGE_THIMSY_PADD=y
BR2_PACKAGE_THIMSY_FONTS=y

# Network: the scraper and RetroAchievements over HTTPS.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
# BR2_PACKAGE_LIBCURL_CURL is not set
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WIRELESS_REGDB=y
# SSH: present, started by D50ssh only when the user turns it on (or at boot
# on dev images): dropbear in inetd mode ("dropbear -i") behind BusyBox
# tcpsvd and ssh-gate (local network only by default), root's password
# "thimsy" or the user's, and keys (decision OA-3; busybox.fragment).
# Dropbear's default options are assumed to keep INETD_MODE and password
# logins on (guess, from dropbear 2025's default_options.h).
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set

# Sound: alsactl restores the mixer in D20sound.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set

# Filesystems: the ext4 data partition, exFAT and FAT32 game drives (D10cards,
# D60firstboot). e2fsck (S00base's "e2fsck -p" of the data partition) is part
# of e2fsprogs' default install; mkfs.exfat comes from exfatprogs; sfdisk
# (D60firstboot adds and retypes the games entry) from util-linux's basic set
# (guess that sfdisk is in BR2_PACKAGE_UTIL_LINUX_BINARIES, as in 2025.02).
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# BusyBox applets the init scripts use beyond Buildroot's default set: ip
# (D30net), udhcpc, ntpd (D40time) and fractional sleep (rcK); see the
# fragment file.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THIMSY_PATH)/board/common/busybox.fragment"

BR2_TARGET_TZ_INFO=y

# Bluetooth (plan 5.2): BlueZ with bluetoothctl, which Nano's system actions
# run, and the D-Bus system bus it needs. Every tier carries them (one
# userland for every family); D35bluetooth starts them only on a device whose
# device.json says "bluetooth": true, and only once the user turned Bluetooth
# on: no D-Bus at boot otherwise. The HID and HoG plugins pair game pads.
# Licences (Buildroot's legal-info lists them from the recipes): BlueZ
# GPL-2.0+ (daemon, tools) and LGPL-2.1+ (library); D-Bus AFL-2.1 or
# GPL-2.0+; GLib LGPL-2.1+; readline GPL-3.0+ (bluetoothctl). Symbol names
# (guess) for 2026.08, as Buildroot 2025.02 has them.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
