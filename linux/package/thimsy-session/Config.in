config BR2_PACKAGE_THIMSY_SESSION
	bool "thimsy-session"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_7 # C++17
	select BR2_PACKAGE_LIBTHIMSY
	help
	  Starts and supervises Nano; drives, hotplug, power and
	  volume keys, sleep, the quit hotkey and the deferred start
	  of services (IMPLEMENTATION.md F.1). MIT.

	  SSH has no option here: D50ssh (board/common/rootfs-overlay)
	  decides by ro.thimsy.build.type. Dev images start dropbear
	  by default; release images only when the user turns SSH on,
	  and then key-only (decision I37).

comment "thimsy-session needs a toolchain w/ C++, threads, gcc >= 7"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_7
