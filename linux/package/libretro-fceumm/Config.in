config BR2_PACKAGE_LIBRETRO_FCEUMM
	bool "libretro-fceumm"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The fceumm core for RetroArch: NES and Famicom (wide mapper
	  coverage).

	  Set: alpha (IMPLEMENTATION.md E.3). Licence: GPL-2.0+.

	  https://github.com/libretro/libretro-fceumm

comment "libretro-fceumm needs a toolchain w/ threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_TOOLCHAIN_HAS_THREADS
