config BR2_PACKAGE_LIBRETRO_FAKE08
	bool "libretro-fake08"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The fake08 core for RetroArch: PICO-8.

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: MIT.

	  https://github.com/jtothebell/fake-08

comment "libretro-fake08 needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
