config BR2_PACKAGE_LIBRETRO_MEDNAFEN_NGP
	bool "libretro-mednafen-ngp"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The mednafen_ngp core for RetroArch: Neo Geo Pocket (Beetle
	  NeoPop).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0.

	  https://github.com/libretro/beetle-ngp-libretro

comment "libretro-mednafen-ngp needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
