################################################################################
#
# thimsy-data
#
################################################################################

# Nano's assets: the nano_tree.py export-assets output that linux/build.sh packs
# into $(THIMSY_SRC_DIR) as nano-assets-<sha>.tar.gz (decision G2a-15), with its
# hash file from build.sh. Only what assets.list allows is installed: the list
# is generated by linux/tools/assets_allowlist.py from ASSETS.md's KEEP rows,
# and its deny lines (every REPLACE and ASK row) win over any keep line
# (decision I38). Nano falls back where an asset is missing.
THIMSY_DATA_VERSION = $(THIMSY_GIT_SHA)
THIMSY_DATA_SITE = $(or $(THIMSY_SRC_DIR),$(DL_DIR)/thimsy-src)
THIMSY_DATA_SITE_METHOD = file
THIMSY_DATA_SOURCE = nano-assets-$(THIMSY_DATA_VERSION).tar.gz
THIMSY_DATA_LICENSE = CC-BY-4.0 (RetroArch icons), CC-BY-NC-4.0 (controller drawings), OFL-1.1 (fonts), MIT (ES-DE icons), Apache-2.0, Public Domain (NASA maps), Pixabay Content License (preview.wav)
# TODO(G2a, build.sh): the export carries no licence texts except the
# controllers' LICENSE; build.sh should add the repository's ATTRIBUTION.md and
# NOTICE to the tarball so legal-info can save them.
THIMSY_DATA_LICENSE_FILES = nano_xmb/controllers/LICENSE
THIMSY_DATA_DEPENDENCIES = host-python3

# Read by the install below: the export is laid out as /system/etc is on
# Android, and I14's /system/etc link points at this directory.
THIMSY_DATA_ETC = /usr/share/thimsy/system/etc

define THIMSY_DATA_CHECK_SOURCE
	@test -n "$(THIMSY_GIT_SHA)" || { \
		echo "thimsy-data: THIMSY_GIT_SHA is not set; build through linux/build.sh," \
			"which writes the source tarball"; exit 1; }
endef
THIMSY_DATA_PRE_DOWNLOAD_HOOKS += THIMSY_DATA_CHECK_SOURCE

define THIMSY_DATA_INSTALL_TARGET_CMDS
	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_THIMSY_PATH)/tools/assets_allowlist.py install \
		--list $(THIMSY_DATA_PKGDIR)/assets.list \
		--report $(@D)/.thimsy-data-report.txt \
		$(@D) $(TARGET_DIR)$(THIMSY_DATA_ETC)
endef

$(eval $(generic-package))
