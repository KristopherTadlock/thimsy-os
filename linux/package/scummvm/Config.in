config BR2_PACKAGE_SCUMMVM
	bool "scummvm"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2 # sdl2-compat on SDL3 when Thimsy adds it
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_FREETYPE
	help
	  ScummVM with its SDL back end and OpenGL ES 2, as the
	  Android app's version. GPL-3.0+.

	  https://www.scummvm.org/

comment "scummvm needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS

comment "scummvm needs OpenGL ES"
	depends on !BR2_PACKAGE_HAS_LIBGLES
