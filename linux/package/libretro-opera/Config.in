config BR2_PACKAGE_LIBRETRO_OPERA
	bool "libretro-opera"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The opera core for RetroArch: 3DO.

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: LGPL-2.1 and a non-
	  commercial licence.
	  Medium profile.

	  https://github.com/libretro/opera-libretro

comment "libretro-opera needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
