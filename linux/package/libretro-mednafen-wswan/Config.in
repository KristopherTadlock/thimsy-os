config BR2_PACKAGE_LIBRETRO_MEDNAFEN_WSWAN
	bool "libretro-mednafen-wswan"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The mednafen_wswan core for RetroArch: WonderSwan (Beetle
	  WonderSwan).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0.

	  https://github.com/libretro/beetle-wswan-libretro

comment "libretro-mednafen-wswan needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
