config BR2_PACKAGE_LIBRETRO_MEDNAFEN_PCE_FAST
	bool "libretro-mednafen-pce-fast"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The mednafen_pce_fast core for RetroArch: PC Engine (Beetle
	  PCE Fast).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0.

	  https://github.com/libretro/beetle-pce-fast-libretro

comment "libretro-mednafen-pce-fast needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
