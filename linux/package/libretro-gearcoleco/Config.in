config BR2_PACKAGE_LIBRETRO_GEARCOLECO
	bool "libretro-gearcoleco"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The gearcoleco core for RetroArch: ColecoVision.

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-3.0.

	  https://github.com/drhelius/Gearcoleco

comment "libretro-gearcoleco needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
