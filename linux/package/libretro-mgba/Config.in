config BR2_PACKAGE_LIBRETRO_MGBA
	bool "libretro-mgba"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The mgba core for RetroArch: Game Boy Advance.

