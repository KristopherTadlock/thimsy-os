config BR2_PACKAGE_LIBRETRO_MAMEARCADE
	bool "libretro-mamearcade"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10
	select BR2_PACKAGE_ZLIB
	help
	  The mamearcade core for RetroArch: arcade (current MAME,
	  arcade subtarget).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0+.
	  The arcade default on 2 GB images (Q10); a long build.

	  https://github.com/libretro/mame

comment "libretro-mamearcade needs a toolchain w/ C++, threads, gcc >= 10"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || !BR2_TOOLCHAIN_GCC_AT_LEAST_10
