config BR2_PACKAGE_LIBRETRO_MAME2003_PLUS
	bool "libretro-mame2003-plus"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_ZLIB
	help
	  The mame2003_plus core for RetroArch: arcade (MAME 0.78 sets).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: MAME licence (non-
	  commercial).
	  The arcade default on 1 GB images (Q10).

	  https://github.com/libretro/mame2003-plus-libretro

comment "libretro-mame2003-plus needs a toolchain w/ threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_TOOLCHAIN_HAS_THREADS
