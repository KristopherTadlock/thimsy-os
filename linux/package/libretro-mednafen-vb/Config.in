config BR2_PACKAGE_LIBRETRO_MEDNAFEN_VB
	bool "libretro-mednafen-vb"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The mednafen_vb core for RetroArch: Virtual Boy (Beetle VB).

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0.

	  https://github.com/libretro/beetle-vb-libretro

comment "libretro-mednafen-vb needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
