config BR2_PACKAGE_LIBRETRO_YABASANSHIRO
	bool "libretro-yabasanshiro"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_ZLIB
	help
	  The yabasanshiro core for RetroArch: Sega Saturn.

	  Set: v1 (IMPLEMENTATION.md E.3). Licence: GPL-2.0.
	  Renders with OpenGL ES 3 (Panfrost on Mali).
	  Medium profile; built with platform=arm64_cortex_a53_gles3.

	  https://github.com/libretro/yabause

comment "libretro-yabasanshiro needs a toolchain w/ C++, threads"
	depends on BR2_PACKAGE_RETROARCH
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
