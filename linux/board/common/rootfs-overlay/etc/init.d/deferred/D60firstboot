#!/bin/sh
# D60firstboot: the boot disk's first-boot work: random GPT GUIDs, the games
# partition (GPT entry 6) and the info entry's retirement.
# SPDX-License-Identifier: MIT
#
# The written image has entries 1 to 5 (IMPLEMENTATION E.6, decisions I39,
# OA-2): uboot, boot, root, data and info, a 1 MiB FAT that Android's vold
# mounts so a fresh card is not offered for formatting. On every boot this
# script, on the boot disk only and never on an eMMC (decision I40):
#   R. replaces the image's pinned GPT GUIDs with random ones (OA-9). The
#      image's are name-based (version 5) and the same on every card written
#      from it, so two such cards in one device share root=PARTUUID=. The
#      disk GUID (sfdisk --disk-id) and the unique GUID of each image entry
#      that is still version 5 (sfdisk --part-uuid) get a version 4 GUID from
#      the kernel, one write each, before anything else is written; a card
#      the installer wrote already has random ones and is left as it is;
#   0. moves the backup GPT to the end of the card if the image left it at
#      the image's end (sfdisk --relocate gpt-bak-std);
#   1. creates entry 6 over the free space from GAP_MIB after the last
#      entry, typed Linux reserved and named "games";
#   2. makes exFAT on it (label THIMSY);
#   3. retypes it Microsoft basic data;
#   4. retypes entry 5, info, Linux reserved: games is now the card's one
#      entry vold mounts, as the plan wants (8.2), and info's FAT stays as
#      it is under it.
# At no moment is there a basic-data entry without a filesystem: Android's
# vold would offer to format the card, and Windows would offer to format the
# partition. Each step is safe to repeat after a power cut: the state is
# read from the GPT on every run, and an entry 6 that is still Linux reserved
# and named games is ours and still empty, so it is formatted (again).
#
# The new GUIDs reach the kernel's partition list (PARTUUID= in uevents) at
# the next boot. Nothing needs them before: U-Boot reads entry 3's GUID for
# root=PARTUUID= on every boot (boot.cmd), QEMU boots root=/dev/vda3, there
# is no fstab, and S00base has already recorded the boot disk in
# /run/thimsy/bootdisk.
#
# A re-written card (device-safety-2): when the image is written again over a
# card that already has a Thimsy library, the image ends 1 MiB before games
# (genimage.cfg's size), so the library's exFAT is still there, boot region
# and all. Before step 1, if the region at the start holds a complete exFAT
# (whatever its label: the user may have renamed the library), entry 6 is
# created over its extent, typed basic data at once, and nothing is
# formatted. That is one sfdisk write, so a power cut leaves either no entry 6
# (adopted at the next boot) or the adopted one. When the region can't be
# read, nothing is done until the next boot: a read error never formats.
# Anything else there (no exFAT, or one whose format was cut) is formatted as
# on a first boot.
#
# An entry 6 of any other type or name is the user's and is left alone, and
# info then stays as it is.
. "${THIMSY_ROOT:-}/usr/share/thimsy/init/lib.sh"

TAG=D60firstboot
RESERVED=8da63339-0007-60c0-c436-083ac8230908
BASICDATA=ebd0a0a2-b9e5-4433-87c0-68b6b72699c7
LOG=$R/run/thimsy/log/firstboot.log
LOCK=$R/run/thimsy/firstboot.lock
PROBE=$R/run/thimsy/firstboot.probe
# The kernel's random GUIDs: a new one on every read.
UUID_SRC=$R/proc/sys/kernel/random/uuid
# The entries (E.6; gpt_check.py's INFO_INDEX and GAMES_INDEX).
INFO_N=5
GAMES_N=6
# games starts GAP_MIB after the 1 MiB boundary that ends the last entry; the
# image ends 1 MiB after that boundary (E.6; gpt_check.py's GAMES_GAP_MIB).
GAP_MIB=2

# is_pinned GUID: true for a name-based (version 5) GUID, as the image's
# are (OA-9); the kernel's, sfdisk's and the installer's are version 4.
is_pinned() {
	case $1 in
	????????-????-5???-[89abAB]???-????????????) return 0 ;;
	esac
	return 1
}

# parse_entry LINE: one partition line of "sfdisk --dump".
#   /dev/mmcblk1p4 : start=  1114112, size=  524288, type=933AC7E1-..., uuid=..., name="data"
parse_entry() {
	_node=${1%% : *}
	_rest=${1#* : }
	_n=${_node##*[!0-9]}
	_start= _size= _type= _uuid= _name=
	_oldifs=$IFS
	IFS=,
	set -f
	for _f in $_rest; do
		while :; do
			case $_f in
			' '*) _f=${_f# } ;;
			*) break ;;
			esac
		done
		case $_f in
		start=*) _start=${_f#start=} ;;
		size=*) _size=${_f#size=} ;;
		type=*) _type=${_f#type=} ;;
		uuid=*) _uuid=${_f#uuid=} ;;
		name=*)
			_name=${_f#name=}
			_name=${_name#\"}
			_name=${_name%\"}
			;;
		esac
	done
	set +f
	IFS=$_oldifs
	_start=${_start##* }
	_size=${_size##* }
	case $_start$_size in
	'' | *[!0-9]*) return 0 ;;
	esac
	_end=$((_start + _size))
	if [ "$_end" -gt "$MAX_END" ]; then
		MAX_END=$_end
	fi
	if [ -n "$_uuid" ]; then
		thimsy_lower_hex "$_uuid"
		USED="$USED $LOWER_OUT"
		if is_pinned "$_uuid"; then
			case $_name in
			uboot | boot | root | data | "$THIMSY_INFO_NAME") PINNED="$PINNED $_n" ;;
			esac
		fi
	fi
	if [ "$_n" = "$GAMES_N" ]; then
		thimsy_lower_hex "$_type"
		GE=1
		GE_TYPE=$LOWER_OUT
		GE_NAME=$_name
	elif [ "$_n" = "$INFO_N" ]; then
		thimsy_lower_hex "$_type"
		IE_TYPE=$LOWER_OUT
		IE_NAME=$_name
	fi
}

# read_table: LABEL, DISK_ID, LAST_LBA, SSZ, MAX_END, the GUIDs in use
# (USED), the image entries whose GUIDs are still pinned (PINNED), entry 6
# (GE_*) and entry 5 (IE_*) from the disk.
read_table() {
	LABEL= DISK_ID= LAST_LBA= SSZ=512 MAX_END=0 USED= PINNED=
	GE= GE_TYPE= GE_NAME= IE_TYPE= IE_NAME=
	_dump=$("$SFDISK" --dump "$DISK_DEV" 2>> "$LOG") || return 1
	while IFS= read -r _l; do
		case $_l in
		'label: '*) LABEL=${_l#label: } ;;
		'label-id: '*)
			DISK_ID=${_l#label-id: }
			thimsy_lower_hex "$DISK_ID"
			USED="$USED $LOWER_OUT"
			;;
		'last-lba: '*) LAST_LBA=${_l#last-lba: } ;;
		'sector-size: '*) SSZ=${_l#sector-size: } ;;
		*' : '*) parse_entry "$_l" ;;
		esac
	done <<EOF
$_dump
EOF
	[ "$LABEL" = gpt ] && [ -n "$LAST_LBA" ]
}

# new_guid: NEW_GUID, a random GUID from the kernel (lower case), refused
# unless it is version 4 and not already on the disk (USED).
new_guid() {
	NEW_GUID=
	{ read -r NEW_GUID < "$UUID_SRC"; } 2>/dev/null || :
	thimsy_lower_hex "$NEW_GUID"
	NEW_GUID=$LOWER_OUT
	case $NEW_GUID in
	????????-????-4???-[89ab]???-????????????) ;;
	*)
		thimsy_warn $TAG "no random GUID from $UUID_SRC (\"$NEW_GUID\")"
		return 1
		;;
	esac
	case "$USED " in
	*" $NEW_GUID "*)
		thimsy_warn $TAG "the kernel's random GUID $NEW_GUID is already on $BOOT_DISK"
		return 1
		;;
	esac
	USED="$USED $NEW_GUID"
}

# Step R. Returns 0 when none of the image's GUIDs is left, 1 when some are
# (warned; the next boot tries again, and the other steps still run), 2 when
# the table can no longer be read.
randomise_guids() {
	if [ -z "$PINNED" ] && ! is_pinned "$DISK_ID"; then
		return 0
	fi
	thimsy_log $TAG "replacing the image's GPT GUIDs on $BOOT_DISK with random ones"
	if is_pinned "$DISK_ID"; then
		if new_guid; then
			"$SFDISK" --disk-id "$DISK_DEV" "$NEW_GUID" >> "$LOG" 2>&1 ||
				thimsy_warn $TAG "sfdisk --disk-id failed"
		fi
	fi
	for _n in $PINNED; do
		if new_guid; then
			"$SFDISK" --part-uuid "$DISK_DEV" "$_n" "$NEW_GUID" >> "$LOG" 2>&1 ||
				thimsy_warn $TAG "sfdisk --part-uuid $_n failed"
		fi
	done
	"$SYNC"
	read_table || return 2
	if [ -n "$PINNED" ] || is_pinned "$DISK_ID"; then
		thimsy_warn $TAG "some of the image's GPT GUIDs are still on $BOOT_DISK; trying again at the next boot"
		return 1
	fi
	thimsy_warn $TAG "the GPT GUIDs of $BOOT_DISK are random now (the kernel lists them from the next boot)"
	return 0
}

# read_disk OFFSET COUNT: COUNT 512-byte blocks of the boot disk from byte
# OFFSET (a multiple of 512) into $PROBE.
read_disk() {
	rm -f "$PROBE"
	"$DD" if="$DISK_DEV" of="$PROBE" bs=512 skip=$(($1 / 512)) count="$2" 2>/dev/null &&
		[ -s "$PROBE" ]
}

# le OFFSET COUNT: LE_OUT is the COUNT-byte little-endian number at byte
# OFFSET of $PROBE.
le() {
	LE_OUT=0
	_bytes=$(od -A n -t u1 -v -j "$1" -N "$2" "$PROBE") || return 1
	_sh=0
	for _b in $_bytes; do
		LE_OUT=$((LE_OUT + (_b << _sh)))
		_sh=$((_sh + 8))
	done
	[ "$_sh" -eq $(($2 * 8)) ]
}

# label_entry BYTES...: the 32 bytes (decimal) of an exFAT volume-label entry.
# LABEL_TEXT is its label: ASCII characters as they are, any other as '?'.
label_entry() {
	shift
	_cnt=$1
	[ "$_cnt" -le 11 ] || _cnt=11
	LABEL_TEXT=
	_k=0
	while [ "$_k" -lt "$_cnt" ]; do
		if [ "$3" -eq 0 ] && [ "$2" -ge 32 ] && [ "$2" -lt 127 ]; then
			LABEL_TEXT=$LABEL_TEXT$(printf "\\$(printf '%03o' "$2")")
		else
			LABEL_TEXT="$LABEL_TEXT?"
		fi
		shift 2
		_k=$((_k + 1))
	done
}

# probe_library START: what the region at sector START holds.
#   0  a complete exFAT: the boot sector is one ("EXFAT   ", 55 AA, sane
#      shifts and lengths) and the first cluster of the root directory has
#      the allocation-bitmap (0x81) and up-case-table (0x82) entries. It is
#      adopted whatever its label. ADOPT_SECTORS is its extent (VolumeLength)
#      in disk sectors, clamped to the disk; ADOPT_LABEL its label ("" when it
#      has none).
#   1  no exFAT there, or one whose format was cut before its root directory.
#   2  unknown: the region could not be read (dd or od failed).
probe_library() {
	ADOPT_SECTORS=0
	ADOPT_LABEL=
	_base=$(($1 * SSZ))
	read_disk "$_base" 1 || return 2
	_sig=$(od -A n -t u1 -v -j 3 -N 8 "$PROBE") || return 2
	# shellcheck disable=SC2086
	set -- $_sig
	[ "$#" -eq 8 ] || return 2
	[ "$*" = "69 88 70 65 84 32 32 32" ] || return 1
	le 510 2 || return 2
	[ "$LE_OUT" -eq 43605 ] || return 1
	le 72 8 || return 2
	_vol_len=$LE_OUT
	le 88 4 || return 2
	_heap=$LE_OUT
	le 96 4 || return 2
	_root_cluster=$LE_OUT
	le 108 1 || return 2
	_bpss=$LE_OUT
	le 109 1 || return 2
	_spcs=$LE_OUT
	[ "$_bpss" -ge 9 ] && [ "$_bpss" -le 12 ] && [ $((_bpss + _spcs)) -le 25 ] &&
		[ "$_root_cluster" -ge 2 ] && [ "$_vol_len" -gt 0 ] || return 1
	# The first cluster of the root directory, at most 4 KiB of it.
	_root=$((_heap + ((_root_cluster - 2) << _spcs)))
	[ "$_root" -lt "$_vol_len" ] || return 1
	_cluster=$((1 << (_bpss + _spcs)))
	[ "$_cluster" -le 4096 ] || _cluster=4096
	read_disk $((_base + (_root << _bpss))) $((_cluster / 512)) || return 2
	_dir=$(od -A n -t u1 -v "$PROBE") || return 2
	rm -f "$PROBE"
	_bitmap= _upcase=
	# shellcheck disable=SC2086
	set -- $_dir
	[ "$#" -ge 32 ] || return 2
	while [ "$#" -ge 32 ]; do
		case $1 in
		0) break ;;   # the end of the directory
		129) _bitmap=1 ;;
		130) _upcase=1 ;;
		131)
			label_entry "$@"
			ADOPT_LABEL=$LABEL_TEXT
			;;
		esac
		shift 32
	done
	[ -n "$_bitmap" ] && [ -n "$_upcase" ] || return 1
	ADOPT_SECTORS=$(((_vol_len << _bpss) / SSZ))
	_room=$((LAST_LBA + 1 - start))
	if [ "$ADOPT_SECTORS" -gt "$_room" ]; then
		thimsy_warn $TAG "the old library's exFAT runs past the card ($ADOPT_SECTORS > $_room sectors): entry $GAMES_N ends at the card's end"
		ADOPT_SECTORS=$_room
	fi
	return 0
}

# Steps 0 and 1. Returns 0 when entry 6 exists afterwards, 1 on an error,
# 2 when there is no room for it, 3 when the games start could not be read
# (nothing created). ADOPTED=1 when an old library was taken.
create_entry() {
	ADOPTED=
	align=$((1048576 / SSZ))
	total=0
	if [ -r "$R/sys/class/block/$BOOT_DISK/size" ]; then
		read -r total < "$R/sys/class/block/$BOOT_DISK/size" || total=0
	fi
	total=$((total * 512 / SSZ))
	if [ "$total" -gt 0 ] && [ $((total - LAST_LBA)) -gt "$align" ]; then
		thimsy_log $TAG "moving the backup GPT to the end of $BOOT_DISK"
		"$SFDISK" --relocate gpt-bak-std "$DISK_DEV" >> "$LOG" 2>&1 || return 1
		read_table || return 1
	fi
	start=$(((MAX_END + align - 1) / align * align + GAP_MIB * align))
	free_mib=$(((LAST_LBA + 1 - start) / align))
	if [ "$free_mib" -lt "$THIMSY_GAMES_MIN_MIB" ]; then
		thimsy_warn $TAG "only $free_mib MiB free on $BOOT_DISK: no games partition"
		return 2
	fi
	# --force: the disk is in use (root and /storage are mounted), which
	# sfdisk refuses otherwise; it still tells the kernel about the new entry.
	probe_library "$start"
	probe=$?
	if [ "$probe" -eq 2 ]; then
		rm -f "$PROBE"
		thimsy_warn $TAG "could not read $BOOT_DISK at sector $start: entry $GAMES_N not created, trying again at the next boot"
		return 3
	fi
	if [ "$probe" -eq 0 ]; then
		if [ -z "$ADOPT_LABEL" ]; then
			_what="an exFAT without a label"
		elif [ "$ADOPT_LABEL" = "$THIMSY_GAMES_LABEL" ]; then
			_what="exFAT $THIMSY_GAMES_LABEL"
		else
			_what="an exFAT labelled \"$ADOPT_LABEL\""
		fi
		thimsy_warn $TAG "$_what found at sector $start: re-adopting it as entry $GAMES_N ($ADOPT_SECTORS sectors, basic data), not formatting"
		if [ $((ADOPT_SECTORS / align)) -lt "$THIMSY_GAMES_MIN_MIB" ]; then
			thimsy_warn $TAG "the adopted exFAT is under $THIMSY_GAMES_MIN_MIB MiB; it is kept as it is"
		fi
		printf 'start=%s, size=%s, type=%s, name="%s"\n' "$start" "$ADOPT_SECTORS" \
			"$BASICDATA" "$THIMSY_GAMES_NAME" |
			"$SFDISK" --force -N "$GAMES_N" "$DISK_DEV" >> "$LOG" 2>&1 || return 1
		ADOPTED=1
	else
		rm -f "$PROBE"
		thimsy_log $TAG "creating entry $GAMES_N at sector $start ($free_mib MiB), Linux reserved"
		printf 'start=%s, type=%s, name="%s"\n' "$start" "$RESERVED" "$THIMSY_GAMES_NAME" |
			"$SFDISK" --force -N "$GAMES_N" "$DISK_DEV" >> "$LOG" 2>&1 || return 1
	fi
	"$SYNC"
	read_table || return 1
	[ -n "$GE" ]
}

# announce PART: the kernel sent "add" when the entry appeared, before it had
# a filesystem or its final type; ask it to announce the partition again for
# thimsy-session.
announce() {
	{ echo change > "$R/sys/class/block/$1/uevent"; } 2>/dev/null || :
}

# Steps 2 and 3.
format_and_retype() {
	thimsy_partname "$BOOT_DISK" "$GAMES_N"
	part=$PARTNAME_OUT
	i=0
	while [ ! -e "$R/dev/$part" ]; do
		if [ "$i" -ge 5 ]; then
			thimsy_warn $TAG "no /dev/$part yet; finishing at the next boot"
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	thimsy_log $TAG "making exFAT $THIMSY_GAMES_LABEL on $part"
	"$MKFS_EXFAT" -L "$THIMSY_GAMES_LABEL" "$R/dev/$part" >> "$LOG" 2>&1 || {
		thimsy_warn $TAG "mkfs.exfat failed on $part"
		return 1
	}
	"$SYNC" || return 1
	thimsy_log $TAG "retyping entry $GAMES_N basic data"
	"$SFDISK" --part-type "$DISK_DEV" "$GAMES_N" "$BASICDATA" >> "$LOG" 2>&1 || {
		thimsy_warn $TAG "retyping entry $GAMES_N failed"
		return 1
	}
	"$SYNC" || return 1
	announce "$part"
	thimsy_warn $TAG "games partition $part ready"
}

# Step 4: once games (entry 6) is Thimsy's and basic data, info (entry 5,
# basic data and named info) is retyped Linux reserved. Anything else at
# entry 5 is left alone.
retire_info() {
	[ "$GE_TYPE" = "$BASICDATA" ] && [ "$GE_NAME" = "$THIMSY_GAMES_NAME" ] || return 0
	[ "$IE_TYPE" = "$BASICDATA" ] && [ "$IE_NAME" = "$THIMSY_INFO_NAME" ] || return 0
	thimsy_log $TAG "retyping entry $INFO_N ($THIMSY_INFO_NAME) Linux reserved: games is ready"
	"$SFDISK" --part-type "$DISK_DEV" "$INFO_N" "$RESERVED" >> "$LOG" 2>&1 || {
		thimsy_warn $TAG "retyping entry $INFO_N failed"
		return 1
	}
	"$SYNC"
}

firstboot() {
	if ! thimsy_load_bootdisk && ! thimsy_resolve_boot_disk; then
		thimsy_log $TAG "boot disk unknown: nothing done"
		return 0
	fi
	if thimsy_is_emmc "$BOOT_DISK"; then
		thimsy_log $TAG "boot disk $BOOT_DISK is an eMMC: nothing done"
		return 0
	fi
	DISK_DEV=$R/dev/$BOOT_DISK
	if ! read_table; then
		thimsy_warn $TAG "no GPT readable on $BOOT_DISK"
		return 1
	fi
	randomise_guids
	[ "$?" -eq 2 ] && return 1
	if [ -z "$GE" ]; then
		create_entry
		rc=$?
		[ "$rc" -eq 2 ] && return 0
		[ "$rc" -eq 3 ] && return 1
		[ "$rc" -eq 0 ] || {
			thimsy_warn $TAG "creating entry $GAMES_N failed"
			return 1
		}
		if [ -n "$ADOPTED" ]; then
			thimsy_partname "$BOOT_DISK" "$GAMES_N"
			announce "$PARTNAME_OUT"
			thimsy_warn $TAG "games partition $PARTNAME_OUT re-adopted: the library is kept"
			retire_info
			return
		fi
	fi
	if [ "$GE_TYPE" = "$BASICDATA" ]; then
		thimsy_log $TAG "entry $GAMES_N is basic data: games is done"
		retire_info
		return
	fi
	if [ "$GE_TYPE" != "$RESERVED" ] || [ "$GE_NAME" != "$THIMSY_GAMES_NAME" ]; then
		thimsy_log $TAG "entry $GAMES_N is not Thimsy's ($GE_TYPE, \"$GE_NAME\"): left alone"
		return 0
	fi
	format_and_retype || return 1
	read_table || return 1
	retire_info
}

case ${1:-start} in
start)
	mkdir -p "$R/run/thimsy/log"
	if ! mkdir "$LOCK" 2>/dev/null; then
		thimsy_log $TAG "already running"
		exit 0
	fi
	# rcK's TERM to everyone must not cut an sfdisk write in two: a torn
	# primary GPT leaves only the backup (device-safety-1). sfdisk and
	# mkfs inherit the ignored signals; rcK waits for the lock (10 s at most).
	trap '' TERM HUP INT
	firstboot
	rc=$?
	rm -f "$PROBE"
	rmdir "$LOCK" 2>/dev/null
	exit $rc
	;;
stop) ;;
*)
	echo "usage: $0 start|stop" >&2
	exit 2
	;;
esac
