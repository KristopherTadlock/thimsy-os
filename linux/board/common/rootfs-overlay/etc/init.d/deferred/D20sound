#!/bin/sh
# D20sound: the mixer state, restored after the first frame and saved by rcK.
# SPDX-License-Identifier: MIT
#
# The state lives on the data partition. Without one (first boot), the
# family's hook sets its defaults (THIMSY_HOOK=sound-defaults).
. "${THIMSY_ROOT:-}/usr/share/thimsy/init/lib.sh"

TAG=D20sound
STATE=$THIMSY_CONFIG/asound.state

# The codec may probe after the first frame; give it a few seconds.
wait_for_card() {
	i=0
	while [ ! -e "$R/proc/asound/card0" ] && [ "$i" -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e "$R/proc/asound/card0" ]
}

case ${1:-start} in
start)
	if ! wait_for_card; then
		thimsy_log $TAG "no sound card"
		exit 0
	fi
	if [ -r "$STATE" ]; then
		"$ALSACTL" -f "$STATE" restore > /dev/null 2>&1 ||
			thimsy_log $TAG "alsactl restore failed ($?)"
	else
		thimsy_family_hook sound-defaults
	fi
	;;
stop)
	[ -e "$R/proc/asound/card0" ] || exit 0
	[ -d "$THIMSY_CONFIG" ] || exit 0
	"$ALSACTL" -f "$STATE" store > /dev/null 2>&1 ||
		thimsy_log $TAG "alsactl store failed ($?)"
	;;
*)
	echo "usage: $0 start|stop" >&2
	exit 2
	;;
esac
