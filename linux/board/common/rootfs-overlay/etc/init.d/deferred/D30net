#!/bin/sh
# D30net: loopback, the host name, and Wi-Fi when the user left it on.
# SPDX-License-Identifier: MIT
#
# persist.thimsy.wifi.enabled=1 starts wpa_supplicant on the first wlan
# interface, with its control socket in /run/wpa_supplicant for Nano
# (wpa_ctrl), and BusyBox udhcpc in the foreground of a background job,
# retrying every second: "udhcpc -b" returns before an address exists and
# then waits much longer between tries (FlipBase's finding). Nano turns
# Wi-Fi on and off later through its own system actions.
. "${THIMSY_ROOT:-}/usr/share/thimsy/init/lib.sh"

TAG=D30net
CONF=$THIMSY_CONFIG/wpa_supplicant.conf
WPA_PID=$R/run/wpa_supplicant.pid
DHCP_PID=$R/run/udhcpc.pid

wifi_iface() {
	IFACE=
	i=0
	while [ "$i" -lt 5 ]; do
		for n in "$R"/sys/class/net/wlan*; do
			if [ -e "$n" ]; then
				IFACE=${n##*/}
				return 0
			fi
		done
		sleep 1
		i=$((i + 1))
	done
	return 1
}

seed_conf() {
	[ -e "$CONF" ] && return 0
	(
		umask 077
		printf '%s\n' 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=0' \
			'update_config=1' > "$CONF"
	)
}

stop_pidfile() {
	[ -r "$1" ] || return 0
	pid=
	read -r pid < "$1" || :
	case $pid in
	'' | *[!0-9]*) ;;
	*) kill "$pid" 2>/dev/null ;;
	esac
	rm -f "$1"
}

case ${1:-start} in
start)
	"$IP" link set lo up 2>/dev/null || thimsy_log $TAG "loopback not set up"
	if [ -r "$R/etc/hostname" ]; then
		"$HOSTNAME" -F "$R/etc/hostname" 2>/dev/null || :
	fi
	thimsy_persist persist.thimsy.wifi.enabled 0
	[ "$PERSIST_OUT" = 1 ] || exit 0
	if ! wifi_iface; then
		thimsy_log $TAG "Wi-Fi is on but there is no wlan interface"
		exit 0
	fi
	seed_conf
	"$WPA" -B -i "$IFACE" -c "$CONF" -P "$WPA_PID" > /dev/null 2>&1 || {
		thimsy_warn $TAG "wpa_supplicant failed on $IFACE"
		exit 1
	}
	"$UDHCPC" -i "$IFACE" -f -S -T 1 -A 2 -p "$DHCP_PID" > /dev/null 2>&1 &
	thimsy_log $TAG "Wi-Fi on $IFACE"
	;;
stop)
	stop_pidfile "$DHCP_PID"
	stop_pidfile "$WPA_PID"
	;;
*)
	echo "usage: $0 start|stop" >&2
	exit 2
	;;
esac
