+    static final int FUNCTION_RELEASE_NOTHING = 0;
+    static final int FUNCTION_RELEASE_QUICK_MENU = 1;
+    static final int FUNCTION_HOLD_NOTHING = 0;
+    static final int FUNCTION_HOLD_QUIT = 1;
+    static final int FUNCTION_HOLD_HOME = 2;
+    static final long FUNCTION_HOLD_MS = 3000;
+
+    /**
+     * What the function button does over an app when it is let go after heldMs; used: another key
+     * went down while it was held. A press shorter than the 3 s hold opens the Quick Menu, and with
+     * Universal Hotkeys off, where a non-HOME key has no hold, anything short of the 10 s recovery
+     * hold does. NanoDeviceKeys' functionRelease is the same.
+     */
+    static int functionRelease(boolean home, boolean hotkeys, boolean used, long heldMs) {
+        if (used || heldMs < 0) return FUNCTION_RELEASE_NOTHING;
+        final long limit = home || hotkeys ? FUNCTION_HOLD_MS : RECOVERY_HOLD_MS;
+        return heldMs < limit ? FUNCTION_RELEASE_QUICK_MENU : FUNCTION_RELEASE_NOTHING;
+    }
+
+    /**
+     * What the function button held on its own for {@link #FUNCTION_HOLD_MS} does: Home where it is
+     * Android's HOME key, Universal Hotkeys or not, so Home is always reachable; else the hold to
+     * quit, with hotkeys on. NanoDeviceKeys' functionHold is the same.
+     */
+    static int functionHold(boolean home, boolean hotkeys) {
+        if (home) return FUNCTION_HOLD_HOME;
+        return hotkeys ? FUNCTION_HOLD_QUIT : FUNCTION_HOLD_NOTHING;
+    }
+
+    /**
+     * The function button is the system's rather than the app's: Toolbox's "Anbernic Button Opens
+     * Quick Menu" is on (switchOn), or the key is HOME, which can't be given to an app.
+     */
+    static boolean functionToSystem(boolean home, boolean switchOn) {
+        return home || switchOn;
+    }
+
+    /** The built-in pad: retrogame_joypad on every handheld in the table (mods/keylayout). */
+    static final int BUILTIN_PAD_VENDOR = 0x484b;
+    static final int BUILTIN_PAD_PRODUCT = 0x1101;
+    // Android keycodes (KeyEvent) and Linux codes, kept here so the host test needs no android.jar.
+    private static final int BUTTON_A = 96, BUTTON_B = 97, BUTTON_C = 98, BUTTON_X = 99, BUTTON_Y = 100,
+            BUTTON_Z = 101, BUTTON_L1 = 102, BUTTON_R1 = 103, BUTTON_L2 = 104, BUTTON_R2 = 105,
+            BUTTON_THUMBL = 106, BUTTON_THUMBR = 107, BUTTON_START = 108, BUTTON_SELECT = 109,
+            BUTTON_MODE = 110;
+    private static final String[] KEYCODE_NAMES = {"BUTTON_A", "BUTTON_B", "BUTTON_C", "BUTTON_X",
+            "BUTTON_Y", "BUTTON_Z", "BUTTON_L1", "BUTTON_R1", "BUTTON_L2", "BUTTON_R2", "BUTTON_THUMBL",
+            "BUTTON_THUMBR", "BUTTON_START", "BUTTON_SELECT", "BUTTON_MODE"};
+
+    /**
+     * The Android keycode the Button Map Button arrives as from a device (button_map_overlay_plan.md
+     * §1.1; NanoButtonMap.cpp buttonMapKeycode, held to the same cases). FACE_SOUTH/EAST/NORTH/WEST
+     * are by position: the built-in pad's key layout and other pads' are by position (bottom is
+     * BUTTON_A), as is gammapad's virtual pad, whose ABXY Swap swaps every pad's before remap_btn
+     * and Generic.kl. Any other value is a keycode name. 0 for NONE.
+     */
+    static int buttonMapKeycode(String setting, int vendor, int product, boolean gammapad, boolean swap,
+            int gammapadVendor, int gammapadProduct, String remap) {
+        if (setting == null || setting.isEmpty()) setting = "FACE_SOUTH";
+        if (setting.equals("NONE")) return 0;
+        final String[] faces = {"FACE_SOUTH", "FACE_EAST", "FACE_NORTH", "FACE_WEST"};
+        int face = -1;
+        for (int i = 0; i < faces.length; i++) {
+            if (faces[i].equals(setting)) face = i;
+        }
+        if (face < 0) {
+            final String name = setting.startsWith("KEYCODE_") ? setting.substring(8) : setting;
+            for (int i = 0; i < KEYCODE_NAMES.length; i++) {
+                if (KEYCODE_NAMES[i].equals(name)) return BUTTON_A + i;
+            }
+            return 0;
+        }
+        final boolean virtual = gammapad && vendor == gammapadVendor && product == gammapadProduct;
+        if (!virtual) return new int[] {BUTTON_A, BUTTON_B, BUTTON_Y, BUTTON_X}[face];
+        // The built-in pad's print, B bottom, A right, X top, Y left: gammapad gives it by position, and
+        // ABXY Swap swaps that back.
+        int linux = new int[] {305, 304, 307, 308}[face];
+        if (!swap) {
+            switch (linux) {
+                case 304: linux = 305; break;
+                case 305: linux = 304; break;
+                case 307: linux = 308; break;
+                case 308: linux = 307; break;
+                default: break;
+            }
+        }
+        linux = remapCode(remap, linux);
+        return linux >= 304 && linux <= 318 ? GENERIC_KL[linux - 304] : 0;
+    }
+
+    // frameworks/base/data/keyboards/Generic.kl for BTN_A (304) .. BTN_THUMBR (318).
+    private static final int[] GENERIC_KL = {BUTTON_A, BUTTON_B, BUTTON_C, BUTTON_X, BUTTON_Y, BUTTON_Z,
+            BUTTON_L1, BUTTON_R1, BUTTON_L2, BUTTON_R2, BUTTON_SELECT, BUTTON_START, BUTTON_MODE,
+            BUTTON_THUMBL, BUTTON_THUMBR};
+
+    // gammapad's remap_btn: "from:to,..." in Linux codes, applied after the swap.
+    private static int remapCode(String remap, int code) {
+        if (remap == null) return code;
+        for (String pair : remap.split(",")) {
+            final int colon = pair.indexOf(':');
+            if (colon < 0) continue;
+            try {
+                final int from = Integer.parseInt(pair.substring(0, colon).trim());
+                final int to = Integer.parseInt(pair.substring(colon + 1).trim());
+                if (from == code && to > 0 && to < 0x300) return to;
+            } catch (NumberFormatException e) {
+                // a malformed pair is skipped, as gammapad does
+            }
+        }
+        return code;
+    }
+
+    /** The keys with no table: the RG Cube's. */
+    static ThimsyDeviceKeys builtin() {
+        return new ThimsyDeviceKeys("builtin", "", builtinFunction(), builtinBack(), false);
+    }
+
+    /** This device's keys; any problem with the table gives {@link #builtin()}. */
+    static ThimsyDeviceKeys load(Function<String, String> prop) {
+        try {
+            return resolve(new String(Files.readAllBytes(Paths.get(TABLE)),
+                    StandardCharsets.UTF_8), prop);
+        } catch (IOException | RuntimeException e) {
+            return builtin();
+        }
+    }
+
+    /** Picks the table entry for the device whose system properties prop returns ("" if unset). */
+    static ThimsyDeviceKeys resolve(String json, Function<String, String> prop) {
+        final JSONObject root;
+        try {
+            root = new JSONObject(json);
+        } catch (JSONException | NullPointerException e) {
+            return builtin();
+        }
+        List<Key> function = builtinFunction();
+        List<Key> back = builtinBack();
+        boolean sharedBack = false;
+        JSONObject def = root.optJSONObject("default");
+        if (def != null) {
+            if (def.has("function")) function = keys(def.opt("function"));
+            if (def.has("back")) back = keys(def.opt("back"));
+            sharedBack = "back".equals(def.optString("fallback"));
+        }
+        JSONArray devices = root.optJSONArray("devices");
+        if (devices != null) {
+            for (int i = 0; i < devices.length(); i++) {
+                JSONObject entry = devices.optJSONObject(i);
+                if (entry == null || !entryMatches(entry, prop)) continue;
+                if (entry.has("function")) function = keys(entry.opt("function"));
+                if (entry.has("back")) back = keys(entry.opt("back"));
+                return new ThimsyDeviceKeys(entry.optString("id", "device"),
+                        entry.optString("name"), function, back,
+                        "back".equals(entry.optString("fallback")));
+            }
+        }
+        return new ThimsyDeviceKeys("default", "", function, back, sharedBack);
+    }
+
+    private static List<Key> keys(Object v) {
+        List<Key> out = new ArrayList<>();
+        if (!(v instanceof JSONArray)) return out;
+        JSONArray a = (JSONArray) v;
+        for (int i = 0; i < a.length(); i++) {
+            JSONObject e = a.optJSONObject(i);
+            if (e == null) continue;
+            int linux = -1;
+            Object code = e.opt("linux");
+            if (code instanceof Number) {
+                double d = ((Number) code).doubleValue();
+                if (d >= 0 && d <= 0x2ff) linux = (int) d;
+            }
+            String android = e.optString("android");
+            if (linux < 0 && android.isEmpty()) continue;
+            out.add(new Key(stringOf(e, "label"), linux, android, e.optBoolean("gamepad_only"),
+                    stringOf(e, "prompt")));
+        }
+        return out;
+    }
+
+    // A string or "", as NanoJson's getString reads it (optString would make 5 "5" and null "null").
+    private static String stringOf(JSONObject e, String key) {
+        Object v = e.opt(key);
+        return v instanceof String ? (String) v : "";
+    }
+
+    private static boolean entryMatches(JSONObject entry, Function<String, String> prop) {
+        Object match = entry.opt("match");
+        if (match instanceof JSONObject) return alternativeMatches((JSONObject) match, prop);
+        if (!(match instanceof JSONArray)) return false;
+        JSONArray alts = (JSONArray) match;
+        for (int i = 0; i < alts.length(); i++) {
+            Object alt = alts.opt(i);
+            if (alt instanceof JSONObject && alternativeMatches((JSONObject) alt, prop)) return true;
+        }
+        return false;
+    }
+
+    // Every property the alternative names matches one of its values.
+    private static boolean alternativeMatches(JSONObject alt, Function<String, String> prop) {
+        if (alt.length() == 0) return false;
+        for (Iterator<String> it = alt.keys(); it.hasNext(); ) {
+            String name = it.next();
+            String have = prop.apply(name);
+            Object want = alt.opt(name);
+            boolean any = false;
+            if (want instanceof String) {
+                any = valueMatches((String) want, have);
+            } else if (want instanceof JSONArray) {
+                JSONArray a = (JSONArray) want;
+                for (int i = 0; i < a.length() && !any; i++) {
+                    Object w = a.opt(i);
+                    any = w instanceof String && valueMatches((String) w, have);
+                }
+            }
+            if (!any) return false;
+        }
+        return true;
+    }
+
+    // Case-insensitive, or a prefix when the wanted value ends in '*'.
+    private static boolean valueMatches(String want, String have) {
+        if (have == null || have.isEmpty() || want.isEmpty()) return false;
+        if (want.endsWith("*")) {
+            String prefix = want.substring(0, want.length() - 1).toLowerCase(Locale.ROOT);
+            return !prefix.isEmpty() && have.toLowerCase(Locale.ROOT).startsWith(prefix);
+        }
+        return want.equalsIgnoreCase(have);
+    }
+}
