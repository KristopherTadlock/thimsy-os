+                // Isolated processes and unknown uids have no packages and no exemption.
+                return new ThimsyUidAccess(false, true, new String[0], expiresAtMs);
+            }
+            final Set<String> selfGranted = getThimsySelfGrantedPackages();
+            for (String packageName : packages) {
+                if (selfGranted.contains(packageName)) {
+                    return new ThimsyUidAccess(false, true, packages, expiresAtMs);
+                }
+            }
