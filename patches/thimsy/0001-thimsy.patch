+// Build (or take the prebuilt) theme for k and swap it into mEsdeDoc. Returns mEsdeDoc.valid().
+bool NanoMenu::esdeBuildTheme(const EsdeBuildKey& k, const char* why) {
+    if (!mEsdeBuilder) mEsdeBuilder = std::make_shared<EsdeThemeBuilder>();
+    if (!mEsdePrebuildOpen) mEsdeBuilder->invalidate();   // nothing built before this request is used
+    const int64_t t0 = (int64_t)uptimeMillis();
+    bool prebuilt = false;
+    int64_t buildMs = 0;
+    std::unique_ptr<nanoesde::Theme> doc = mEsdeBuilder->obtain(k, &prebuilt, &buildMs);
+    if (buildMs < 0 && !strcmp(why, "system") && mEsdeDoc.valid()) {
+        // Only the per-system details would have changed: keep showing the theme already up,
+        // and report success so the same system is not asked for (and waited on) every frame.
+        ALOGW("esde: per-system theme build %s; keeping the current theme", kEsdeTimedOut);
+        return true;
+    }
+    mEsdeDoc.swap(*doc);
+    mEsdeDocKey = k;
+    ALOGI("esde: adopted %s theme (sys='%s' variant='%s') at %lld ms: %s, render thread waited %lld ms, parse %lld ms",
+          why, k.sysTheme.c_str(), k.variant.c_str(), (long long)uptimeMillis(),
+          prebuilt ? "started early" : "built on request", (long long)((int64_t)uptimeMillis() - t0),
+          (long long)buildMs);
+    return mEsdeDoc.valid();
+}
+
+// The variant to parse for a system: esdeEffectiveVariant's media check, except while storage is not
+// readable yet (media unknown), when the variant the last boot resolved for the system is used. The
+// focused system is resolved again once storage comes up (renderEsde, mEsdeMediaSig).
+std::string NanoMenu::esdeVariantFor(const std::string& selVariant, int sysIdx, const std::string& sysTheme) {
+    if (!mStorageReady) {
+        for (const char* tag : {"foc", "repx", "rep"})
+            for (const auto& r : mEsdePredict)
+                if (r.first == tag && r.second.set == mEsdeSetName && r.second.sysTheme == sysTheme &&
+                    r.second.selVariant == selVariant)
+                    return r.second.variant;
+    }
+    return esdeEffectiveVariant(selVariant, sysIdx);
+}
+
+// Remember (k) or forget (nullptr) the build for a record tag; the file is rewritten on a change.
+void NanoMenu::esdePredictRecord(const char* tag, const EsdeBuildKey* k) {
+    size_t i = 0;
+    while (i < mEsdePredict.size() && mEsdePredict[i].first != tag) i++;
+    if (k) {
+        if (i < mEsdePredict.size()) {
+            if (mEsdePredict[i].second == *k && mEsdePredict[i].second.set == k->set &&
+                mEsdePredict[i].second.selVariant == k->selVariant)
+                return;
+            mEsdePredict[i].second = *k;
+        } else {
+            mEsdePredict.emplace_back(tag, *k);
+        }
+    } else {
+        if (i >= mEsdePredict.size()) return;
+        mEsdePredict.erase(mEsdePredict.begin() + (long)i);
+    }
+    std::string out;
+    for (const auto& r : mEsdePredict) {
+        const EsdeBuildKey& e = r.second;
+        char asp[48];
+        snprintf(asp, sizeof(asp), "%a", (double)e.aspect);
+        for (const std::string* f : {&r.first, &e.set, &e.dir, &e.selVariant, &e.variant, &e.colorScheme,
+                                     &e.aspectRatio, &e.fontSize, &e.locale, &e.sysTheme, &e.sysName}) {
+            out += *f;
+            out += '\x1f';
+        }
+        out += asp;
+        out += '\n';
+    }
+    const std::string tmp = std::string(kEsdePrebuildFile) + ".tmp";
+    if (FILE* f = fopen(tmp.c_str(), "we")) {
+        const bool ok = fwrite(out.data(), 1, out.size(), f) == out.size();
+        if (fclose(f) == 0 && ok) rename(tmp.c_str(), kEsdePrebuildFile);
+        else unlink(tmp.c_str());
+    }
+}
