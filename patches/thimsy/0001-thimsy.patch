+                                        "/storage/emulated/0/ROMs/oric/Zorgons Revenge.tap"}));
+    EXPECT_EQ(toks[6], "oric1");
+    // A '"' inside an unquoted token is still a literal character, as before.
+    ASSERT_TRUE(buildLaunchIntent("-n a/.B -e X a\"b", "", v, toks));
+    EXPECT_EQ(toks.back(), "a\"b");
+    // Text with no placeholder in a quoted token needs no span.
+    ASSERT_TRUE(buildLaunchIntent("-n a/.B -e cli_params \"-ui simple\"", "", v, toks));
+    EXPECT_EQ(toks.back(), "-ui simple");
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoMenuUtils_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoMenuUtils_test.cpp
new file mode 100644
index 00000000000..da9a2ffc7ae
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/NanoMenuUtils_test.cpp
@@ -0,0 +1,103 @@
+// The Quick Resume handoff's wait for RetroArch's config (with RetroArch's folder on a card, a RetroArch
+// launch waits for the card's mount as well as the ROM's volume) and the root-written path files.
+
+#include <gtest/gtest.h>
+
+#include <cstdio>
+#include <string>
+
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "NanoMenuUtils.h"
+
+using android::raConfigVolumeReady;
+
+namespace {
+
+const std::string kInternalOnly =
+    "/dev/block/dm-5 /data f2fs rw 0 0\n"
+    "/dev/fuse /storage/emulated fuse rw 0 0\n";
+const std::string kWithCard = kInternalOnly +
+    "/dev/block/vold/public:179,1 /mnt/media_rw/1234-ABCD vfat rw 0 0\n"
+    "/dev/fuse /storage/1234-ABCD fuse rw 0 0\n";
+const std::string kRawCardOnly = kInternalOnly +
+    "/dev/block/vold/public:179,1 /mnt/media_rw/1234-ABCD vfat rw 0 0\n";
+
+}  // namespace
+
+TEST(RaConfigVolumeReady, FolderOnTheCardWaitsForItsMount) {
+    const std::string dir = "/storage/1234-ABCD/emulator_config/retroarch";
+    EXPECT_FALSE(raConfigVolumeReady(dir, kInternalOnly));
+    // The raw mount comes first; launches resolve the folder through /storage.
+    EXPECT_FALSE(raConfigVolumeReady(dir, kRawCardOnly));
+    EXPECT_TRUE(raConfigVolumeReady(dir, kWithCard));
+    EXPECT_FALSE(raConfigVolumeReady("/storage/5678-EF01/retroarch", kWithCard));
+    EXPECT_FALSE(raConfigVolumeReady(dir, ""));
+}
+
+TEST(RaConfigVolumeReady, DefaultOrInternalFolderNeedsNoCard) {
+    EXPECT_TRUE(raConfigVolumeReady("", kInternalOnly));
+    EXPECT_TRUE(raConfigVolumeReady("", ""));
+    EXPECT_TRUE(raConfigVolumeReady("/storage/emulated/0/RetroArch", kInternalOnly));
+    EXPECT_TRUE(raConfigVolumeReady("/storage/self/primary/RetroArch", kInternalOnly));
+    EXPECT_FALSE(raConfigVolumeReady("/storage/emulated/0/RetroArch", ""));
+}
+
+namespace {
+
+std::string scratchDir() {
+    char tmpl[] = "/tmp/nano_pathfile_XXXXXX";
+    const char* d = mkdtemp(tmpl);
+    return d ? std::string(d) : std::string();
+}
+
+std::string slurpFile(const std::string& p) {
+    std::string s;
+    FILE* f = fopen(p.c_str(), "rb");
+    if (!f) return s;
+    char b[256];
+    size_t n;
+    while ((n = fread(b, 1, sizeof(b), f)) > 0) s.append(b, n);
+    fclose(f);
+    return s;
+}
+
+}  // namespace
+
+TEST(WritePathFile, PlantedTempLinkIsNotFollowed) {
+    const std::string dir = scratchDir();
+    ASSERT_FALSE(dir.empty());
+    const std::string victim = dir + "/victim", target = dir + "/nano_launch_game.txt";
+    {
+        FILE* f = fopen(victim.c_str(), "w");
+        ASSERT_NE(nullptr, f);
+        fputs("keep", f);
+        fclose(f);
+        chmod(victim.c_str(), 0600);
+    }
+    ASSERT_EQ(0, symlink(victim.c_str(), (target + ".tmp").c_str()));
+    android::writePathFile(target.c_str(), "123\n/storage/1234-ABCD/roms/game.cue");
+    EXPECT_EQ("keep", slurpFile(victim));
+    struct stat st {};
+    ASSERT_EQ(0, stat(victim.c_str(), &st));
+    EXPECT_EQ(0600u, st.st_mode & 0777);
+    EXPECT_EQ("123\n/storage/1234-ABCD/roms/game.cue", android::readPathFile(target.c_str()));
+    ASSERT_EQ(0, lstat(target.c_str(), &st));
+    EXPECT_TRUE(S_ISREG(st.st_mode));
+    android::writePathFile(target.c_str(), "");
+    EXPECT_NE(0, access(target.c_str(), F_OK));
+    unlink((target + ".tmp").c_str());
+    unlink(victim.c_str());
+    rmdir(dir.c_str());
+}
+
+TEST(ReadPathFile, FifoReadsAsEmptyWithoutBlocking) {
+    const std::string dir = scratchDir();
+    ASSERT_FALSE(dir.empty());
+    const std::string fifo = dir + "/nano_launch_game.txt";
+    ASSERT_EQ(0, mkfifo(fifo.c_str(), 0600));
+    EXPECT_EQ("", android::readPathFile(fifo.c_str()));
+    unlink(fifo.c_str());
+    rmdir(dir.c_str());
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoMonitorMode_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoMonitorMode_test.cpp
new file mode 100644
index 00000000000..25f4e1bb731
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/NanoMonitorMode_test.cpp
@@ -0,0 +1,159 @@
+#include <gtest/gtest.h>
+
+#include "NanoMonitorMode.h"
+
+using namespace android;
+
+namespace {
+
+monmode::Mode mode(const char* text) {
+    monmode::Mode m;
+    EXPECT_TRUE(monmode::parseMode(text, &m)) << text;
+    return m;
+}
+
+std::vector<std::string> texts(const std::vector<monmode::Mode>& modes) {
+    std::vector<std::string> out;
+    for (const auto& m : modes) out.push_back(m.text());
+    return out;
+}
+
+// What `cmd display gammaos-monitor-mode list` prints (DisplayManagerService.gammaosListMonitorModes).
+const char* kList =
+    "monitor local:4619827259835644672\n"
+    "key 0123456789abcdef\n"
+    "held 2560x1440@60 user\n"
+    "active 2560x1440@60\n"
+    "auto 1920x1080@60\n"
+    "stored 2560x1440@60\n"
+    "revert 2560x1440@60\n"
+    "trial none\n"
+    "mode 3840x2160@30\n"
+    "mode 2560x1440@60\n"
+    "mode 1920x1080@120\n"
+    "mode 1920x1080@60\n"
+    "mode 1920x1080@59.94\n"
+    "mode 1920x1080@50\n"
+    "mode 1920x1080@24\n"
+    "mode 1280x720@60\n";
+
+}  // namespace
+
+TEST(MonitorMode, ParsesModes) {
+    monmode::Mode m;
+    ASSERT_TRUE(monmode::parseMode("2560x1440@60", &m));
+    EXPECT_EQ(m.width, 2560);
+    EXPECT_EQ(m.height, 1440);
+    EXPECT_EQ(m.rate, "60");
+    EXPECT_EQ(m.text(), "2560x1440@60");
+    ASSERT_TRUE(monmode::parseMode("1920x1080@59.94", &m));
+    EXPECT_NEAR(m.hz(), 59.94f, 0.001f);
+    EXPECT_EQ(monmode::sizeText(m), "1920 x 1080");
+    // Anything that could not go on a command line as it is, or is no mode.
+    for (const char* bad : {"", "none", "1920x1080", "1920x1080@", "x1080@60", "1920x@60", "1920x1080@60;rm",
+                            "1920x1080@6 0", "1920x1080@-60", "1920x1080@.5", "1920x1080@60.", "1920x1080@1.2.3",
+                            "123456x1080@60", "0x1080@60", "1920x1080@0", "@60x1080"}) {
+        monmode::Mode keep = m;
+        EXPECT_FALSE(monmode::parseMode(bad, &keep)) << bad;
+        EXPECT_EQ(keep.text(), m.text()) << bad;
+    }
+    EXPECT_EQ(monmode::Mode().text(), "");
+}
+
+TEST(MonitorMode, MatchesRatesWithinHalfAHertz) {
+    EXPECT_TRUE(monmode::sameMode(mode("1920x1080@60"), mode("1920x1080@59.94")));
+    EXPECT_FALSE(monmode::sameMode(mode("1920x1080@60"), mode("1920x1080@50")));
+    EXPECT_FALSE(monmode::sameMode(mode("1920x1080@60"), mode("1920x1200@60")));
+    EXPECT_TRUE(monmode::sameSize(mode("1920x1080@60"), mode("1920x1080@24")));
+    EXPECT_FALSE(monmode::sameSize(monmode::Mode(), monmode::Mode()));
+}
+
+TEST(MonitorMode, ReadsTheProperty) {
+    monmode::Mode held;
+    std::string why;
+    ASSERT_TRUE(monmode::parseProp("2560x1440@60;trial", &held, &why));
+    EXPECT_EQ(held.text(), "2560x1440@60");
+    EXPECT_EQ(why, "trial");
+    ASSERT_TRUE(monmode::parseProp("1920x1080@60;auto", &held, &why));
+    EXPECT_EQ(why, "auto");
+    EXPECT_FALSE(monmode::parseProp("", &held, &why));             // no monitor
+    EXPECT_FALSE(monmode::parseProp("1920x1080@60", &held, &why));
+    EXPECT_FALSE(monmode::parseProp("none;auto", &held, &why));
+    EXPECT_EQ(held.text(), "1920x1080@60");                          // untouched by a failed parse
+}
+
+TEST(MonitorMode, ReadsTheList) {
+    monmode::List l;
+    ASSERT_TRUE(monmode::parseList(kList, &l));
+    EXPECT_EQ(l.held.text(), "2560x1440@60");
+    EXPECT_EQ(l.why, "user");
+    EXPECT_EQ(l.active.text(), "2560x1440@60");
+    EXPECT_EQ(l.autoMode.text(), "1920x1080@60");
+    EXPECT_EQ(l.stored.text(), "2560x1440@60");
+    ASSERT_EQ(l.modes.size(), 8u);
+    EXPECT_EQ(l.modes.front().text(), "3840x2160@30");
+    EXPECT_EQ(l.modes.back().text(), "1280x720@60");
+
+    ASSERT_TRUE(monmode::parseList("held 1920x1080@60 auto\nactive none\nauto 1920x1080@60\nstored none\n"
+                                   "trial none\nmode 1920x1080@60\n", &l));
+    EXPECT_FALSE(l.active.valid());
+    EXPECT_FALSE(l.stored.valid());
+    EXPECT_EQ(l.modes.size(), 1u);
+
+    monmode::List keep = l;
+    EXPECT_FALSE(monmode::parseList("", &l));
+    EXPECT_FALSE(monmode::parseList("Error: no monitor\n", &l));
+    EXPECT_EQ(l.modes.size(), keep.modes.size());
+}
+
+TEST(MonitorMode, ReadsATrial) {
+    monmode::Trial t;
+    ASSERT_TRUE(monmode::parseTrial("trial 2560x1440@60 15 1920x1080@60\n", &t));
+    EXPECT_EQ(t.mode.text(), "2560x1440@60");
+    EXPECT_EQ(t.seconds, 15);
+    EXPECT_EQ(t.revert.text(), "1920x1080@60");
+    EXPECT_FALSE(monmode::parseTrial("Error: the monitor didn't switch to 2560x1440@60\n", &t));
+    EXPECT_FALSE(monmode::parseTrial("trial 2560x1440@60 x 1920x1080@60\n", &t));
+    EXPECT_FALSE(monmode::parseTrial("trial none\n", &t));
+    EXPECT_FALSE(monmode::parseTrial("", &t));
+}
+
+TEST(MonitorMode, HidesSlowModesInDualScreen) {
+    monmode::List l;
+    ASSERT_TRUE(monmode::parseList(kList, &l));
+    EXPECT_EQ(monmode::offered(l.modes, false).size(), 8u);
+    const auto dual = texts(monmode::offered(l.modes, true));
+    EXPECT_EQ(dual, (std::vector<std::string>{"2560x1440@60", "1920x1080@120", "1920x1080@60", "1920x1080@59.94",
+                                              "1920x1080@50", "1280x720@60"}));
+}
+
+TEST(MonitorMode, OffersEachSizeOnce) {
+    monmode::List l;
+    ASSERT_TRUE(monmode::parseList(kList, &l));
+    // At 60 Hz: every size at 60 Hz, 4K at the only rate it has.
+    EXPECT_EQ(texts(monmode::sizeChoices(l.modes, mode("1920x1080@60"))),
+              (std::vector<std::string>{"3840x2160@30", "2560x1440@60", "1920x1080@60", "1280x720@60"}));
+    // At 120 Hz: 1080p keeps 120; the other sizes don't have it and take the rate nearest 60.
+    EXPECT_EQ(texts(monmode::sizeChoices(l.modes, mode("1920x1080@120"))),
+              (std::vector<std::string>{"3840x2160@30", "2560x1440@60", "1920x1080@120", "1280x720@60"}));
+    // No current mode: the rate nearest 60 Hz (60 rather than 59.94).
+    EXPECT_EQ(texts(monmode::sizeChoices(l.modes, monmode::Mode())),
+              (std::vector<std::string>{"3840x2160@30", "2560x1440@60", "1920x1080@60", "1280x720@60"}));
+    // Two rates as near to 60: the higher.
+    const std::vector<monmode::Mode> tie = {mode("1920x1080@50"), mode("1920x1080@70")};
+    EXPECT_EQ(texts(monmode::sizeChoices(tie, monmode::Mode())), (std::vector<std::string>{"1920x1080@70"}));
+    EXPECT_TRUE(monmode::sizeChoices({}, mode("1920x1080@60")).empty());
+}
+
+TEST(MonitorMode, OffersTheRatesOfTheCurrentSize) {
+    monmode::List l;
+    ASSERT_TRUE(monmode::parseList(kList, &l));
+    const auto rates = monmode::rateChoices(l.modes, mode("1920x1080@60"));
+    EXPECT_EQ(texts(rates), (std::vector<std::string>{"1920x1080@120", "1920x1080@60", "1920x1080@59.94",
+                                                      "1920x1080@50", "1920x1080@24"}));
+    EXPECT_EQ(monmode::indexOf(rates, mode("1920x1080@60"), false), 1);
+    EXPECT_EQ(monmode::indexOf(rates, mode("1920x1080@24"), false), 4);
+    EXPECT_EQ(monmode::indexOf(rates, mode("1920x1080@100"), false), -1);
+    EXPECT_EQ(monmode::indexOf(monmode::sizeChoices(l.modes, mode("1920x1080@60")), mode("1920x1080@24"), true), 2);
+    EXPECT_TRUE(monmode::rateChoices(l.modes, monmode::Mode()).empty());
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoNdsBanner_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoNdsBanner_test.cpp
new file mode 100644
index 00000000000..59568ea147e
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/NanoNdsBanner_test.cpp
@@ -0,0 +1,187 @@
+#include <gtest/gtest.h>
+
+#include <string.h>
+#include <sys/stat.h>
+
+#include "NanoNdsBanner.h"
+#include "nano_test_fs.h"
+#include "nano_test_zip.h"
+
+using nanotest::TempDir;
+using nanotest::ZipMember;
+
+namespace {
+
+uint16_t crc16(const uint8_t* p, size_t n) {
+  uint16_t c = 0xFFFF;
+  for (size_t i = 0; i < n; i++) {
+    c ^= p[i];
+    for (int b = 0; b < 8; b++) c = (c & 1) ? (uint16_t)((c >> 1) ^ 0xA001) : (uint16_t)(c >> 1);
+  }
+  return c;
+}
+void w16(uint8_t* p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+void w32(uint8_t* p, uint32_t v) { for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+
+// A DS ROM with valid header and banner checksums. titles[l] for language l (0 Japanese,
+// 1 English, ...); nullptr leaves that language empty.
+std::vector<uint8_t> makeRom(uint32_t bannerOff, const char16_t* en, size_t romSize = 0x8000,
+                             const char16_t* ja = u"Other", uint16_t version = 1) {
+  std::vector<uint8_t> r(romSize, 0);
+  uint8_t* h = r.data();
+  memcpy(h, "TESTGAME", 8);
+  w32(h + 0x68, bannerOff);
+  w16(h + 0x15C, 0xCF56);
+  w16(h + 0x15E, crc16(h, 0x15E));
+  if ((uint64_t)bannerOff + 0x840 <= romSize) {
+    uint8_t* b = h + bannerOff;
+    w16(b, version);
+    for (int i = 0; i < 512; i++) b[0x20 + i] = (uint8_t)(i * 7);
+    for (int i = 0; i < 16; i++) w16(b + 0x220 + i * 2, (uint16_t)(i * 0x0421));
+    for (int l = 0; l < 6; l++) {
+      const char16_t* t = l == 1 ? en : l == 0 ? ja : u"Other";
+      for (int i = 0; t && t[i] && i < 127; i++) w16(b + 0x240 + l * 0x100 + i * 2, t[i]);
+    }
+    w16(b + 2, crc16(b + 0x20, 0x820));
+  }
+  return r;
+}
+
+std::vector<uint8_t> zipOf(const std::vector<uint8_t>& rom, int method, const char* name = "game.nds") {
+  ZipMember m;
+  m.name = name; m.data = rom; m.method = method;
+  return nanotest::makeZip({m});
+}
+
+class NdsBanner : public ::testing::Test {
+protected:
+  TempDir dir{"nds"};
+  int n = 0;
+  NdsBannerInfo info;
+  std::string put(const std::vector<uint8_t>& d, const char* suffix) {
+    const std::string p = dir / ("f" + std::to_string(n++) + suffix);
+    EXPECT_TRUE(nanotest::writeFile(p, d));
+    return p;
+  }
+  bool read(const std::vector<uint8_t>& d, const char* suffix) { return ndsReadBanner(put(d, suffix), info); }
+};
+
+const std::vector<uint8_t> kRom = makeRom(0x1000, u"Mario Kart DS\nNintendo");
+
+}  // namespace
+
+TEST_F(NdsBanner, RawRom) {
+  ASSERT_TRUE(read(kRom, ".nds"));
+  EXPECT_EQ(info.title, "Mario Kart DS");
+  ASSERT_EQ(info.rgba.size(), 32u * 32 * 4);
+  EXPECT_EQ(info.rgba[3], 0);                    // palette index 0 is transparent
+  const uint8_t* px = &info.rgba[2 * 4];         // tile 0 byte 1 = 7: palette entry 7 = grey 7/31
+  EXPECT_EQ(px[0], 7 * 255 / 31); EXPECT_EQ(px[1], px[0]); EXPECT_EQ(px[2], px[0]); EXPECT_EQ(px[3], 255);
+  EXPECT_TRUE(read(kRom, ".NDS"));               // extension in any case
+}
+
+TEST_F(NdsBanner, StoredAndDeflatedZip) {
+  ASSERT_TRUE(read(zipOf(kRom, 0), ".zip"));
+  EXPECT_EQ(info.title, "Mario Kart DS");
+  ASSERT_TRUE(read(zipOf(kRom, 8), ".ZIP"));
+  EXPECT_EQ(info.title, "Mario Kart DS");
+  EXPECT_EQ(info.rgba.size(), 32u * 32 * 4);
+}
+
+TEST_F(NdsBanner, ZipUsesFirstNdsEntry) {
+  ZipMember readme; readme.name = "readme.txt"; readme.data = {'h', 'i'};
+  ZipMember rom; rom.name = "dir/Game.NDS"; rom.data = kRom; rom.method = 8;
+  ASSERT_TRUE(read(nanotest::makeZip({readme, rom}), ".zip"));
+  EXPECT_EQ(info.title, "Mario Kart DS");
+  EXPECT_FALSE(read(nanotest::makeZip({readme}), ".zip"));
+}
+
+TEST_F(NdsBanner, TitleLines) {
+  ASSERT_TRUE(read(makeRom(0x1000, u"Zelda\nPhantom Hourglass\nNintendo"), ".nds"));
+  EXPECT_EQ(info.title, "Zelda Phantom Hourglass");   // publisher line dropped
+  ASSERT_TRUE(read(makeRom(0x1000, u"  Tetris DS  "), ".nds"));
+  EXPECT_EQ(info.title, "Tetris DS");                 // a single line is kept, trimmed
+  ASSERT_TRUE(read(makeRom(0x1000, nullptr, 0x8000, u"Nihon\nPub"), ".nds"));
+  EXPECT_EQ(info.title, "Nihon");                     // no English: the next language
+}
+
+TEST_F(NdsBanner, SurrogatesInTitle) {
+  ASSERT_TRUE(read(makeRom(0x1000, u"A\U0001F600B\xD800"), ".nds"));
+  EXPECT_EQ(info.title, "A\xF0\x9F\x98\x80" "B");     // the pair decoded, the lone half dropped
+}
+
+TEST_F(NdsBanner, RejectsBadChecksumsAndOffsets) {
+  auto bad = kRom; bad[0] ^= 1;
+  EXPECT_FALSE(read(bad, ".nds"));
+  EXPECT_TRUE(info.rgba.empty());
+  bad = kRom; bad[0x15C] ^= 1;                                          // logo checksum
+  EXPECT_FALSE(read(bad, ".nds"));
+  bad = kRom; bad[0x1000 + 0x30] ^= 1;                                  // banner CRC
+  EXPECT_FALSE(read(bad, ".nds"));
+  EXPECT_FALSE(read(makeRom(0x1000, u"x", 0x8000, u"y", 0), ".nds"));   // banner version 0
+  EXPECT_FALSE(read(makeRom(0x100, u"x"), ".nds"));                     // inside the header
+  EXPECT_FALSE(read(makeRom(0x7FFF, u"x"), ".nds"));                    // runs off the end
+  EXPECT_FALSE(read(makeRom(0xFFFFFFFFu, u"x"), ".nds"));
+}
+
+TEST_F(NdsBanner, RejectsOtherFiles) {
+  EXPECT_FALSE(read(std::vector<uint8_t>(10, 0), ".nds"));
+  EXPECT_FALSE(read(kRom, ".gba"));
+  EXPECT_FALSE(ndsReadBanner(dir / "missing.nds", info));
+  const std::string sub = dir / "sub.nds";
+  ASSERT_EQ(mkdir(sub.c_str(), 0700), 0);
+  EXPECT_FALSE(ndsReadBanner(sub, info));
+}
+
+TEST_F(NdsBanner, RejectsUnsupportedZips) {
+  auto z = zipOf(kRom, 8);
+  auto m = z;   // method 12 (bzip2) in the central directory
+  const size_t cd = z.size() - 22 - (46 + 8);
+  m[cd + 10] = 12;
+  EXPECT_FALSE(read(m, ".zip"));
+  auto z64 = z;   // zip64 marker sizes
+  nanotest::put32(z64, cd + 20, 0xFFFFFFFFu);
+  EXPECT_FALSE(read(z64, ".zip"));
+  auto noLocal = z;   // the local header the directory points at is missing
+  nanotest::put32(noLocal, 0, 0);
+  EXPECT_FALSE(read(noLocal, ".zip"));
+}
+
+TEST_F(NdsBanner, RawTruncationsRejected) {
+  for (size_t cut : {(size_t)0x1FF, (size_t)0x200, (size_t)0x1000, (size_t)0x1000 + 0x83F}) {
+    std::vector<uint8_t> t(kRom.begin(), kRom.begin() + cut);
+    EXPECT_FALSE(read(t, ".nds")) << cut;
+  }
+}
+
+TEST_F(NdsBanner, ZipPrefixesRejected) {
+  const auto z = zipOf(kRom, 8);
+  for (size_t cut = 0; cut < z.size(); cut += 97) {
+    std::vector<uint8_t> t(z.begin(), z.begin() + cut);
+    EXPECT_FALSE(read(t, ".zip")) << cut;
+  }
+}
+
+// A deflated entry is inflated only up to 24 MB: a banner beyond that is not worth the time.
+TEST_F(NdsBanner, DeflateCap) {
+  const auto deep = makeRom(25u << 20, u"Deep", (25u << 20) + 0x1000);
+  EXPECT_FALSE(read(zipOf(deep, 8), ".zip"));
+  ASSERT_TRUE(read(zipOf(deep, 0), ".zip"));          // stored: read in place, no cap
+  EXPECT_EQ(info.title, "Deep");
+  const auto under = makeRom(23u << 20, u"Under", (23u << 20) + 0x1000);
+  ASSERT_TRUE(read(zipOf(under, 8), ".zip"));
+  EXPECT_EQ(info.title, "Under");
+}
+
+TEST_F(NdsBanner, ByteFlipsNeverCrash) {
+  const auto z = zipOf(kRom, 8);
+  unsigned seed = 1;
+  for (int i = 0; i < 300; i++) {
+    auto t = z;
+    for (int k = 0; k < 4; k++) {
+      seed = seed * 1103515245 + 12345;
+      t[(seed >> 8) % t.size()] ^= (uint8_t)(seed >> 3);
+    }
+    if (read(t, ".zip")) EXPECT_EQ(info.rgba.size(), 32u * 32 * 4);
+  }
+}
