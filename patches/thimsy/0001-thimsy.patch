+package com.android.server.gammaos;
+
+import java.text.Normalizer;
+import java.util.Locale;
+
+/**
+ * The folders Nano may give an app through NanoNetBridge's uri_grant command. No Android types, so
+ * the build repo's host tests can run it.
+ */
+final class NanoUriGrant {
+    private NanoUriGrant() {}
+
+    /**
+     * The apps Nano gives folders as if picked in the system folder picker: hakuX its ROM folders,
+     * Azahar and SeedlessDS their own, WatermelonDS and ScummVM the folders their settings name.
+     */
+    private static final String[] APPS = {
+        "com.rfandango.haku_x", "org.azahar_emu.azahar", "com.seedlessds.app", "me.magnum.melondualds",
+        "org.scummvm.scummvm"
+    };
+    /**
+     * Top-level folders never given: Android (but the app's own folders in it: other apps' files
+     * and the system's), the user's photos, videos, recordings and documents, and the copies Nano
+     * sets aside.
+     */
+    private static final String[] PROTECTED = {
+        "Android", "DCIM", "Pictures", "Movies", "Recordings", "Documents", "Nano Backup"
+    };
+
+    /**
+     * "&lt;package&gt;|&lt;volume&gt;|&lt;path&gt;" as {package, external storage document id},
+     * or null for anything but one of APPS and a folder of internal storage ("primary") or of a
+     * card or drive (its volume uuid) that is not the volume's root or a PROTECTED one; the app's
+     * own Android/data, Android/media and Android/obb folders (its settings and saves where it
+     * keeps them when installed) are its to have.
+     */
+    static String[] parse(String arg) {
+        final String[] p = arg.split("\\|", -1);
+        if (p.length != 3) return null;
+        final boolean volume = p[1].equals("primary") || p[1].matches("[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}|[0-9A-Fa-f]{32}");
+        boolean app = false;
+        for (String a : APPS) app = app || a.equals(p[0]);
+        return app && volume && allowedFolder(p[0], p[2]) ? new String[] {p[0], p[1] + ":" + p[2]} : null;
+    }
+
+    /** A folder below a volume's root, by plain folder names, not in or under a PROTECTED one. */
+    private static boolean allowedFolder(String pkg, String path) {
+        final String[] parts = path.split("/", -1);
+        for (String part : parts) {
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) return false;
+            for (int i = 0; i < part.length(); i++) {
+                final char c = part.charAt(i);
+                if (c < 0x20 || c == 0x7f || c == ':' || c == '|' || c == '\\') return false;
+            }
+        }
+        // GAMMAOS (Thimsy): only plain ASCII spellings of Android and data|media|obb count.
+        if (parts.length >= 3 && isAscii(parts[0]) && isAscii(parts[1])
+                && parts[0].equalsIgnoreCase("Android") && parts[2].equals(pkg)
+                && (parts[1].equalsIgnoreCase("data") || parts[1].equalsIgnoreCase("media")
+                        || parts[1].equalsIgnoreCase("obb"))) {
+            return true;
+        }
+        // GAMMAOS (Thimsy): names are compared as volumes compare them, and FAT 8.3 aliases of
+        // the protected folders are refused too.
+        final String folded = foldName(parts[0]);
+        if (folded.isEmpty()) return false;
+        for (String p : PROTECTED) {
+            if (folded.equals(p.toLowerCase(Locale.ROOT)) || isShortNameAlias(parts[0], p)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isAscii(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) > 0x7e) return false;
+        }
+        return true;
+    }
+
+    /*
+     * GAMMAOS (Thimsy): copies of ThimsyStorageDenylist.foldName, isDefaultIgnorable and
+     * isShortNameAlias (packages/providers/MediaProvider), also copied in
+     * UriGrantsManagerService (foldThimsyName, isThimsyDefaultIgnorable, isThimsyShortNameAlias).
+     * Keep all three identical.
+     */
+
+    /**
+     * {@code name} without Unicode default-ignorable code points and trailing dots and spaces,
+     * canonically decomposed and case-folded.
+     */
+    static String foldName(String name) {
+        boolean ascii = true;
+        for (int i = 0; i < name.length() && ascii; i++) {
+            ascii = name.charAt(i) <= 0x7e;
+        }
+        String folded = name;
+        if (!ascii) {
+            final String nfd = Normalizer.normalize(name, Normalizer.Form.NFD);
+            final StringBuilder sb = new StringBuilder(nfd.length());
+            for (int i = 0; i < nfd.length(); ) {
+                final int cp = nfd.codePointAt(i);
+                i += Character.charCount(cp);
+                if (!isDefaultIgnorable(cp)) {
+                    sb.appendCodePoint(cp);
+                }
+            }
+            folded = sb.toString().toUpperCase(Locale.ROOT);
+        }
+        int end = folded.length();
+        while (end > 0 && (folded.charAt(end - 1) == '.' || folded.charAt(end - 1) == ' ')) {
+            end--;
+        }
+        folded = folded.substring(0, end).toLowerCase(Locale.ROOT);
+        return ascii ? folded : Normalizer.normalize(folded, Normalizer.Form.NFC);
+    }
+
+    /** Unicode Default_Ignorable_Code_Point code points. */
+    private static boolean isDefaultIgnorable(int cp) {
+        return cp == 0x00AD || cp == 0x034F || cp == 0x061C || cp == 0x115F || cp == 0x1160
+                || cp == 0x17B4 || cp == 0x17B5 || (cp >= 0x180B && cp <= 0x180F)
+                || (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x202A && cp <= 0x202E)
+                || (cp >= 0x2060 && cp <= 0x206F) || cp == 0x3164
+                || (cp >= 0xFE00 && cp <= 0xFE0F) || cp == 0xFEFF || cp == 0xFFA0
+                || (cp >= 0xFFF0 && cp <= 0xFFF8) || (cp >= 0x1BCA0 && cp <= 0x1BCA3)
+                || (cp >= 0x1D173 && cp <= 0x1D17A) || (cp >= 0xE0000 && cp <= 0xE0FFF);
+    }
+
+    /** Whether {@code segment} has the form of a FAT 8.3 alias of a folder named {@code name}. */
+    static boolean isShortNameAlias(String segment, String name) {
+        final String base = name.toUpperCase(Locale.ROOT).replace(" ", "").replace(".", "");
+        final String s = segment.toUpperCase(Locale.ROOT);
+        final int tilde = s.lastIndexOf('~');
+        if (s.length() > 8 || tilde <= 0 || tilde == s.length() - 1) {
+            return false;
+        }
+        for (int i = tilde + 1; i < s.length(); i++) {
+            if (s.charAt(i) < '0' || s.charAt(i) > '9') {
+                return false;
+            }
+        }
+        final String prefix = s.substring(0, tilde);
+        final int digits = s.length() - tilde - 1;
+        if (prefix.length() == Math.min(base.length(), 8 - 1 - digits)
+                && base.startsWith(prefix)) {
+            return true;
+        }
+        final int lead = Math.min(base.length(), 2);
+        if (digits != 1 || tilde != lead + 4 || !base.startsWith(s.substring(0, lead))) {
+            return false;
+        }
+        for (int i = lead; i < tilde; i++) {
+            if (Character.digit(s.charAt(i), 16) < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
