+bool NanoMenu::ndsListTouchScroll(int depth, int dir, int fitRows) {
+    std::vector<Ps3Item>* items; int* sel;
+    if (ndsNavDepth() != depth || !ndsListTouchLevel(items, sel)) return false;
+    const int n = (int)items->size(), maxScroll = n - fitRows;
+    int cur = *sel - fitRows / 2;
+    if (cur < 0) cur = 0; if (cur > maxScroll) cur = maxScroll;
+    if (cur + dir < 0 || cur + dir > maxScroll) return false;
+    *sel = std::min(n - 1, cur + dir + fitRows / 2);
+    mDisplayDirty = true;
+    return true;
