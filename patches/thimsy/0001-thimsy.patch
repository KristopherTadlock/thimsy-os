+// The display an SF session draws for (NanoDisplayTarget.h) and its size. Plugging or unplugging a
+// monitor, or switching between docked, dual screen and mirror, moves display 0 to a screen of
+// another size, which the session's surface doesn't follow; moved() then asks for a relaunch, which
+// resumes slot 9 on the new screen. Watched off the render thread: a few binder calls every half
+// second, compared once the screens are on (none shows display 0 while they are off).
+class SfTargetWatch {
+public:
+    SfTargetWatch() : mStart(now()), mThread([this] { run(); }) {}
+    ~SfTargetWatch() {
+        {
+            std::lock_guard<std::mutex> lk(mMutex);
+            mStop = true;
+        }
+        mCv.notify_all();
+        mThread.join();
+    }
+    bool moved() const { return mMoved.load(std::memory_order_relaxed); }
+
+private:
+    struct Target {
+        bool shown = false;
+        uint64_t id = 0;
+        int32_t longSide = 0, shortSide = 0;   // either orientation
+        bool sameScreen(const Target& o) const {
+            return id == o.id && longSide == o.longSide && shortSide == o.shortSide;
+        }
+    };
+
+    static Target now() {
+        Target t;
+        const std::vector<android::PhysicalDisplayId> ids =
+                android::SurfaceComposerClient::getPhysicalDisplayIds();
+        if (ids.empty()) return t;
+        const android::nanodisplay::Choice c = android::nanodisplay::sfChoose(ids);
+        if (c.target < 0 || !c.shown) return t;
+        t.shown = true;
+        t.id = ids[c.target].value;
+        if (const android::sp<android::IBinder> token =
+                    android::SurfaceComposerClient::getPhysicalDisplayToken(ids[c.target])) {
+            android::ui::DisplayState state;
+            if (android::SurfaceComposerClient::getDisplayState(token, &state) == android::NO_ERROR) {
+                const int32_t w = state.layerStackSpaceRect.width;
+                const int32_t h = state.layerStackSpaceRect.height;
+                t.longSide = std::max(w, h);
+                t.shortSide = std::min(w, h);
+            }
+        }
+        return t;
+    }
+
+    void run() {
+        std::unique_lock<std::mutex> lk(mMutex);
+        while (!mCv.wait_for(lk, std::chrono::milliseconds(500), [this] { return mStop; })) {
+            lk.unlock();
+            const Target t = now();
+            lk.lock();
+            if (!t.shown) continue;
+            if (!mStart.shown) {
+                mStart = t;
+            } else if (!t.sameScreen(mStart) && !mMoved.exchange(true)) {
+                ALOGI("drastic-nano: display 0 moved (%dx%d -> %dx%d); relaunching on it",
+                      mStart.longSide, mStart.shortSide, t.longSide, t.shortSide);
+            }
+        }
+    }
+
+    Target mStart;
+    std::atomic<bool> mMoved{false};
+    std::mutex mMutex;
+    std::condition_variable mCv;
+    bool mStop = false;
+    std::thread mThread;
+};
