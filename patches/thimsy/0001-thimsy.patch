+        for (int i = 0; i < kNumXmbSystemDefs; i++)
+            if (kXmbSystemDefs[i].coreSo[0]) nanoCores.push_back({kXmbSystemDefs[i].romDir, kXmbSystemDefs[i].coreSo});
