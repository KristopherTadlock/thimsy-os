+bool mountInfoHasMountPoint(const std::string& mountinfo, const std::string& mountPoint) {
+    size_t pos = 0;
+    while (pos < mountinfo.size()) {
+        size_t eol = mountinfo.find('\n', pos);
+        if (eol == std::string::npos) eol = mountinfo.size();
+        // Field 5 (1-based) is the mount point.
+        size_t f = pos;
+        for (int n = 0; n < 4 && f < eol; n++) {
+            while (f < eol && mountinfo[f] != ' ') f++;
+            while (f < eol && mountinfo[f] == ' ') f++;
+        }
+        size_t end = f;
+        while (end < eol && mountinfo[end] != ' ') end++;
+        if (end > f && unescapeMountPath(mountinfo.data() + f, end - f) == mountPoint) return true;
+        pos = eol + 1;
+    }
+    return false;
+}
