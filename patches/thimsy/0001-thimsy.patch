diff --git a/frameworks/base/cmds/gammaos-sharefs/test/share_config_test.cpp b/frameworks/base/cmds/gammaos-sharefs/test/share_config_test.cpp
new file mode 100644
index 00000000000..f37b58b194c
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-sharefs/test/share_config_test.cpp
@@ -0,0 +1,68 @@
+#include "share_config.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+using namespace gammaos::sharefs;
+
+TEST(ShareConfig, SecretRoundTrip) {
+    for (const std::string& pw : {std::string(), std::string("a"), std::string("hunter2"),
+                                  std::string("pässwörd with spaces"), std::string(45, 'x'),
+                                  std::string("\x00\xff", 2)}) {
+        const std::string enc = encryptSecret(pw);
+        EXPECT_EQ(enc.size(), pw.size() * 2);
+        EXPECT_EQ(enc.find_first_not_of("0123456789abcdef"), std::string::npos);
+        EXPECT_EQ(decryptSecret(enc), pw);
+    }
+    EXPECT_NE(encryptSecret("abc"), "616263");   // not stored as plain hex
+}
+
+TEST(ShareConfig, MountInfoDecodesEscapedPaths) {
+    const std::string mi =
+        "22 1 0:21 / / rw,relatime - ext4 /dev/root rw\n"
+        "40 22 0:45 / /mnt/shares/My\\040Music rw,nosuid - fuse /dev/fuse rw\n"
+        "41 22 0:46 / /mnt/shares/tab\\011and\\012nl\\134 rw - fuse /dev/fuse rw\n"
+        "42 22 0:47 / /mnt/shares/plain rw - fuse /dev/fuse rw";   // no trailing newline
+    EXPECT_TRUE(mountInfoHasMountPoint(mi, "/mnt/shares/My Music"));
+    EXPECT_FALSE(mountInfoHasMountPoint(mi, "/mnt/shares/My\\040Music"));
+    EXPECT_TRUE(mountInfoHasMountPoint(mi, "/mnt/shares/tab\tand\nnl\\"));
+    EXPECT_TRUE(mountInfoHasMountPoint(mi, "/mnt/shares/plain"));
+    EXPECT_FALSE(mountInfoHasMountPoint(mi, "/mnt/shares/My"));
+    EXPECT_FALSE(mountInfoHasMountPoint(mi, "/mnt/shares"));
+    EXPECT_FALSE(mountInfoHasMountPoint("", "/"));
+    EXPECT_FALSE(mountInfoHasMountPoint("short line\n", "/mnt/shares/x"));
+}
+
+TEST(ShareConfig, LengthLimits) {
+    ShareConfig c;
+    c.slot = 1;
+    c.name = "NAS";
+    c.type = ShareType::kSmb;
+    c.host = "192.168.1.10";
+    c.path = "media";
+    EXPECT_EQ(shareTooLong(c), "");
+    c.password = std::string(45, 'p');   // 90 hex characters: fits
+    EXPECT_EQ(shareTooLong(c), "");
+    c.password += 'p';
+    EXPECT_EQ(shareTooLong(c), "The password is too long.");
+    EXPECT_EQ(shareProblem(c), "The password is too long.");
+    EXPECT_FALSE(saveShare(c));   // refused before any property is written
+    c.password.clear();
+    c.host = std::string(kMaxPropValue, 'h');
+    EXPECT_EQ(shareTooLong(c), "");
+    c.host += 'h';
+    EXPECT_EQ(shareTooLong(c), "The server address is too long.");
+    c.host = "h";
+    c.name = std::string(kMaxPropValue + 1, 'n');
+    EXPECT_EQ(shareTooLong(c), "The name is too long.");
+    c.name = "n";
+    c.user = std::string(kMaxPropValue + 1, 'u');
+    EXPECT_EQ(shareTooLong(c), "The user name is too long.");
+    c.user.clear();
+    c.domain = std::string(kMaxPropValue + 1, 'd');
+    EXPECT_EQ(shareTooLong(c), "The workgroup is too long.");
+    c.domain.clear();
+    c.path = std::string(kMaxPropValue + 1, 'p');
+    EXPECT_EQ(shareTooLong(c), "The path is too long.");
+}
