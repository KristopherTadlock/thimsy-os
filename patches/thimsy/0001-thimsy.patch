+    renderengine::LayerSettings copy;
+    copy.name = "ThimsyMirror";
+    copy.geometry.boundaries = content.toFloatRect();
+    copy.source.buffer.buffer = mThimsyMirrorFrame;
+    copy.source.buffer.fence = *frame;
+    copy.source.buffer.isOpaque = true;
+    copy.sourceDataspace = display.outputDataspace;
+    copy.alpha = 1.f;
+    copy.disableBlending = true;
+    copy.thimsySharpBilinear = true;
