+// NanoEsdeTheme: resolution of a small theme, the H6 limits (include and variable bombs), and path
+// confinement. Every bomb has to be refused or defused in well under a second.
+#include "NanoEsdeTheme.h"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <cstdio>
