+    group root inet media_rw sdcard_rw everybody external_storage
+    capabilities DAC_OVERRIDE DAC_READ_SEARCH
+    disabled
+    oneshot
+    priority 10
+    ioprio be 7
+    task_profiles ServiceCapacityLow LowIoPriority
+    # Killed before a running game when memory runs short (init's default makes it unkillable);
+    # the home then reports the scrape as stopped.
+    oom_score_adjust 800
+
+on property:sys.gammaos.nano.scrape_run=*
+    start gammaos-nano-scrape
+
+# The kernel's random generator, credited at early-init with the seed the last boot saved when it is
+# not ready yet (a device whose hardware generator does not feed it, like the RG Cube): otherwise
+# the vendor's BoringSSL self tests block early-init for about two seconds waiting for it. This file
+# is parsed before /vendor's, so this runs first. Nothing happens on a device whose generator is ready.
+# Not in off-mode charging: there those two seconds are what let the RG Cube's battery driver (a vendor
+# module) register before the charger looks for it. ro.bootmode is set before early-init; "unknown" is
+# init's value when the bootloader names no mode.
+on early-init && property:ro.bootmode=normal
+    exec_start nano-seedrng-load
+
+on early-init && property:ro.bootmode=unknown
+    exec_start nano-seedrng-load
+
+service nano-seedrng-load /system/bin/nano-seedrng load
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
+service nano-seedrng-save /system/bin/nano-seedrng save
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
+# The power button held: a shutdown even when system_server or Nano is stuck (nano-powerwatch). Not in
+# charger mode, which triggers "charger" instead of late-init.
+on late-init
+    start nano-powerwatch
+
+service nano-powerwatch /system/bin/nano-powerwatch
+    user root
+    group root input
+    capabilities SYS_BOOT
+    shutdown critical
+    seclabel u:r:su:s0
+
+# Shutdown and restart: init gives services 3 s to exit after SIGTERM and waits the whole 3 s for
+# any that don't. wificond and the RG Cube vendor's GNSS daemon (gpsd, which ignores SIGTERM) held
+# up every restart that way; stop kills them outright first.
+on shutdown
+    stop wificond
+    stop gpsd
+    # The hardware clock as the restart begins: the next boot logs how long it was from here to its
+    # kernel starting (nano-seedrng load).
+    exec u:r:su:s0 root root -- /system/bin/nano-seedrng shutdown
