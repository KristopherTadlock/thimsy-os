+                if (re.standalone || re.romDir != s.romDir || re.coreSo != s.coreSo) continue;
+                re.coreSo = r.coreSo;
+                recentsChanged = true;
+            }
+            s.coreSo = r.coreSo;
+            changed = true;
+        }
+        if (!repairs.empty()) {
+            int maxOrder = -1;
+            for (const auto& s : mXmbSystems) maxOrder = std::max(maxOrder, s.order);
+            for (size_t i : nanosys::missingBundledSystems(cur, bun)) {
