+    bool held[4] = {};          // up, down, left, right, as last polled
+    std::vector<uint8_t> rgba;
+    unsigned tex = 0;
+    bool dirty = true;
+    float drawnScroll = -1.0f;
+    bool drawnMoving = false;
+    bool touchWasDown = true;   // a finger already down at open starts no gesture
+};
+
+ButtonMapOverlay::ButtonMapOverlay() : mS(new State) {}
+ButtonMapOverlay::~ButtonMapOverlay() = default;
+
+bool ButtonMapOverlay::isOpen() const { return mS->open; }
+
+bool ButtonMapOverlay::open(const std::string& romPath, int w, int h) {
+    State& s = *mS;
+    if (!s.loaded) {
+        const std::string art = firstDir({"/data/system/nano_xmb/controllers", "/system/etc/nano_xmb/controllers"}, "controllers.json");
+        const std::string data = firstDir({"/data/system/nano_xmb/buttonmap", "/system/etc/nano_xmb/buttonmap"}, "retropad.json");
+        bmap::loadCatalogFrom(art, data, &s.cat);
+        s.specs = bmap::loadPadSpecsFrom(firstDir({"/data/system/nano_xmb/buttonmap", "/system/etc/nano_xmb/buttonmap"}, "pads.json"));
+        s.assets.artDir = art;
+        s.assets.catalog = &s.cat;
+        // The faces OverlayGfx uses: PS3 Rodin, then Roboto and the script fallbacks.
+        for (const char* f : {"/data/system/nano_xmb/fonts/ps3-rodin-regular.ttf", "/system/etc/nano_xmb/fonts/ps3-rodin-regular.ttf",
+                              "/system/fonts/Roboto-Regular.ttf"})
+            if (access(f, R_OK) == 0) { s.assets.fontPath = f; break; }
+        for (const char* f : {"/system/fonts/Roboto-Regular.ttf", "/system/fonts/NotoSansCJK-Regular.ttc",
+                              "/system/fonts/NotoNaskhArabic-Regular.ttf", "/system/fonts/NotoSansThai-Regular.ttf",
+                              "/system/fonts/NotoSansHebrew-Regular.ttf"})
+            if (s.assets.fontPath != f && access(f, R_OK) == 0) s.assets.fallbackFonts.push_back(f);
+        s.loaded = true;
+    }
+    // drastic-nano reads the built-in pad, or gammapad's virtual pad standing for it.
+    const bmap::GamepadState gp = bmap::gamepadStateFrom(prop);
+    s.pad = bmap::padModelFor(bmap::DeviceId(), s.specs, gp);
+    const auto& fn = devkeys::current().function;
+    if (s.pad.has(bmap::Phys::Home) && !fn.empty() && !fn[0].label.empty()) s.pad.label[(int)bmap::Phys::Home] = fn[0].label;
+    bmap::Context ctx;
+    ctx.kind = bmap::Context::kGame;
+    ctx.emulator = "drastic-nano";
+    ctx.systemId = "nds";
+    ctx.package = "com.gammaos.drasticsf";
+    ctx.romPath = romPath;
+    bmap::ReaderEnv env;
+    env.prop = prop;
+    bmap::MapResult r = bmap::build(env, ctx, s.pad, s.cat);
+    // drastic-nano has its own save, load and fast forward (InputMap.cpp hotkey()), and no rewind.
+    std::vector<bmap::HotkeyRow> rows = bmap::chordRows(
+            {{"save_state", "drastic-nano"}, {"load_state", "drastic-nano"}, {"fast_forward", "drastic-nano"}, {"quit", "drastic-nano"}},
+            env, s.pad, devkeys::functionPrompt());
+    rows.insert(rows.end(), r.hotkeys.begin(), r.hotkeys.end());
+    r.hotkeys = rows;
+    s.scene = bmart::sceneFor(r, s.pad);
+    // No table view here (onActions has no toggle): no hint for one.
+    auto& foot = s.scene.footer;
+    foot.erase(std::remove_if(foot.begin(), foot.end(),
+                              [](const std::string& f) { return f.size() > 6 && f.compare(f.size() - 6, 6, " Table") == 0; }),
+               foot.end());
+    s.scene.pal = bmart::paletteXmb();
+    s.scene.table = r.drawing.empty();
+    bmart::translateScene(&s.scene, trUi);
+    const std::string lang = prop("persist.sys.locale");
+    s.scene.rtl = lang.rfind("ar", 0) == 0 || lang.rfind("he", 0) == 0 || lang.rfind("iw", 0) == 0;
+    if (s.assets.fontPath.empty() || !bmart::layout(s.scene, s.assets, w, h, &s.layout)) {
+        ALOGW("DrasticNano: button map: no font or layout at %dx%d", w, h);
+        return false;
+    }
+    bmap::NavModel m = s.layout.nav();
+    const float unit = (float)std::min(w, h);
+    m.slop = std::max(10.0f, unit / 60.0f);
+    m.swipeMin = unit * 0.08f;
+    s.nav = bmap::Nav();
+    s.nav.setModel(m);
+    s.nav.setTouchSpace(1.0f, 1.0f, (float)s.layout.w, (float)s.layout.h);
+    s.touchWasDown = true;
+    s.input = bmap::NavInput(bmap::NavConfig());
+    memset(s.held, 0, sizeof(s.held));
+    s.dirty = true;
+    s.open = true;
+    ALOGI("DrasticNano: buttonmap: ctx=game/drastic-nano/nds source=%d rows=%zu", (int)r.source, r.rows.size());
+    return true;
+}
+
+void ButtonMapOverlay::close() {
+    mS->open = false;
+    mS->rgba.clear();
+    mS->rgba.shrink_to_fit();
+}
+
+bool ButtonMapOverlay::onActions(const drastic_input::InputActions& a) {
+    State& s = *mS;
+    if (!s.open) return false;
+    if (a.navCancel || a.navStart || a.menuToggle) {
+        close();
+        return true;
+    }
+    const int64_t now = android::uptimeMillis();
+    auto act = [&](bmap::NavAction na) { if (na != bmap::NavAction::kNone && s.nav.apply(na)) s.dirty = true; };
+    const bool held[4] = {a.navUpHeld || a.navUp, a.navDownHeld || a.navDown, a.navLeftHeld || a.navLeft,
+                          a.navRightHeld || a.navRight};
+    static const bmap::Phys kDir[4] = {bmap::Phys::DUp, bmap::Phys::DDown, bmap::Phys::DLeft, bmap::Phys::DRight};
+    for (int i = 0; i < 4; i++) {
+        if (held[i] != s.held[i]) act(s.input.button(kDir[i], held[i], now));
+        s.held[i] = held[i];
+    }
+    if (a.navPrevTab) act(bmap::NavAction::kPageUp);
+    if (a.navNextTab) act(bmap::NavAction::kPageDown);
+    act(s.input.tick(now));
+    if (s.nav.tick(now)) s.dirty = true;
+    return false;
+}
+
+bool ButtonMapOverlay::onTouch(bool down, int dsX, int dsY, bool tapCloses) {
+    State& s = *mS;
+    if (!s.open) return false;
+    const bool downEdge = down && !s.touchWasDown, upEdge = !down && s.touchWasDown;
+    s.touchWasDown = down;
+    if (!down && !upEdge) return false;
+    float x, y;
+    drastic_overlay::touchFraction(dsX, dsY, &x, &y);
+    const int64_t now = android::uptimeMillis();
+    s.nav.pointers(1);
+    if (downEdge) {
+        s.nav.touchDown(x, y, now);
+        return false;
+    }
+    s.nav.touchMove(x, y, now);
+    if (!upEdge) return false;
+    if (s.nav.touchUp(now) != bmap::NavAction::kClose || !tapCloses) return false;
+    close();
+    return true;
+}
+
+void ButtonMapOverlay::draw(drastic_gfx::OverlayGfx& gfx) {
+    State& s = *mS;
+    if (!s.open) return;
+    const float scroll = s.nav.scroll();
+    const bool moving = s.nav.flinging() || s.nav.dragging();
+    if (s.dirty || !s.tex || fabsf(scroll - s.drawnScroll) > 0.25f || moving != s.drawnMoving) {
+        if (bmart::render(s.scene, s.assets, s.layout, scroll, &s.rgba, moving)) {
+            if (s.tex) gfx.destroyTexture(s.tex);
+            s.tex = gfx.createImageTexture(s.rgba.data(), s.layout.w, s.layout.h);
+        }
+        s.dirty = false;
+        s.drawnScroll = scroll;
+        s.drawnMoving = moving;
+    }
+    if (s.tex) gfx.drawImage(s.tex, 0, 0, (float)gfx.viewportW(), (float)gfx.viewportH());
+}
+
+void ButtonMapOverlay::releaseGl(drastic_gfx::OverlayGfx& gfx) {
+    if (mS->tex) gfx.destroyTexture(mS->tex);
+    mS->tex = 0;
+}
+
+}  // namespace drastic_nano
+}  // namespace android
