+
+/*
+ * Thimsy's <cutils/properties.h> for the Linux and host builds of Nano: libcutils' property calls
+ * on the process-wide config store (nanocompat/nanocompat.h, docs/linux/IMPLEMENTATION.md B.2).
+ *
+ * Android's behaviour is kept where Nano depends on it:
+ *   - property_get copies at most PROPERTY_VALUE_MAX - 1 bytes; an unset or empty key gives the
+ *     default (cut to the same length), or "" and 0 without one.
+ *   - property_set refuses a value of 92 bytes or more for a key not starting "ro." (returns -1):
+ *     Nano splits long lists into continuation keys for this limit. An empty value clears the key.
+ *   - property_get_bool: "1", "y", "yes", "on", "true" are true; "0", "n", "no", "off", "false"
+ *     are false (exact case); anything else gives the default.
+ *   - property_get_int32/int64: strtoimax with base 0 ("0x10" is 16, "010" is 8), leading space
+ *     skipped and trailing text ignored ("12abc" is 12, as libcutils does); no digits, overflow or
+ *     a value outside the type's range give the default.
+ */
+#ifndef NANOCOMPAT_CUTILS_PROPERTIES_H
+#define NANOCOMPAT_CUTILS_PROPERTIES_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/system_properties.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PROPERTY_KEY_MAX PROP_NAME_MAX
+#define PROPERTY_VALUE_MAX PROP_VALUE_MAX
+
+int property_get(const char* key, char* value, const char* default_value);
+int property_set(const char* key, const char* value);
+int8_t property_get_bool(const char* key, int8_t default_value);
+int64_t property_get_int64(const char* key, int64_t default_value);
+int32_t property_get_int32(const char* key, int32_t default_value);
+/* Calls propfn(key, value, cookie) for every property that has a value. Returns 0. */
+int property_list(void (*propfn)(const char* key, const char* value, void* cookie), void* cookie);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* NANOCOMPAT_CUTILS_PROPERTIES_H */
diff --git a/frameworks/base/cmds/gammaos-nano/compat/include/log/log.h b/frameworks/base/cmds/gammaos-nano/compat/include/log/log.h
new file mode 100644
index 00000000000..41aa45b1aeb
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/compat/include/log/log.h
@@ -0,0 +1,236 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Thimsy's <log/log.h> for the Linux and host builds of Nano: liblog's macros with Android's
+ * behaviour, on top of <android/log.h>.
+ *
+ *   ALOGV/D/I/W/E(fmt, ...)      the main log; SLOGV/D/I/W/E the system log (the same sink here)
+ *   ALOGx_IF(cond, fmt, ...)     log only when cond is true; cond is evaluated once
+ *   LOG_ALWAYS_FATAL(fmt, ...)   log at FATAL and abort; LOG_ALWAYS_FATAL_IF(cond, ...)
+ *   LOG_FATAL_IF(cond, ...)      as LOG_ALWAYS_FATAL_IF, but only when LOG_NDEBUG is 0
+ *   ALOG_ASSERT(cond, ...)       LOG_FATAL_IF(!(cond), ...)
+ *   ALOG(LOG_INFO, tag, ...)     LOG_PRI(ANDROID_LOG_INFO, tag, ...); IF_ALOG(LOG_INFO, tag)
+ *
+ * As on Android, LOG_NDEBUG defaults to 1 when NDEBUG is defined and to 0 otherwise, and is read
+ * when this header is first included. With LOG_NDEBUG set, ALOGV and SLOGV compile to nothing (the
+ * arguments are still type-checked, never evaluated), and the _IF forms of V and LOG_FATAL_IF
+ * vanish. LOG_TAG is read where a macro is used, so it may be defined after the include; without
+ * one the tag is empty.
+ */
+#ifndef NANOCOMPAT_LOG_LOG_H
+#define NANOCOMPAT_LOG_LOG_H
+
+#include <android/log.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#ifndef LOG_NDEBUG
+#ifdef NDEBUG
+#define LOG_NDEBUG 1
+#else
+#define LOG_NDEBUG 0
+#endif
+#endif
+
+#ifndef LOG_TAG
+#define LOG_TAG NULL
+#endif
+
+#ifndef __predict_false
+#define NANOCOMPAT_PREDICT_FALSE(exp) __builtin_expect((exp) != 0, 0)
+#else
+#define NANOCOMPAT_PREDICT_FALSE(exp) __predict_false(exp)
+#endif
+
+#ifndef CONDITION
+#define CONDITION(cond) (NANOCOMPAT_PREDICT_FALSE(cond))
+#endif
+
+/* ---- priority-generic forms ---- */
+
+#ifndef LOG_PRI
+#define LOG_PRI(priority, tag, ...) __android_log_print(priority, tag, __VA_ARGS__)
+#endif
+#ifndef LOG_PRI_VA
+#define LOG_PRI_VA(priority, tag, fmt, args) __android_log_vprint(priority, tag, fmt, args)
+#endif
+#ifndef android_printLog
+#define android_printLog(prio, tag, ...) __android_log_print(prio, tag, __VA_ARGS__)
+#endif
+#ifndef android_testLog
+#define android_testLog(prio, tag) (__android_log_is_loggable(prio, tag, ANDROID_LOG_VERBOSE) != 0)
+#endif
+#ifndef ALOG
+#define ALOG(priority, tag, ...) LOG_PRI(ANDROID_##priority, tag, __VA_ARGS__)
+#endif
+#ifndef IF_ALOG
+#define IF_ALOG(priority, tag) if (android_testLog(ANDROID_##priority, tag))
+#endif
+
+/* ---- the main log ---- */
+
+#ifndef __ALOGV
+#define __ALOGV(...) ((void)ALOG(LOG_VERBOSE, LOG_TAG, __VA_ARGS__))
+#endif
+
+#ifndef ALOGV
+#if LOG_NDEBUG
+#define ALOGV(...)                   \
+    do {                             \
+        if (0) {                     \
+            __ALOGV(__VA_ARGS__);    \
+        }                            \
+    } while (0)
+#else
+#define ALOGV(...) __ALOGV(__VA_ARGS__)
+#endif
+#endif
+
+#ifndef ALOGV_IF
+#if LOG_NDEBUG
+#define ALOGV_IF(cond, ...) ((void)0)
+#else
+#define ALOGV_IF(cond, ...) \
+    ((CONDITION(cond)) ? ((void)ALOG(LOG_VERBOSE, LOG_TAG, __VA_ARGS__)) : (void)0)
+#endif
+#endif
+
+#ifndef ALOGD
+#define ALOGD(...) ((void)ALOG(LOG_DEBUG, LOG_TAG, __VA_ARGS__))
+#endif
+#ifndef ALOGD_IF
+#define ALOGD_IF(cond, ...) \
+    ((CONDITION(cond)) ? ((void)ALOG(LOG_DEBUG, LOG_TAG, __VA_ARGS__)) : (void)0)
+#endif
+#ifndef ALOGI
+#define ALOGI(...) ((void)ALOG(LOG_INFO, LOG_TAG, __VA_ARGS__))
+#endif
+#ifndef ALOGI_IF
+#define ALOGI_IF(cond, ...) \
+    ((CONDITION(cond)) ? ((void)ALOG(LOG_INFO, LOG_TAG, __VA_ARGS__)) : (void)0)
+#endif
+#ifndef ALOGW
+#define ALOGW(...) ((void)ALOG(LOG_WARN, LOG_TAG, __VA_ARGS__))
+#endif
+#ifndef ALOGW_IF
+#define ALOGW_IF(cond, ...) \
+    ((CONDITION(cond)) ? ((void)ALOG(LOG_WARN, LOG_TAG, __VA_ARGS__)) : (void)0)
+#endif
+#ifndef ALOGE
+#define ALOGE(...) ((void)ALOG(LOG_ERROR, LOG_TAG, __VA_ARGS__))
+#endif
+#ifndef ALOGE_IF
+#define ALOGE_IF(cond, ...) \
+    ((CONDITION(cond)) ? ((void)ALOG(LOG_ERROR, LOG_TAG, __VA_ARGS__)) : (void)0)
+#endif
+
+/* ---- the system log (liblog's log_system.h) ---- */
+
+#ifndef __SLOGV
+#define __SLOGV(...) \
+    ((void)__android_log_buf_print(LOG_ID_SYSTEM, ANDROID_LOG_VERBOSE, LOG_TAG, __VA_ARGS__))
+#endif
+
+#ifndef SLOGV
+#if LOG_NDEBUG
+#define SLOGV(...)                   \
+    do {                             \
+        if (0) {                     \
+            __SLOGV(__VA_ARGS__);    \
+        }                            \
+    } while (0)
+#else
+#define SLOGV(...) __SLOGV(__VA_ARGS__)
+#endif
+#endif
+
+#ifndef SLOGV_IF
+#if LOG_NDEBUG
+#define SLOGV_IF(cond, ...) ((void)0)
+#else
+#define SLOGV_IF(cond, ...)                                                                      \
+    ((CONDITION(cond))                                                                           \
+         ? ((void)__android_log_buf_print(LOG_ID_SYSTEM, ANDROID_LOG_VERBOSE, LOG_TAG,           \
+                                          __VA_ARGS__))                                          \
+         : (void)0)
+#endif
+#endif
+
+#define NANOCOMPAT_SLOG(prio, ...) \
+    ((void)__android_log_buf_print(LOG_ID_SYSTEM, prio, LOG_TAG, __VA_ARGS__))
+#define NANOCOMPAT_SLOG_IF(cond, prio, ...) \
+    ((CONDITION(cond)) ? NANOCOMPAT_SLOG(prio, __VA_ARGS__) : (void)0)
+
+#ifndef SLOGD
+#define SLOGD(...) NANOCOMPAT_SLOG(ANDROID_LOG_DEBUG, __VA_ARGS__)
+#endif
+#ifndef SLOGD_IF
+#define SLOGD_IF(cond, ...) NANOCOMPAT_SLOG_IF(cond, ANDROID_LOG_DEBUG, __VA_ARGS__)
+#endif
+#ifndef SLOGI
+#define SLOGI(...) NANOCOMPAT_SLOG(ANDROID_LOG_INFO, __VA_ARGS__)
+#endif
+#ifndef SLOGI_IF
+#define SLOGI_IF(cond, ...) NANOCOMPAT_SLOG_IF(cond, ANDROID_LOG_INFO, __VA_ARGS__)
+#endif
+#ifndef SLOGW
+#define SLOGW(...) NANOCOMPAT_SLOG(ANDROID_LOG_WARN, __VA_ARGS__)
+#endif
+#ifndef SLOGW_IF
+#define SLOGW_IF(cond, ...) NANOCOMPAT_SLOG_IF(cond, ANDROID_LOG_WARN, __VA_ARGS__)
+#endif
+#ifndef SLOGE
+#define SLOGE(...) NANOCOMPAT_SLOG(ANDROID_LOG_ERROR, __VA_ARGS__)
+#endif
+#ifndef SLOGE_IF
+#define SLOGE_IF(cond, ...) NANOCOMPAT_SLOG_IF(cond, ANDROID_LOG_ERROR, __VA_ARGS__)
+#endif
+
+/* ---- fatal ---- */
+
+/*
+ * The message is optional, as on Android: "" is pasted before it, so the format must be a string
+ * literal (it is in every Nano call), and with no message only the condition is logged.
+ */
+#ifndef LOG_ALWAYS_FATAL_IF
+#define LOG_ALWAYS_FATAL_IF(cond, ...) \
+    ((CONDITION(cond)) ? nanocompat_log_fatal(#cond, LOG_TAG, "" __VA_ARGS__) : (void)0)
+#endif
+#ifndef LOG_ALWAYS_FATAL
+#define LOG_ALWAYS_FATAL(...) nanocompat_log_fatal(NULL, LOG_TAG, "" __VA_ARGS__)
+#endif
+
+#ifndef LOG_FATAL_IF
+#if LOG_NDEBUG
+#define LOG_FATAL_IF(cond, ...) ((void)0)
+#else
+#define LOG_FATAL_IF(cond, ...) LOG_ALWAYS_FATAL_IF(cond, __VA_ARGS__)
+#endif
+#endif
+#ifndef LOG_FATAL
+#if LOG_NDEBUG
+#define LOG_FATAL(...) ((void)0)
+#else
+#define LOG_FATAL(...) LOG_ALWAYS_FATAL(__VA_ARGS__)
+#endif
+#endif
+#ifndef ALOG_ASSERT
+#define ALOG_ASSERT(cond, ...) LOG_FATAL_IF(!(cond), __VA_ARGS__)
+#endif
+
+#endif /* NANOCOMPAT_LOG_LOG_H */
diff --git a/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/bionic.h b/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/bionic.h
new file mode 100644
index 00000000000..2d135afa0a3
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/bionic.h
@@ -0,0 +1,127 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Bionic-only libc extras that Nano's shared files use, for the Linux and host builds.
+ *
+ * Force-included (-include nanocompat/bionic.h) into every Linux and host translation unit, so no
+ * Nano file is edited (docs/linux/IMPLEMENTATION.md B.2, decision I31). It is never on Android's
+ * include path, and it does nothing when it finds Bionic.
+ *
+ * It stays valid C and C++. In C it only defines constants and includes nothing, because a header
+ * included before a C file's own `#define _GNU_SOURCE` (or _POSIX_C_SOURCE) would fix the feature
+ * set too early. C++ translation units are safe to include libc headers into: g++ predefines
+ * _GNU_SOURCE, and the targets are 64-bit, so _FILE_OFFSET_BITS changes nothing.
+ */
+#ifndef NANOCOMPAT_BIONIC_H
+#define NANOCOMPAT_BIONIC_H
+
+#if !defined(__BIONIC__)
+
+/*
+ * Bionic's mallopt() parameters. glibc's and musl's mallopt() (and the sanitizers' replacements)
+ * don't know these values and do nothing, which is what Nano needs on Linux, where they are only
+ * hints (purge the allocator's caches, cap its cache) and Nano ignores the result. They never
+ * collide with glibc's own M_* values (1 to 8 and -1 to -8).
+ */
+#ifndef M_DECAY_TIME
+#define M_DECAY_TIME (-100)
+#endif
+#ifndef M_PURGE
+#define M_PURGE (-101)
+#endif
+#ifndef M_MEMTAG_TUNING
+#define M_MEMTAG_TUNING (-102)
+#endif
+#ifndef M_THREAD_DISABLE_MEM_INIT
+#define M_THREAD_DISABLE_MEM_INIT (-103)
+#endif
+#ifndef M_PURGE_ALL
+#define M_PURGE_ALL (-104)
+#endif
+#ifndef M_CACHE_COUNT_MAX
+#define M_CACHE_COUNT_MAX (-105)
+#endif
+#ifndef M_CACHE_SIZE_MAX
+#define M_CACHE_SIZE_MAX (-106)
+#endif
+#ifndef M_TSDS_COUNT_MAX
+#define M_TSDS_COUNT_MAX (-107)
+#endif
+#ifndef M_BIONIC_ZERO_INIT
+#define M_BIONIC_ZERO_INIT (-108)
+#endif
+#ifndef M_BIONIC_SET_HEAP_TAGGING_LEVEL
+#define M_BIONIC_SET_HEAP_TAGGING_LEVEL (-109)
+#endif
+#ifndef M_LOG_STATS
+#define M_LOG_STATS (-110)
+#endif
+
+#if defined(__cplusplus)
+
+#include <errno.h>
+#include <malloc.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#if defined(__GLIBC__)
+#include <sys/syscall.h>
+#endif
+
+/*
+ * strlcpy and strlcat: in glibc only from 2.38 (musl has them). Same contract as Bionic's and the
+ * BSDs': copy or append at most size - 1 bytes, always terminate when size > 0, and return the
+ * length of the string they tried to make, so a result >= size means it was cut.
+ */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 38)
+static inline size_t strlcpy(char* dst, const char* src, size_t size) {
+    const size_t len = strlen(src);
+    if (size != 0) {
+        const size_t n = len < size - 1 ? len : size - 1;
+        memcpy(dst, src, n);
+        dst[n] = '\0';
+    }
+    return len;
+}
+
+static inline size_t strlcat(char* dst, const char* src, size_t size) {
+    const size_t dlen = strnlen(dst, size);
+    if (dlen == size) return size + strlen(src);   /* dst not terminated within size: append nothing */
+    return dlen + strlcpy(dst + dlen, src, size - dlen);
+}
+#endif
+
+/* gettid(): in glibc only from 2.30 (musl has it from 1.2.2). */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 30)
+static inline pid_t gettid(void) { return (pid_t)syscall(SYS_gettid); }
+#endif
+
+/*
+ * getprogname(): Bionic and the BSDs have it; glibc and musl don't. Both keep the same string as
+ * program_invocation_short_name (declared by <errno.h> under _GNU_SOURCE; repeated here so the
+ * header doesn't depend on that).
+ */
+extern "C" char* program_invocation_short_name;
+static inline const char* getprogname(void) { return program_invocation_short_name; }
+
+#endif /* __cplusplus */
+
+#endif /* !__BIONIC__ */
+
+#endif /* NANOCOMPAT_BIONIC_H */
diff --git a/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/nanocompat.h b/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/nanocompat.h
new file mode 100644
index 00000000000..cd6fc8845d4
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/compat/include/nanocompat/nanocompat.h
@@ -0,0 +1,92 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// The compat layer's own controls, for the Linux and host platforms and the tests. Nano's shared
+// files never include this: they reach the layer only through Android's header names
+// (docs/linux/IMPLEMENTATION.md B.2).
+//
+// Properties. Every property shim (cutils/properties.h, android-base/properties.h,
+// sys/system_properties.h) reads and writes one process-wide thimsy::ConfigStore (libthimsy, B.3).
+// The platform sets it up with nanocompat_init() before any Nano thread starts. If nothing calls
+// it, the first property call opens a default store:
+//   - THIMSY_PROP_ROOT=<dir>: <dir>/persist.props and <dir>/run (tests and host runs);
+//   - otherwise thimsy::ConfigStore::defaultRoots() (the device paths, or THIMSY_PERSIST_FILE and
+//     THIMSY_RUN_DIR).
+// The default store does not watch for other processes' writes. If it can't be opened, every get
+// returns its default and every set fails, and the reason is logged once.
+//
+// Control keys. Some property writes are messages, not settings (B.2, decision I28). The store
+// always stores a write first; observers registered here are told afterwards and can't veto or
+// swallow it. Unlike the store's own observers, they are told of every successful set this process
+// makes, even one that writes the value the key already has, because Android's property triggers
+// fire on every set. Writes by other processes reach them only while the store is watching.
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <string>
+#include <string_view>
+
+namespace thimsy {
+class ConfigStore;
+}
+
+namespace nanocompat {
+
+struct InitOptions {
+    std::string persistFile;   // e.g. /storage/.config/thimsy/persist.props
+    std::string runDir;        // e.g. /run/thimsy/props
+    // Start the store's watcher thread, so other processes' writes reach the cache, the serials,
+    // __system_property_wait and the observers at once. The Linux platform wants this.
+    bool watch = true;
+};
+
+// Opens the process-wide store (and starts its watcher if asked). Call it before any Nano thread
+// starts. Calling it again replaces the store: meant for tests, not for a running Nano (the old
+// store is kept alive, so a thread still holding it is safe, but it stops seeing new writes).
+// Returns false, with *err set, if the store can't be opened; the previous store, if any, stays.
+bool init(const InitOptions& options, std::string* err = nullptr);
+
+// The process-wide store, opened on first use as described above; nullptr if it can't be opened.
+thimsy::ConfigStore* store();
+
+// Observers of property writes. keyOrPrefix is a key, a prefix ending in '.' or '*' (the '*' is
+// dropped), or empty for every key. The callback runs after the value is stored, on the thread
+// that set it (or the store's watcher thread for other processes' writes); value is empty when the
+// key was cleared. A callback may read and set properties; one that throws is ignored. Observers
+// survive init(). Returns an id for removePropertyObserver.
+using PropertyObserver = std::function<void(std::string_view key, std::string_view value)>;
+int addPropertyObserver(std::string_view keyOrPrefix, PropertyObserver observer);
+void removePropertyObserver(int id);
+
+// Logging (log/log.h, android/log.h). Every message is one line to stderr,
+// "<uptime ms> <V|D|I|W|E|F> <tag>: <message>"; a message with several lines is written as several
+// lines with the same prefix.
+// The lowest priority written (ANDROID_LOG_* values; the default writes everything).
+void setLogMinPriority(int priority);
+// Also append every line to `path` (the Linux image uses /run/thimsy/log/nano.log): when the file
+// passes maxBytes / 2 it is renamed to `path`.1, replacing the older half, so the two together stay
+// under maxBytes. An empty path turns it off. When stdout or stderr already is that file (the
+// session starts Nano with both on it), the ring takes them over: lines are not also written to
+// stderr, the size counts their writes, and each rotation moves them to the new half (dup2).
+void setLogFile(const std::string& path, size_t maxBytes = 256 * 1024);
+// Replaces stderr as the line sink (tests); nullptr restores stderr. The file above still gets
+// every line. The sink gets the priority, the tag ("" for none) and one message (without the
+// prefix; may contain newlines).
+using LogSink = std::function<void(int priority, const char* tag, const char* message)>;
+void setLogSink(LogSink sink);
+
+}  // namespace nanocompat
