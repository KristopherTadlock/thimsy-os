+// GammaOS: a powered-on monitor, while no internal display is on, or beside one in dual screen mode
+// (persist.gammaos.display.mode, GammaosScreenArrangement.MODE_PROP). Never in mirror mode, where the
+// panel paces and the monitor only shows its frame.
+bool SurfaceFlinger::gammaMonitorIsActivatable(const DisplayDevice& display) const {
+    const auto idOpt = PhysicalDisplayId::tryCast(display.getId());
+    if (!idOpt || !display.isPoweredOn() || !gammaIsMonitor(*idOpt)) {
+        return false;
+    }
+    const std::string mode = base::GetProperty("persist.gammaos.display.mode"s, ""s);
+    if (mode == "mirror") return false;
+    if (mode == "dual") return true;
+    return !findDisplay([this](const DisplayDevice& other) REQUIRES(mStateLock) {
+        const auto otherId = PhysicalDisplayId::tryCast(other.getId());
+        return otherId && other.isPoweredOn() &&
+                mPhysicalDisplays.get(*otherId).transform(&PhysicalDisplay::isInternal).value_or(false);
+    });
+}
+
+// GammaOS: a monitor showing display 0 in mirror mode (DisplayManagerService
+// .gammaosConfigureMirrorLocked gives it display 0's layer stack). CompositionEngine composes it
+// from the panel's frame, scaled sharp bilinear (Output::composeThimsyMirror).
+bool SurfaceFlinger::gammaIsMirror(const DisplayDevice& display) const {
+    const auto idOpt = PhysicalDisplayId::tryCast(display.getId());
+    const ui::LayerStack stack = display.getLayerStack();
+    if (!idOpt || stack == ui::INVALID_LAYER_STACK || !gammaIsMonitor(*idOpt) ||
+        base::GetProperty("persist.gammaos.display.mode"s, ""s) != "mirror") {
+        return false;
+    }
+    return findDisplay([this, stack](const DisplayDevice& panel) REQUIRES(mStateLock) {
+               const auto panelId = PhysicalDisplayId::tryCast(panel.getId());
+               return panelId && panel.getLayerStack() == stack &&
+                       mPhysicalDisplays.get(*panelId)
+                               .transform(&PhysicalDisplay::isInternal)
+                               .value_or(false);
+           }) != nullptr;
 }
 
