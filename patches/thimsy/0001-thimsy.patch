+        const std::string r = rel.empty() ? n : rel + "/" + n;
+        struct stat st;
+        if (lstat((dir + "/" + r).c_str(), &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) sdListFiles(dir, r, out);
+        else if (S_ISREG(st.st_mode)) out->push_back(r);
+    }
