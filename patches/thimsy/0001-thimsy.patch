+                    return new ThimsyUidAccess(true, true, packages, expiresAtMs);
+                }
+            }
+            return new ThimsyUidAccess(false, true, packages, expiresAtMs);
+        } catch (RuntimeException e) {
+            if (shouldLogThimsy(uid + "|resolve")) {
