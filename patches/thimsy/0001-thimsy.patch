+    @Override
+    protected void handleSetListening(boolean listening) {
+        super.handleSetListening(listening);
+        if (listening) refreshState();
+    }
+
+    @Override
+    protected void handleClick(@Nullable View view) {
+        final String mode = mode();
+        SystemProperties.set(PROP_MODE,
+                "docked".equals(mode) ? "dual" : "dual".equals(mode) ? "mirror" : "docked");
+        refreshState();
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        final String mode = mode();
+        final boolean docked = "docked".equals(mode);
+        state.label = mContext.getString(R.string.quick_settings_external_display_label);
