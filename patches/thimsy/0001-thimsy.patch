+        assertEquals("nano backup",
+                ThimsyStorageDenylist.getRefusalLogKey("/storage/1234-ABCD/Nano Backup"));
+        assertEquals("android/data/com.foo", ThimsyStorageDenylist.getRefusalLogKey(
+                "/storage/emulated/0/Android/data/com.foo/files/x"));
+        assertEquals("android/obb/com.foo", ThimsyStorageDenylist.getRefusalLogKey(
+                "/storage/emulated/0/Android/obb/com.foo"));
+        assertEquals("/storage/emulated/0/ROMs/a",
+                ThimsyStorageDenylist.getRefusalLogKey("/storage/emulated/0/ROMs/a"));
+    }
+
+    @Test
+    public void selfGrantedPackagesIncludePackInsAndPropChunks() {
+        final java.util.Set<String> none =
+                ThimsyStorageDenylist.parseSelfGrantedPackages("", new String[5]);
+        assertEquals(12, none.size());
+        assertTrue(none.contains("com.retroarch.aarch64"));
+        assertTrue(none.contains("org.scummvm.scummvm"));
+
+        final java.util.Set<String> some = ThimsyStorageDenylist.parseSelfGrantedPackages(
+                " com.a , com.b", new String[] {"com.c", "", null, "com.d,,bad name", " com.e"});
+        for (String pkg : new String[] {"com.a", "com.b", "com.c", "com.d", "com.e"}) {
+            assertTrue(pkg, some.contains(pkg));
+        }
+        assertFalse(some.contains("bad name"));
+        assertFalse(some.contains(""));
+        assertEquals(17, some.size());
+
+        final java.util.Set<String> joined = ThimsyStorageDenylist.parseSelfGrantedPackages(
+                "com.x,", new String[] {"com.y"});
+        assertTrue(joined.contains("com.x"));
+        assertTrue(joined.contains("com.y"));
+        assertEquals("persist.gammaos.perm.mestorage",
+                ThimsyStorageDenylist.SELF_GRANTED_PACKAGES_PROP);
+        assertEquals(5, ThimsyStorageDenylist.SELF_GRANTED_PACKAGES_PROP_CHUNKS);
+    }
+
+    @Test
+    public void subqueriesWrapTheHiddenRowsSelection() {
+        final String[] own = {"com.me"};
+        final String rows = ThimsyStorageDenylist.buildHiddenRowsSelection(own);
+        assertEquals("SELECT _id FROM files WHERE NOT (" + rows + ")",
+                ThimsyStorageDenylist.buildHiddenIdsSubquery(own));
+        assertEquals("SELECT _id FROM files WHERE media_type IN (2, 4) AND NOT (" + rows + ")",
+                ThimsyStorageDenylist.buildHiddenIdsSubquery(own, 2, 4));
+        assertEquals("SELECT album_id FROM files WHERE media_type IN (2) AND album_id IS NOT NULL"
+                + " AND (" + rows + ")",
+                ThimsyStorageDenylist.buildVisibleValuesSubquery("album_id", own, 2));
+    }
+
+    @Test
+    public void normalizeLeavesCleanPathsUntouched() {
+        final String path = "/storage/emulated/0/ROMs/psx/game.chd";
+        assertTrue(path == ThimsyStorageDenylist.normalize(path));
+        assertEquals("/storage/emulated/0/DCIM",
+                ThimsyStorageDenylist.normalize("/storage/emulated/0/x/..//DCIM/."));
+        assertEquals("/", ThimsyStorageDenylist.normalize("/../.."));
+    }
+}
