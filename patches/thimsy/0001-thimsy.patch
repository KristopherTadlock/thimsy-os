+    EXPECT_FALSE(exists(tmp + "/box/evil.txt"));
+    EXPECT_FALSE(exists(tmp + "/evil.txt"));
+    EXPECT_FALSE(exists(tmp + "/evil2.txt"));
+    EXPECT_FALSE(exists(tmp + "/abs.txt"));
