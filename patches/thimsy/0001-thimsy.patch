+// The BIOS installer's path, ownership and space helpers, and root's reads and writes of an app's
+// settings files (never through a link the app controls).
+
+#include <gtest/gtest.h>
+
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <string>
