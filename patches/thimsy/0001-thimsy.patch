+TEST_F(FileJob, ReplaceOlderOnlyReplacesWithANewerFile) {
+  put(card + "/a.sav", "old");
+  struct timespec ts[2] = {{1000, 0}, {1000, 0}};
+  utimensat(AT_FDCWD, (card + "/a.sav").c_str(), ts, 0);
