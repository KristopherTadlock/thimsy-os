+        if (stat(path.c_str(), &sb) != 0) continue;
+        const long long m = (long long)sb.st_mtim.tv_sec * 1000000000LL + sb.st_mtim.tv_nsec;
+        mtime = mtime < 0 ? m : mtime * 31 + m;
+        size = size < 0 ? (long long)sb.st_size : size * 31 + (long long)sb.st_size;
+    }
+    if (mtime == st.mtime && size == st.size && st.roms == sys.roms.size()) return;
+    const bool firstParse = mEsdeGamelistParsed.insert(sysIdx).second;   // per system: two can share a gamelist
+    st.mtime = mtime; st.size = size; st.roms = sys.roms.size();
+    EsdeGlPending pd;
+    pd.id = ++mEsdeGlNextId;
+    pd.first = firstParse;
+    if (mtime < 0) {   // no gamelist (any more): drop what was read
+        mEsdeGlReading.erase(sys.id);
+        esdeGamelistApply(sysIdx, pd.first, {});
+        return;
+    }
+    mEsdeGlReading[sys.id] = pd;
+    EsdeGamelistPool::Job job;
+    job.id = pd.id;
+    job.urgent = mode != kGlPrefetch;
+    for (const auto& path : paths) job.inputs.push_back(esdeGamelistInput(sysIdx, path));
+    if (!mEsdeGlPool) mEsdeGlPool = std::make_shared<EsdeGamelistPool>();
+    mEsdeGlPool->submit(std::move(job));
