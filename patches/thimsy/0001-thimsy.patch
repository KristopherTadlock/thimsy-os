+LOCAL_UNINSTALLABLE_MODULE := true
+include $(BUILD_PREBUILT)
diff --git a/device/phh/treble/phh-prop-handler.sh b/device/phh/treble/phh-prop-handler.sh
index e1874662bb8..41c31416cb7 100644
--- a/device/phh/treble/phh-prop-handler.sh
+++ b/device/phh/treble/phh-prop-handler.sh
@@ -269,6 +269,20 @@ if [ "$1" == "persist.bluetooth.system_audio_hal.enabled" ]; then
         exit 1
     fi
 
+    # What the audio policy picks its Bluetooth setup from: A2DP offload in use, and the
+    # Bluetooth audio HAL turned off.
+    bt_audio_state() {
+        offload=0
+        if [[ "$(getprop ro.bluetooth.a2dp_offload.supported)" == "true" &&
+              "$(getprop persist.bluetooth.a2dp_offload.disabled)" != "true" ]]; then
+            offload=1
+        fi
+        hal_off=0
+        [[ "$(getprop persist.bluetooth.bluetooth_audio_hal.disabled)" == "true" ]] && hal_off=1
+        echo "$offload$hal_off"
+    }
+    before="$(bt_audio_state)"
+
     if [[ "$prop_value" == "true" ]]; then
         setprop persist.bluetooth.bluetooth_audio_hal.disabled false
         setprop persist.bluetooth.a2dp_offload.disabled true
@@ -278,6 +292,10 @@ if [ "$1" == "persist.bluetooth.system_audio_hal.enabled" ]; then
         resetprop_phh --delete persist.bluetooth.a2dp_offload.disabled
         resetprop_phh --delete ro.bluetooth.a2dp_offload.supported
     fi
-    restartAudio
+    # This runs at every boot, re-applying the saved setting just after audioserver starts; a
+    # restart there is pointless and init holds it back 5 s, which system_server waits out.
+    if [[ "$(bt_audio_state)" != "$before" ]]; then
+        restartAudio
+    fi
     exit
 fi
