+        found("neocd", "/storage/emulated/0/ROMs/neocd"),
+        found("Satellaview", "/storage/1234-ABCD/ROMs/Satellaview"),
+        found("supergrafx", "/storage/emulated/0/ROMs/supergrafx"),
+        found("satellaview", "/storage/emulated/0/ROMs/satellaview"),   // found twice
+        found("media", "/storage/emulated/0/ROMs/media"),              // no platform
+    };
+    const auto adds = splitFolderAdds(systems, f, kSplitIds);
+    ASSERT_EQ(adds.size(), 3u);
+    EXPECT_EQ(kSplitIds[adds[0].platform], "satellaview");
+    EXPECT_EQ(adds[0].folders, (std::vector<std::string>{"/storage/emulated/0/ROMs/satellaview",
+                                                         "/storage/1234-ABCD/ROMs/Satellaview"}));
+    EXPECT_EQ(kSplitIds[adds[1].platform], "neogeocd");
+    EXPECT_EQ(adds[1].folders, (std::vector<std::string>{"/storage/emulated/0/ROMs/neocd"}));
+    EXPECT_EQ(kSplitIds[adds[2].platform], "supergrafx");
+}
+
+// Never a second system for games a system already shows.
+TEST(NanoSystemsSplitHeal, NoDuplicates) {
+    const std::vector<FoundFolder> f = {found("satellaview", "/storage/emulated/0/ROMs/satellaview"),
+                                        found("sgb", "/storage/1234-ABCD/ROMs/sgb"),
+                                        found("n64dd", "/storage/emulated/0/ROMs/n64dd")};
+    // A Satellaview system the folder auto-add made, a system with that card folder as a source, a
+    // system scanning the whole ROMs folder.
+    SysCore bsx = catalogMade("satellaview", "BSX", "satellaview");
+    SysCore gb = core("gb", "sameboy_libretro_android.so");
+    gb.folders = {"/storage/1234-ABCD/ROMs/sgb"};
+    SysCore all = app("n64");
+    all.folders = {"/storage/emulated/0/ROMs"};
+    EXPECT_TRUE(splitFolderAdds({bsx, gb, all}, f, kSplitIds).empty());
+    // The same, with the Satellaview one under another folder name: the same platform.
+    SysCore bsx2 = catalogMade("satellaview2", "BSX", "bsx");
+    const auto adds = splitFolderAdds({bsx2}, f, kSplitIds);
+    ASSERT_EQ(adds.size(), 2u);
+    EXPECT_EQ(kSplitIds[adds[0].platform], "sgb");
+    EXPECT_EQ(kSplitIds[adds[1].platform], "n64dd");
+    // And nothing without folders.
+    EXPECT_TRUE(splitFolderAdds({}, {}, kSplitIds).empty());
+}
+
+// The heal waits for every drive vold has mounted to be mounted for apps too, so a card's folders are
+// looked for only once they can be seen.
+TEST(NanoSystemsSplitHeal, DrivesServed) {
+    nanotest::TempDir rw("splitrw");
+    const std::string internal = "/dev/fuse /storage/emulated fuse rw,lazytime 0 0\n";
+    EXPECT_TRUE(drivesServed(rw / "missing", ""));
+    EXPECT_TRUE(drivesServed(rw.path(), internal));   // no drive
+    mkdirs(rw / "1234-ABCD");
+    touch(rw / "stray");                               // not a drive
+    EXPECT_FALSE(drivesServed(rw.path(), internal));
+    EXPECT_FALSE(drivesServed(rw.path(), internal + "/dev/block/vold/public:179,1 /mnt/media_rw/1234-ABCD vfat rw 0 0\n"));
+    EXPECT_FALSE(drivesServed(rw.path(), internal + "/dev/fuse /storage/1234-ABCD/sub fuse rw 0 0\n"));
+    EXPECT_TRUE(drivesServed(rw.path(), internal + "/dev/fuse /storage/1234-ABCD fuse rw,nosuid 0 0"));
+    mkdirs(rw / "5678-EF01");
+    EXPECT_FALSE(drivesServed(rw.path(), internal + "/dev/fuse /storage/1234-ABCD fuse rw 0 0\n"));
+    EXPECT_TRUE(drivesServed(rw.path(), "/dev/fuse /storage/5678-EF01 fuse rw 0 0\n/dev/fuse /storage/1234-ABCD fuse rw 0 0\n"));
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoTouch_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoTouch_test.cpp
new file mode 100644
index 00000000000..3991f788ba1
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/NanoTouch_test.cpp
@@ -0,0 +1,203 @@
+#include <gtest/gtest.h>
+
+#include "NanoTouch.h"
+
+using namespace android;
+
+TEST(TouchZones, TapWithinSlopFires) {
+  TouchZones z; int taps = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; }); z.endFrame();
+  z.down(10, 10, 1000); z.move(15, 15, 1010); z.up(1020);
+  EXPECT_EQ(taps, 1);
+}
+TEST(TouchZones, DragPastSlopIsNotATap) {
+  TouchZones z; int taps = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; }); z.endFrame();
+  z.down(10, 10, 1000); z.move(40, 10, 1010); z.up(1020);
+  EXPECT_EQ(taps, 0);
+}
+TEST(TouchZones, HoldRunsAfterHalfSecondAndReleaseDoesNothing) {
+  TouchZones z; int taps = 0, held = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; }, [&] { held++; }); z.endFrame();
+  z.down(10, 10, 3000);
+  EXPECT_TRUE(z.tick(16, 3499)); EXPECT_EQ(held, 0);
+  z.tick(16, 3500); EXPECT_EQ(held, 1);
+  z.up(3600); EXPECT_EQ(taps, 0);
+}
+TEST(TouchZones, SlowDragStepsOncePerPitchNoFling) {
+  TouchZones z; int steps = 0;
+  z.beginFrame(); z.scroll({0, 0, 100, 400}, TouchZones::kUpDown, 50, [&](int d) { steps += d; return true; }); z.endFrame();
+  z.down(50, 300, 4000);
+  for (int i = 1; i <= 15; i++) z.move(50, 300 - i * 10, 4000 + i * 100);
+  z.up(5600);
+  EXPECT_EQ(steps, 3); EXPECT_FALSE(z.flinging());
+}
+TEST(TouchZones, FlickFlingsAndStops) {
+  TouchZones z; int steps = 0;
+  z.beginFrame(); z.scroll({0, 0, 100, 400}, TouchZones::kUpDown, 50, [&](int d) { steps += d; return true; }); z.endFrame();
+  z.down(50, 300, 6000); z.move(50, 280, 6010); z.move(50, 240, 6020); z.move(50, 200, 6030); z.up(6040);
+  ASSERT_TRUE(z.flinging());
+  int64_t t = 6040; while (z.tick(16, t += 16) && t < 20000) {}
+  EXPECT_FALSE(z.flinging()); EXPECT_GT(steps, 2);
+}
+TEST(TouchZones, FingerOnFlingStopsItAndTapsNothing) {
+  TouchZones z; int steps = 0, taps = 0;
+  z.beginFrame();
+  z.scroll({0, 0, 100, 400}, TouchZones::kUpDown, 50, [&](int d) { steps += d; return true; });
+  z.tap({0, 0, 100, 400}, [&] { taps++; });
+  z.endFrame();
+  z.down(50, 300, 0); z.move(50, 260, 10); z.move(50, 200, 20); z.up(30);
+  ASSERT_TRUE(z.flinging());
+  z.down(50, 100, 60); z.up(70);
+  EXPECT_FALSE(z.flinging()); EXPECT_EQ(taps, 0);
+}
+TEST(TouchZones, PressFiresOnDownViaTakeFired) {
+  TouchZones z; int n = 0;
+  z.beginFrame(); z.press({0, 0, 50, 50}, [&] { n++; }); z.endFrame();
+  z.down(5, 5, 7000);
+  TouchZones::Action a; ASSERT_TRUE(z.takeFired(a)); a();
+  EXPECT_EQ(n, 1); EXPECT_FALSE(z.tracking());
+  TouchRect r; float alpha; EXPECT_TRUE(z.pressShown(7050, r, alpha)); EXPECT_FALSE(z.pressShown(7200, r, alpha));
+}
+TEST(TouchZones, BlockHidesZonesBelow) {
+  TouchZones z; int taps = 0, blockTaps = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; }); z.block({0, 0, 100, 100}, [&] { blockTaps++; }); z.endFrame();
+  z.down(10, 10, 8000); z.up(8010);
+  EXPECT_EQ(taps, 0); EXPECT_EQ(blockTaps, 1);
+}
+TEST(TouchZones, TapMarginGivesWayToRealTap) {
+  TouchZones z; int a = 0, m = 0;
+  z.beginFrame(); z.tap({0, 0, 20, 20}, [&] { a++; }); z.tapMargin({0, 0, 60, 60}, [&] { m++; }); z.endFrame();
+  z.down(5, 5, 0); z.up(10); z.down(40, 40, 100); z.up(110);
+  EXPECT_EQ(a, 1); EXPECT_EQ(m, 1);
+}
+TEST(TouchZones, ShortDragOnListTakesOneStepElseSwipes) {
+  TouchZones z; int steps = 0, swipes = 0; bool canMove = true;
+  z.beginFrame();
+  z.scroll({0, 0, 400, 400}, TouchZones::kAcross, 200, [&](int d) { if (!canMove) return false; steps += d; return true; });
+  z.swipe({0, 0, 400, 400}, [&](int, int) { swipes++; });
+  z.endFrame();
+  z.down(300, 50, 0); z.move(240, 50, 500); z.up(1000);       // 60 px < pitch, slow: one step
+  EXPECT_EQ(steps, 1); EXPECT_EQ(swipes, 0);
+  canMove = false;
+  z.down(300, 50, 2000); z.move(240, 50, 2500); z.up(3000);
+  EXPECT_EQ(swipes, 1);
+}
+TEST(TouchRect, ClipAndGrow) {
+  TouchRect r{10, 10, 10, 10};
+  TouchRect c = r.clippedTo({15, 0, 100, 100}); EXPECT_FLOAT_EQ(c.x, 15); EXPECT_FLOAT_EQ(c.w, 5);
+  TouchRect e = r.clippedTo({50, 50, 1, 1}); EXPECT_EQ(e.w, 0); EXPECT_FALSE(e.contains(50, 50));
+  TouchRect g = r.grownTo(40, 40); EXPECT_FLOAT_EQ(g.x, -5); EXPECT_FLOAT_EQ(g.w, 40);
+}
+
+TEST(TouchZones, PressHighlightFadesOverItsLifetime) {
+  TouchZones z;
+  z.beginFrame(); z.press({10, 20, 30, 40}, [] {}); z.endFrame();
+  TouchRect r; float alpha = 0;
+  EXPECT_FALSE(z.pressShown(1000, r, alpha));   // nothing pressed yet
+  z.down(15, 25, 1000);
+  ASSERT_TRUE(z.pressShown(1000, r, alpha));
+  EXPECT_FLOAT_EQ(alpha, 1.0f); EXPECT_FLOAT_EQ(r.x, 10); EXPECT_FLOAT_EQ(r.w, 30);
+  ASSERT_TRUE(z.pressShown(1080, r, alpha)); EXPECT_NEAR(alpha, 0.5f, 1e-6);
+  EXPECT_FALSE(z.pressShown(1160, r, alpha));
+  EXPECT_FALSE(z.pressShown(999, r, alpha));    // a clock before the press shows nothing
+  EXPECT_TRUE(z.tick(16, 1100));                // frames keep coming while it is lit
+  EXPECT_FALSE(z.tick(16, 1200));
+}
+TEST(TouchZones, PressMarginLightsItsVisibleRect) {
+  TouchZones z; int n = 0;
+  z.beginFrame(); z.pressMargin({0, 0, 80, 80}, [&] { n++; }, {30, 30, 20, 20}); z.endFrame();
+  z.down(5, 5, 500);
+  TouchZones::Action a; ASSERT_TRUE(z.takeFired(a)); a();
+  EXPECT_EQ(n, 1);
+  TouchRect r; float alpha;
+  ASSERT_TRUE(z.pressShown(510, r, alpha));
+  EXPECT_FLOAT_EQ(r.x, 30); EXPECT_FLOAT_EQ(r.w, 20);
+}
+TEST(TouchZones, TakeFiredOnlyOncePerDown) {
+  TouchZones z;
+  z.beginFrame(); z.press({0, 0, 50, 50}, [] {}); z.endFrame();
+  TouchZones::Action a;
+  EXPECT_FALSE(z.takeFired(a));
+  z.down(5, 5, 100);
+  EXPECT_TRUE(z.takeFired(a));
+  EXPECT_FALSE(z.takeFired(a));
+  z.down(500, 500, 200);                       // a down off the button clears nothing new
+  EXPECT_FALSE(z.takeFired(a));
+}
+TEST(TouchZones, PressGestureIgnoresTheRestOfTheTouch) {
+  TouchZones z; int fired = 0, swipes = 0;
+  z.beginFrame();
+  z.swipe({0, 0, 400, 400}, [&](int, int) { swipes++; });
+  z.press({0, 0, 50, 50}, [&] { fired++; });
+  z.endFrame();
+  z.down(5, 5, 0); z.move(200, 5, 50); z.up(60);
+  EXPECT_EQ(swipes, 0);
+  EXPECT_EQ(fired, 0);                         // the caller runs it via takeFired, not the zones
+  TouchZones::Action a; ASSERT_TRUE(z.takeFired(a)); a();
+  EXPECT_EQ(fired, 1);
+}
+TEST(TouchZones, PressOverScrollActsOnReleaseLikeATap) {
+  TouchZones z; int fired = 0, steps = 0;
+  z.beginFrame();
+  z.scroll({0, 0, 100, 400}, TouchZones::kUpDown, 50, [&](int d) { steps += d; return true; });
+  z.press({0, 0, 100, 50}, [&] { fired++; });
+  z.endFrame();
+  z.down(10, 10, 0);
+  TouchZones::Action a; EXPECT_FALSE(z.takeFired(a));
+  z.up(20);
+  EXPECT_EQ(fired, 1);
+  z.down(10, 40, 100); z.move(10, 20, 150); z.move(10, -80, 300); z.up(800);   // a drag from it scrolls
+  EXPECT_EQ(fired, 1); EXPECT_EQ(steps, 2);
+}
+TEST(TouchZones, DownOnFlingDoesNotFirePressInsideIt) {
+  TouchZones z; int steps = 0;
+  z.beginFrame();
+  z.scroll({0, 0, 100, 400}, TouchZones::kUpDown, 50, [&](int d) { steps += d; return true; });
+  z.press({0, 0, 100, 50}, [] {});
+  z.press({200, 0, 50, 50}, [] {});
+  z.endFrame();
+  z.down(50, 300, 0); z.move(50, 260, 10); z.move(50, 200, 20); z.up(30);
+  ASSERT_TRUE(z.flinging());
+  z.down(10, 10, 60); z.up(70);                // on the flinging list: it only stops
+  EXPECT_FALSE(z.flinging());
+  TouchZones::Action a; EXPECT_FALSE(z.takeFired(a));
+  z.down(50, 300, 100); z.move(50, 260, 110); z.move(50, 200, 120); z.up(130);
+  ASSERT_TRUE(z.flinging());
+  z.down(210, 10, 160);                        // a button outside the fling still presses
+  EXPECT_FALSE(z.flinging());
+  EXPECT_TRUE(z.takeFired(a));
+}
+// After a pause the finger's earlier speed is stale: lifting it then must not fling.
+TEST(TouchZones, FlickAfterPauseDoesNotFling) {
+  auto run = [](bool pause) {
+    TouchZones z;
+    z.beginFrame(); z.scroll({0, 0, 100, 1000}, TouchZones::kUpDown, 50, [](int) { return true; }); z.endFrame();
+    z.down(50, 900, 0); z.move(50, 860, 10); z.move(50, 800, 20); z.move(50, 740, 30);
+    int64_t t = 30;
+    if (pause) { t += 200; z.move(50, 739, t); }
+    z.up(t + 10);
+    return z.flinging();
+  };
+  EXPECT_TRUE(run(false));
+  EXPECT_FALSE(run(true));
+}
+TEST(TouchZones, CancelEndsGestureWithoutActing) {
+  TouchZones z; int taps = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; }); z.endFrame();
+  z.down(10, 10, 0); z.cancel(); z.up(10);
+  EXPECT_EQ(taps, 0); EXPECT_FALSE(z.tracking());
+}
+TEST(TouchZones, ZonesAnswerOnlyAfterEndFrame) {
+  TouchZones z; int taps = 0;
+  z.beginFrame(); z.tap({0, 0, 100, 100}, [&] { taps++; });
+  EXPECT_FALSE(z.any());
+  z.down(10, 10, 0); z.up(10);
+  EXPECT_EQ(taps, 0);
+  z.endFrame();
+  EXPECT_TRUE(z.any());
+  z.down(10, 10, 20); z.up(30);
+  EXPECT_EQ(taps, 1);
+  z.clear();
+  EXPECT_FALSE(z.any());
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoTypec_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoTypec_test.cpp
new file mode 100644
index 00000000000..7c805defac1
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/NanoTypec_test.cpp
@@ -0,0 +1,253 @@
+#include <gtest/gtest.h>
+
+#include "NanoTypec.h"
+
+using namespace android;
+
+namespace {
+
+typec::View view(bool partner, const char* role, const char* pd, const char* type = "dual", bool plugged = true,
+                 bool dp = false) {
+    typec::View v;
+    v.plugged = plugged || partner;
+    v.partner = partner;
+    v.powerRole = role;
+    v.pd = pd;
+    v.portType = type;
+    v.displayPort = dp;
+    v.dpCapable = true;
+    return v;
+}
+
+}  // namespace
+
+TEST(Typec, CurrentChoiceIsTheBracketedOne) {
+    EXPECT_EQ(typec::current("source [sink]"), "sink");
+    EXPECT_EQ(typec::current("[dual] source sink"), "dual");
+    EXPECT_EQ(typec::current("[source] sink"), "source");
+    EXPECT_EQ(typec::current("source sink"), "");
+    EXPECT_EQ(typec::current(""), "");
+}
+
+TEST(Typec, PicksThePortThatNegotiates) {
+    // The RG Cube: the PMIC's port (sees the plug, cannot negotiate or be set) and the PD port.
+    EXPECT_EQ(typec::pdPort({{"port0", false, "0.0"}, {"port1", true, "3.0"}}), "port1");
+    EXPECT_EQ(typec::pdPort({{"port1", true, "3.0"}, {"port0", false, "0.0"}}), "port1");
+    EXPECT_EQ(typec::pdPort({{"port0", true, "0.0"}}), "");   // settable but no PD: nothing to negotiate with
+    EXPECT_EQ(typec::pdPort({{"port0", false, "2.0"}}), "");  // read-only
+    EXPECT_EQ(typec::pdPort({}), "");
+    EXPECT_EQ(typec::pdPort({{"port0", true, "0"}, {"port1", true, "3"}}), "port1");   // older kernels: "%d"
+}
+
+TEST(Typec, OffersPowerToAPartnerThatDidNotNegotiate) {
+    const typec::Step s = typec::step(view(true, "sink", "no"), "", 1000, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "source");
+    EXPECT_EQ(s.state, "flip:1000");
+}
+
+TEST(Typec, LeavesEverythingElseAlone) {
+    EXPECT_EQ(typec::step(view(true, "sink", "yes"), "", 1000, 0).write, nullptr);    // a PD charger
+    EXPECT_EQ(typec::step(view(true, "sink", ""), "", 1000, 0).write, nullptr);       // PD unknown
+    EXPECT_EQ(typec::step(view(true, "source", "no"), "", 1000, 0).write, nullptr);   // the Cube supplies already
+    EXPECT_EQ(typec::step(view(false, "sink", ""), "", 1000, 0).write, nullptr);      // still negotiating
+    EXPECT_EQ(typec::step(view(true, "sink", "no", "sink"), "", 1000, 0).write, nullptr);   // not dual role
+    typec::View pc = view(true, "sink", "no");
+    pc.host = true;   // a computer is connected: file transfer is not interrupted
+    EXPECT_EQ(typec::step(pc, "", 1000, 0).write, nullptr);
+    typec::View applying = view(true, "sink", "no");
+    applying.hold = true;   // the USB mode is being applied: wait
+    EXPECT_EQ(typec::step(applying, "", 1000, 0).write, nullptr);
+    EXPECT_EQ(typec::step(applying, "", 1000, 0).state, "");
+    typec::View low = view(true, "sink", "no");
+    low.batteryLow = true;
+    EXPECT_EQ(typec::step(low, "", 1000, 0).write, nullptr);
+    typec::View other = view(true, "sink", "no");
+    other.dpCapable = false;   // a device with no picture over USB-C
+    EXPECT_EQ(typec::step(other, "", 1000, 0).write, nullptr);
+}
+
+TEST(Typec, KeepsTheSourceRoleWithAMonitor) {
+    EXPECT_EQ(typec::step(view(false, "source", ""), "flip:1000", 2000, 0).write, nullptr);   // re-attaching
+    EXPECT_EQ(typec::step(view(true, "sink", "no", "source"), "flip:1000", 1200, 0).write, nullptr);
+    // Negotiated, the DisplayPort mode not shown yet: waits.
+    EXPECT_EQ(typec::step(view(true, "source", "yes", "source"), "flip:1000", 8000, 0).write, nullptr);
+    EXPECT_EQ(typec::step(view(true, "source", "", "source"), "flip:1000", 8000, 0).write, nullptr);
+    const typec::Step s = typec::step(view(true, "source", "yes", "source", true, true), "flip:1000", 8500, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "dual");
+    EXPECT_EQ(s.state, "kept:8500");
+}
+
+TEST(Typec, GivesTheSourceRoleBackToWhatIsNoMonitor) {
+    // Took power without negotiating (a cheap power bank): at once.
+    typec::Step s = typec::step(view(true, "source", "no", "source"), "flip:1000", 2500, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "sink");
+    EXPECT_EQ(s.state, "sink:2500");
+    // Negotiated but never showed DisplayPort (a phone): at the deadline.
+    s = typec::step(view(true, "source", "yes", "source"), "flip:1000", 1000 + typec::kFlipSinkMs, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "sink");
+    EXPECT_EQ(typec::step(view(false, "", "", "sink"), "sink:2500", 3000, 0).write, nullptr);
+    s = typec::step(view(true, "sink", "no", "sink"), "sink:2500", 4000, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "dual");
+    EXPECT_EQ(s.state, "tried:4000");
+    s = typec::step(view(false, "", "", "sink"), "sink:2500", 2500 + typec::kSinkWaitMs, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "dual");
+}
+
+TEST(Typec, WaitsLongerWhileSomethingIsAttached) {
+    // Something attached to the source-only port takes up to ~7 s to settle as a sink.
+    EXPECT_EQ(typec::step(view(false, "source", "", "source", true), "flip:1000", 1000 + typec::kFlipWaitMs, 0).write,
+              nullptr);
+    EXPECT_STREQ(typec::step(view(false, "source", "", "source", true), "flip:1000", 1000 + typec::kFlipSinkMs, 0).write,
+                 "dual");
+}
+
+TEST(Typec, BackToDualWhenNothingTakesPower) {
+    EXPECT_EQ(typec::step(view(false, "source", "", "dual", false), "flip:1000", 1000 + typec::kFlipWaitMs - 1, 1100)
+                  .write,
+              nullptr);
+    const typec::Step s =
+        typec::step(view(false, "source", "", "dual", false), "flip:1000", 1000 + typec::kFlipWaitMs, 1100);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "dual");
+    EXPECT_EQ(s.state, "tried:" + std::to_string(1000 + typec::kFlipWaitMs));
+    // A time from later (another clock) or a garbled property does not keep the port one-role.
+    EXPECT_STREQ(typec::step(view(false, "source", ""), "flip:9000", 1000, 0).write, "dual");
+    EXPECT_STREQ(typec::step(view(false, "source", ""), "flip:", 1000, 0).write, "dual");
+    EXPECT_STREQ(typec::step(view(false, "", ""), "sink:x", 1000, 0).write, "dual");
+}
+
+TEST(Typec, OnceUntilAnUnplug) {
+    // The charger is back as the source after the try: not tried again.
+    EXPECT_EQ(typec::step(view(true, "sink", "no"), "tried:6000", 9000, 0).write, nullptr);
+    EXPECT_EQ(typec::step(view(true, "sink", "no"), "tried:6000", 9000, 0).state, "tried:6000");
+    // Out briefly is not an unplug; out kUnplugMs (after the try has settled) is.
+    const int64_t out = 6000 + typec::kSettleMs + 1000;
+    EXPECT_EQ(typec::step(view(false, "", "", "dual", false), "tried:6000", out + typec::kUnplugMs - 1, out).state,
+              "tried:6000");
+    EXPECT_EQ(typec::step(view(false, "", "", "dual", false), "tried:6000", out + typec::kUnplugMs, out).state, "");
+    // Out since before the try ended counts only from when it settled.
+    EXPECT_EQ(typec::step(view(false, "", "", "dual", false), "tried:6000", 6000 + typec::kSettleMs, 5000).state,
+              "tried:6000");
+}
+
+TEST(Typec, AChargerIsTriedOnceNotOverAndOver) {
+    // A non-PD charger: the PD port's partner appears only once its hard resets end (~6 s), the flip
+    // finds nothing, and the plug is out during the flip itself. The time out during the flip must not
+    // count as an unplug after it.
+    int64_t now = 10000;
+    std::string state;
+    typec::Step s = typec::step(view(true, "sink", "no"), state, now, 0);
+    ASSERT_STREQ(s.write, "source");
+    state = s.state;
+    const int64_t outSince = now + 100;   // the charger cannot attach to a source-only port
+    now += typec::kFlipWaitMs;
+    s = typec::step(view(false, "", "", "source", false), state, now, outSince);
+    ASSERT_STREQ(s.write, "dual");
+    state = s.state;
+    // The plug is seen again within a second of dual role; the PD partner some 6 s later.
+    s = typec::step(view(false, "", "", "dual", false), state, now + 900, outSince);
+    EXPECT_EQ(s.state, state);
+    for (int64_t t = now + 1000; t < now + 7000; t += 500) {
+        s = typec::step(view(t >= now + 6000, "sink", "no", "dual", true), state, t, 0);
+        EXPECT_EQ(s.write, nullptr) << t;
+        EXPECT_EQ(s.state, state) << t;
+    }
+}
+
+TEST(Typec, AComputerSeenOnceIsLeftAloneAllPlugInLong) {
+    typec::View pc = view(false, "", "", "dual", true);
+    pc.host = true;   // seen before the PD port's partner settles
+    typec::Step s = typec::step(pc, "", 1000, 0);
+    EXPECT_EQ(s.write, nullptr);
+    EXPECT_EQ(s.state, "tried:1000");
+    // Later its link is down (MTP set up again, the computer asleep): still left alone.
+    s = typec::step(view(true, "sink", "no"), s.state, 7000, 0);
+    EXPECT_EQ(s.write, nullptr);
+    EXPECT_EQ(s.state, "tried:1000");
+}
+
+TEST(Typec, AMonitorReseatedAtOnceIsTriedAgain) {
+    std::string state = "kept:5000";
+    EXPECT_EQ(typec::step(view(true, "source", "yes", "dual", true, true), state, 6000, 0).state, state);
+    // Its PD partner gone, however briefly, once settled: the next plug-in is tried.
+    EXPECT_EQ(typec::step(view(false, "", "", "dual", true), state, 5000 + typec::kSettleMs - 1, 0).state, state);
+    EXPECT_EQ(typec::step(view(false, "", "", "dual", true), state, 5000 + typec::kSettleMs, 0).state, "");
+}
+
+TEST(Typec, AMonitorPluggedInAgainIsTriedAgain) {
+    std::string state = "tried:5000";
+    typec::Step s = typec::step(view(true, "source", "yes", "dual", true, true), state, 20000, 0);   // working
+    EXPECT_EQ(s.state, state);
+    s = typec::step(view(false, "", "", "dual", false), state, 30000 + typec::kUnplugMs, 30000);   // unplugged
+    EXPECT_EQ(s.state, "");
+    s = typec::step(view(true, "sink", "no"), "", 40000, 0);   // plugged in again, the monitor supplying
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "source");
+}
+
+TEST(Typec, FindsThePdPortByWhatItCanDo) {
+    // The dock device tree's c2c mode: the PMIC registers no port, so the PD port alone, as port0.
+    EXPECT_EQ(typec::pdPort({{"port0", true, "3.0"}}), "port0");
+    EXPECT_EQ(typec::pdPort({{"port2", true, "2.0"}}), "port2");
+    // The data role file reads like the power role's.
+    EXPECT_EQ(typec::current("host [device]"), "device");
+    EXPECT_EQ(typec::current("[host] device"), "host");
+}
+
+TEST(Typec, LeavesDocksAlone) {
+    typec::View dock = view(true, "sink", "yes");
+    dock.dataRole = "host";   // a PD dock that powers the Cube and made it the USB host
+    typec::Step s = typec::step(dock, "", 1000, 0);
+    EXPECT_EQ(s.write, nullptr);
+    EXPECT_EQ(s.state, "tried:1000");
+    // A dock that powers the Cube as a host without PD: never made source-only.
+    typec::View plain = view(true, "sink", "no");
+    plain.dataRole = "host";
+    s = typec::step(plain, "", 1000, 0);
+    EXPECT_EQ(s.write, nullptr);
+    EXPECT_EQ(s.state, "tried:1000");
+    // A PD charger (the Cube a USB device): left alone too, once per plug-in.
+    typec::View charger = view(true, "sink", "yes");
+    charger.dataRole = "device";
+    s = typec::step(charger, "", 1000, 0);
+    EXPECT_EQ(s.write, nullptr);
+    EXPECT_EQ(s.state, "tried:1000");
+    EXPECT_EQ(typec::step(charger, s.state, 9000, 0).state, "tried:1000");
+    // Something that powers the Cube as a device without PD is still offered power.
+    typec::View monitor = view(true, "sink", "no");
+    monitor.dataRole = "device";
+    s = typec::step(monitor, "", 1000, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "source");
+    // Not settled yet (no partner on the PD port): nothing decided.
+    typec::View early = view(false, "sink", "");
+    early.dataRole = "host";
+    EXPECT_EQ(typec::step(early, "", 1000, 0).state, "");
+}
+
+TEST(Typec, ADockBackDuringTheTryEndsIt) {
+    // The port is source-only, yet the partner comes back powering the Cube as its USB host.
+    typec::View dock = view(true, "sink", "yes", "source");
+    dock.dataRole = "host";
+    typec::Step s = typec::step(dock, "flip:1000", 3000, 0);
+    ASSERT_NE(s.write, nullptr);
+    EXPECT_STREQ(s.write, "dual");
+    EXPECT_EQ(s.state, "tried:3000");
+    ASSERT_NE(s.log, nullptr);
+    EXPECT_NE(std::string(s.log).find("a dock powers the Cube"), std::string::npos);
+    // Then left alone until an unplug.
+    dock.portType = "dual";
+    EXPECT_EQ(typec::step(dock, s.state, 8000, 0).write, nullptr);
+    EXPECT_EQ(typec::step(dock, s.state, 8000, 0).state, "tried:3000");
+    // A sink as a USB device during the try is the try's own re-attach: it waits as before.
+    typec::View device = view(true, "sink", "no", "source");
+    device.dataRole = "device";
+    EXPECT_EQ(typec::step(device, "flip:1000", 1200, 0).write, nullptr);
+    EXPECT_EQ(typec::step(device, "flip:1000", 1200, 0).state, "flip:1000");
+}
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/NanoUtf8Case_test.cpp b/frameworks/base/cmds/gammaos-nano/test/unit/NanoUtf8Case_test.cpp
