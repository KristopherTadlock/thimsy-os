+      EXPECT_TRUE(!*m.sha1 || isHex(m.sha1, 40)) << m.name;
+    }
+    for (const auto& group : z.need)
+      for (const char* n : group) {
+        const size_t len = strlen(n);
+        if (len && n[len - 1] == '*') continue;
+        bool member = false;
+        for (const auto& m : z.members) member |= !strcmp(m.name, n);
