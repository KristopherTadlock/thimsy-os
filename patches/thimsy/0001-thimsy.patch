+void NanoMenu::touchHintText(const std::string& text, float x, float y, float scale,
+                             std::initializer_list<uint16_t> codes) {
+    const bool bars = text.find('|') != std::string::npos;
+    std::vector<std::pair<size_t, size_t>> parts;
+    size_t i = 0;
+    while (i < text.size()) {
+        while (i < text.size() && (text[i] == ' ' || text[i] == '|')) i++;
+        if (i >= text.size()) break;
+        size_t e = bars ? text.find('|', i) : text.find("  ", i);
+        if (e == std::string::npos) e = text.size();
+        size_t t = e;
+        while (t > i && text[t - 1] == ' ') t--;
+        parts.push_back({i, t});
+        i = e;
+    }
+    if (parts.size() != codes.size()) return;
+    // drawText lays a right-to-left paragraph out from the right: the first part ends at the
+    // line's right edge.
+    const bool rtl = nanoTextIsRtl(text.c_str());
+    const float lineW = rtl ? measureText(text.c_str(), scale) : 0.0f;
+    auto code = codes.begin();
+    for (const auto& p : parts) {
+        float x0 = measureText(text.substr(0, p.first).c_str(), scale);
+        float x1 = measureText(text.substr(0, p.second).c_str(), scale);
+        if (rtl) { const float m = lineW - x1; x1 = lineW - x0; x0 = m; }
+        touchButtonZone(*code++, {x + x0, y, x1 - x0, (float)FONT_CHAR_H * scale});
     }
