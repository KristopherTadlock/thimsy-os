+// Touch zones: whatever draws an input says, as it draws it, where it is on screen and what touching
+// it does. A touch is matched against the zones of the last frame drawn, the topmost (registered
+// last) first, so it always lands on what the user sees.
+//
+//   tap(rect, action[, hold])  pressed and let go without moving: action. A button, a row, an
+//                              entry, a help prompt. With hold, keeping the finger still on it
+//                              for half a second runs hold instead (and the release does nothing).
+//   scroll(rect, axis, pitch, step)
+//                              a drag along axis moves the content one step per pitch pixels
+//                              (step(+1) = later entries; false at the end), and a flick keeps
+//                              it going. Register it before the entries it holds. single: one
+//                              step a drag at most, and no flick.
+//   swipe(rect, action)        a drag no scroll takes, let go: action(axis, dir), dir +1 for
+//                              right or down.
+//   block(rect, action)        an opaque panel: nothing drawn under it is reached. A tap on it,
+//                              outside the zones drawn over it, runs action (may be empty).
+//   tapMargin(rect, action)    a tap zone that gives way: any other tap zone under the finger wins
+//                              over it. For the slack around a small target (a button hint grown
+//                              to fingertip size) that must not take taps from its neighbours.
+//   press(rect, action)        a fixed on-screen button: highlighted as the finger lands, its action
+//                              handed to the caller then (takeFired), to run once a second finger
+//                              can no longer make the gesture a multi-finger one. The rest of that
+//                              gesture does nothing (no drag, no tap).
+//                              Over a scroll zone it acts on release like a tap, so a drag that
+//                              starts on it still scrolls. pressMargin gives way like tapMargin
+//                              and lights up its visible rect.
+//
+// A finger landing on a fling stops it, and that touch taps nothing; it presses only a button outside
+// the flinging zone.
+//
+// Coordinates are the frame's logical pixels: the space Nano draws in and touchMapRaw maps to.
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace android {
+
+struct TouchRect {
+    float x = 0.0f, y = 0.0f, w = 0.0f, h = 0.0f;
+    bool contains(float px, float py) const {
+        return w > 0.0f && h > 0.0f && px >= x && px < x + w && py >= y && py < y + h;
+    }
+    TouchRect clippedTo(const TouchRect& c) const;   // the part inside c (empty when none)
+    TouchRect grownTo(float minW, float minH) const;  // at least minW x minH, about its centre
+};
+
+class TouchZones {
+public:
+    using Action = std::function<void()>;
+    using Step = std::function<bool(int dir)>;
+    using Swipe = std::function<void(int axis, int dir)>;
+    enum Axis { kAcross = 1, kUpDown = 2 };
+
+    // ---- drawing: between beginFrame and endFrame, in draw order
+    void beginFrame();
+    void tap(const TouchRect& r, Action a, Action hold = nullptr);
+    void tapMargin(const TouchRect& r, Action a);
+    void press(const TouchRect& r, Action a);
+    void pressMargin(const TouchRect& r, Action a, const TouchRect& visible = TouchRect());
+    void scroll(const TouchRect& r, int axis, float pitch, Step s, bool single = false);
+    void swipe(const TouchRect& r, Swipe s);
+    void block(const TouchRect& r, Action a = nullptr);
+    void endFrame();                                  // these zones answer touches from now on
+    void clear();                                     // no zones until the next frame registers some
+    bool any() const { return !mLive.empty(); }
+
+    // ---- input, in the same pixels
+    void setSlop(float px) { mSlop = px; }            // movement that makes a press a drag
+    void setSwipeMin(float px) { mSwipeMin = px; }    // drag length that counts as a swipe
+    void down(float x, float y, int64_t ms);
+    void move(float x, float y, int64_t ms);
+    void up(int64_t ms);
+    void cancel();                                    // the finger's gesture ends without acting
+    bool tick(float dtMs, int64_t nowMs);             // per frame: a fling, a hold; true while either needs frames
+    void stopFling() { mFling = false; }
+    bool tracking() const { return mDown; }
+    bool flinging() const { return mFling; }
+    bool takeFired(Action& a) {                       // a press button under this down: its action
+        if (!mFired) return false;
+        mFired = false; a = std::move(mFiredAct); mFiredAct = nullptr;
+        return true;
+    }
+    bool pressShown(int64_t nowMs, TouchRect& r, float& alpha) const;   // the highlight of a press
+
+private:
+    enum Kind { kTap, kScroll, kSwipe, kBlock, kPress };
+    struct Zone {
+        Kind kind = kTap;
+        bool margin = false;
+        TouchRect r, vis;                             // vis: what a press lights up (r when empty)
+        int axis = 0;
+        float pitch = 0.0f;
+        bool single = false;
+        Action act, hold;
+        Step step;
+        Swipe sw;
+    };
+    void stepTo(const Zone& z, float pos);            // steps the content to follow pos
+
+    std::vector<Zone> mBuild, mLive;
+
+    // the gesture: copies of the zones it found under the finger when it went down
+    bool mDown = false, mMoved = false, mHeld = false;
+    int64_t mDownMs = 0;
+    int mAxis = 0;
+    float mX0 = 0.0f, mY0 = 0.0f, mX = 0.0f, mY = 0.0f;
+    bool mHasPress = false, mHasScroll[3] = {false, false, false}, mHasSwipe = false;
+    Zone mPress, mScroll[3], mSwipe;
+    bool mScrolling = false;                          // the drag is moving mScroll[mAxis]
+    bool mRefused = false;                            // the content would not take a step this drag
+    int mSteps = 0;                                   // steps the drag (and its fling) has taken
+    float mLastPos = 0.0f, mVel = 0.0f;               // along the axis; px per ms
+    int64_t mLastMs = 0;
+    bool mFling = false;
+    bool mFired = false;                              // a press button was under the last down
+    Action mFiredAct;
+    TouchRect mFlashR;                                // the last press, highlighted briefly
+    int64_t mFlashMs = 0;
+    float mFlingPos = 0.0f, mFlingVel = 0.0f;
+    Zone mFlingZone;
+
+    float mSlop = 16.0f, mSwipeMin = 48.0f;
+};
+
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoTypec.cpp b/frameworks/base/cmds/gammaos-nano/NanoTypec.cpp
new file mode 100644
index 00000000000..45aa016edc3
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoTypec.cpp
@@ -0,0 +1,131 @@
+// GammaOS Nano: the USB-C port's power role, put right for an external monitor.
+//
+// The RG Cube's port is dual role, and so is a monitor's. Which of the two supplies power decides
+// which is the USB host, and only the host can start DisplayPort over the cable. When the Cube
+// supplies power it is the host, negotiates (USB PD) and the monitor's picture comes up. When the
+// monitor supplies power the Cube waits for its offer, which the monitors seen never make: after
+// two hard resets the Cube stays a powered device with no picture, plug-in after plug-in, until a
+// reboot happens to change the order.
+//
+// So when the Cube takes power from something that did not negotiate, the PD port is made
+// source-only for a moment. A dual-role partner then takes power from the Cube instead. A monitor
+// (it shows a DisplayPort alternate mode, or the picture comes up) keeps it, and the port goes back
+// to dual role; anything else that took power (a phone, a cheap power bank) is given the source role
+// back (sink-only, then dual role). A charger or a computer port cannot take power: after
+// kFlipWaitMs the port goes back to dual role and charging resumes. Once per plug-in.
+//
+// A dock is left alone: what powers the Cube and negotiated, or made the Cube the USB host, has
+// settled the roles its hub and DisplayPort need. Only the port's port_type is ever written, never
+// the USB controller's own mode in debugfs: reading or writing that file while the controller is
+// suspended panics the kernel.
+//
+// Android's USB HAL also writes dual role to a port with no partner, on every Type-C uevent; it runs
+// as system and port_type is root's, so today it cannot (its "Cannot open file to switch back to
+// drp" errors). Were it given the file, it would undo these writes at once.
+
+#define LOG_TAG "GammaOSNano"
+
+#include "NanoTypec.h"
+
+#include <cstdlib>
+
+namespace android {
+namespace typec {
+
+std::string pdPort(const std::vector<PortInfo>& ports) {
+    for (const auto& p : ports)
+        if (p.typeWritable && atof(p.pdRevision.c_str()) > 0.0) return p.name;
+    return std::string();
+}
+
+std::string current(const std::string& roleFile) {
+    const size_t a = roleFile.find('[');
+    const size_t b = a == std::string::npos ? std::string::npos : roleFile.find(']', a);
+    return b == std::string::npos ? std::string() : roleFile.substr(a + 1, b - a - 1);
+}
+
+// The time in a state ("flip:<ms>"), -1 when it is garbled.
+static int64_t since(const std::string& state, size_t prefix) {
+    const char* t = state.c_str() + prefix;
+    char* end = nullptr;
+    const long long v = strtoll(t, &end, 10);
+    return end == t || *end != 0 || v < 0 ? -1 : v;
+}
+
+Step step(const View& v, const std::string& state, int64_t nowMs, int64_t unpluggedSinceMs) {
+    Step s;
+    s.state = state;
+    const std::string tried = "tried:" + std::to_string(nowMs);
+    if (state.compare(0, 5, "flip:") == 0) {
+        const int64_t t = since(state, 5);
+        const bool taken = v.partner && v.powerRole == "source";
+        const bool late = t < 0 || nowMs < t || nowMs - t >= (v.plugged ? kFlipSinkMs : kFlipWaitMs);
+        if (v.partner && v.powerRole == "sink" && v.dataRole == "host") {
+            // Back as a powered USB host despite the source-only port: a dock that supplies power and
+            // takes the device role. It is left as it is, dual role, for the rest of the plug-in.
+            s.state = tried;
+            s.write = "dual";
+            s.log = "a dock powers the Cube; the port is dual role again";
+        } else if (taken && v.displayPort) {
+            s.state = "kept:" + std::to_string(nowMs);
+            s.write = "dual";
+            s.log = "a monitor takes power from the Cube; the port is dual role again";
+        } else if (taken && (v.pd == "no" || late)) {
+            s.state = "sink:" + std::to_string(nowMs);
+            s.write = "sink";
+            s.log = "what took power from the Cube is no monitor; giving it the source role back";
+        } else if (late) {
+            s.state = tried;
+            s.write = "dual";
+            s.log = "nothing took power from the Cube; the port is dual role again";
+        }
+        return s;
+    }
+    if (state.compare(0, 5, "sink:") == 0) {
+        const int64_t t = since(state, 5);
+        if ((v.partner && v.powerRole == "sink") || t < 0 || nowMs < t || nowMs - t >= kSinkWaitMs) {
+            s.state = tried;
+            s.write = "dual";
+            s.log = "the port is dual role again";
+        }
+        return s;
+    }
+    if (state.compare(0, 5, "kept:") == 0) {
+        // The monitor gone from the PD port once settled (unplugged, re-seated, switched off): the
+        // next plug-in is tried, however soon.
+        const int64_t t = since(state, 5);
+        if ((!v.partner && nowMs - t >= kSettleMs) || t < 0 || nowMs < t) s.state.clear();
+        return s;
+    }
+    if (state.compare(0, 6, "tried:") == 0) {
+        // Unplugged after the try has settled (not the try's own detach and re-attach): the next
+        // plug-in is tried.
+        const int64_t t = since(state, 6);
+        const int64_t settled = t + kSettleMs;
+        const int64_t from = unpluggedSinceMs > settled ? unpluggedSinceMs : settled;
+        if (!v.plugged && unpluggedSinceMs > 0 && nowMs - from >= kUnplugMs) s.state.clear();
+        if (t < 0 || nowMs < t) s.state.clear();
+        return s;
+    }
+    if (!state.empty()) s.state.clear();   // garbled: start over
+    if (v.host) {   // a computer: left alone for the whole plug-in, even while its link is down later
+        s.state = tried;
+        return s;
+    }
+    if (v.partner && v.powerRole == "sink" && (v.pd == "yes" || v.dataRole == "host")) {
+        // What powers the Cube negotiated, or made it the USB host: a charger or a dock, whose USB and
+        // DisplayPort need the roles they settled on. Left alone for the whole plug-in.
+        s.state = tried;
+        return s;
+    }
+    if (v.dpCapable && !v.hold && !v.batteryLow && v.partner && v.powerRole == "sink" && v.pd == "no" &&
+        v.portType == "dual") {
+        s.state = "flip:" + std::to_string(nowMs);
+        s.write = "source";
+        s.log = "taking power from a partner that did not negotiate; offering power instead";
+    }
+    return s;
+}
+
+}  // namespace typec
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoTypec.h b/frameworks/base/cmds/gammaos-nano/NanoTypec.h
new file mode 100644
index 00000000000..e3278617038
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoTypec.h
@@ -0,0 +1,63 @@
+// The USB-C port's power role, put right for an external monitor (NanoTypec.cpp has why).
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace android {
+namespace typec {
+
+constexpr const char* kClass = "/sys/class/typec";
+constexpr int64_t kFlipWaitMs = 5000;    // source-only with nothing attached this long: back to dual
+constexpr int64_t kFlipSinkMs = 12000;   // source-only with something attached (it may take ~7 s to settle and
+                                         // show DisplayPort): this long at most
+constexpr int64_t kSinkWaitMs = 10000;   // sink-only this long at most, giving the source role back
+constexpr int64_t kSettleMs = 2000;      // after a try, the plug re-attaching is not an unplug for this long
+constexpr int64_t kUnplugMs = 1500;      // then nothing on the plug this long is an unplug: the next plug-in is tried
+
+// A port under kClass: its name (port0), whether its port_type can be written, and its
+// usb_power_delivery_revision ("0.0", or "0" on older kernels, for a port that cannot negotiate).
+struct PortInfo {
+    std::string name;
+    bool typeWritable = false;
+    std::string pdRevision;
+};
+// The port that negotiates and whose role can be set (the RG Cube has two: the PMIC's, which sees the
+// plug, and the PD one, which this is; with the dock device tree's c2c mode the PMIC registers no port,
+// so the PD one's number changes); "" when there is none. Found by what a port can do, never by its
+// number.
+std::string pdPort(const std::vector<PortInfo>& ports);
+
+// What the ports' sysfs files say. A role file lists the choices with the current one in brackets:
+// "source [sink]", "[dual] source sink".
+struct View {
+    bool plugged = false;          // any port has a partner (the PMIC's port sees the plug at once)
+    bool partner = false;          // the PD port has a partner: it has settled with what is plugged in
+    bool displayPort = false;      // the partner has a DisplayPort alternate mode, or a DP connector is up
+    bool dpCapable = false;        // the device can show a picture over USB-C at all (else nothing is tried)
+    bool host = false;             // a computer is connected over USB: never interrupted, all plug-in long
+    bool hold = false;             // the USB mode is being applied (the gadget is down meanwhile): wait
+    bool batteryLow = false;       // a charger's power is not cut for a try
+    std::string powerRole;         // the PD port's: "source", "sink", "" when unreadable
+    std::string dataRole;          // the PD port's: "host", "device", "" when unreadable
+    std::string pd;                // its partner's supports_usb_power_delivery: "yes", "no", "" unknown
+    std::string portType;          // "dual", "source", "sink", ""
+};
+
+// The state kept between steps, in a system property so a Nano process taking over from another
+// carries on: "" nothing done for this plug-in; "flip:<ms>" source-only since then; "sink:<ms>"
+// sink-only since then (a partner that took power but is no monitor gives it back); "kept:<ms>"
+// a monitor took power then (it losing the PD port's partner is an unplug); "tried:<ms>" done for
+// this plug-in, since then.
+struct Step {
+    std::string state;
+    const char* write = nullptr;   // to write to the PD port's port_type: "source", "sink" or "dual"
+    const char* log = nullptr;     // what happened, for the log
+};
+
+std::string current(const std::string& roleFile);   // the bracketed choice, "" when none
+Step step(const View& v, const std::string& state, int64_t nowMs, int64_t unpluggedSinceMs);
+
+}  // namespace typec
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoUtf8Case.cpp b/frameworks/base/cmds/gammaos-nano/NanoUtf8Case.cpp
new file mode 100644
index 00000000000..237a90da55d
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoUtf8Case.cpp
@@ -0,0 +1,193 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "NanoUtf8Case.h"
+
+namespace android {
+
+namespace {
+
+// Ranges where the capital is the even code point and the small letter the odd one after it.
+bool evenUpperPair(uint32_t cp) {
+    return (cp >= 0x100 && cp <= 0x137 && cp != 0x130 && cp != 0x131) || (cp >= 0x14A && cp <= 0x177) ||
+           (cp >= 0x1DE && cp <= 0x1EF) || (cp >= 0x1F8 && cp <= 0x21F) ||
+           (cp >= 0x460 && cp <= 0x481) || (cp >= 0x48A && cp <= 0x4BF) || (cp >= 0x4D0 && cp <= 0x52F) ||
+           (cp >= 0x1E00 && cp <= 0x1E95) || (cp >= 0x1EA0 && cp <= 0x1EFF);
+}
+// Ranges where the capital is the odd code point and the small letter the even one after it.
+bool oddUpperPair(uint32_t cp) {
+    return (cp >= 0x139 && cp <= 0x148) || (cp >= 0x179 && cp <= 0x17E) || (cp >= 0x1CD && cp <= 0x1DC) ||
+           (cp >= 0x4C1 && cp <= 0x4CE);
+}
+
+// Decodes one character at s[i]; on a malformed sequence returns the byte itself with len 1 and
+// ok false, so it is copied through untouched.
+uint32_t decode(const std::string& s, size_t i, size_t& len, bool& ok) {
+    const unsigned char c = (unsigned char)s[i];
+    ok = true;
+    len = 1;
+    if (c < 0x80) return c;
+    int n = (c >= 0xF0 && c <= 0xF4) ? 3 : (c >= 0xE0 && c <= 0xEF) ? 2 : (c >= 0xC2 && c <= 0xDF) ? 1 : -1;
+    if (n < 0 || i + n >= s.size()) { ok = false; return c; }
+    uint32_t cp = c & (0x3F >> n);
+    for (int k = 1; k <= n; k++) {
+        const unsigned char d = (unsigned char)s[i + k];
+        if ((d & 0xC0) != 0x80) { ok = false; return c; }
+        cp = (cp << 6) | (d & 0x3F);
+    }
+    static const uint32_t kMin[4] = {0, 0x80, 0x800, 0x10000};
+    if (cp < kMin[n] || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) { ok = false; return c; }
+    len = (size_t)n + 1;
+    return cp;
+}
+
+void encode(uint32_t cp, std::string& out) {
+    if (cp < 0x80) { out += (char)cp; return; }
+    if (cp < 0x800) { out += (char)(0xC0 | (cp >> 6)); out += (char)(0x80 | (cp & 0x3F)); return; }
+    if (cp < 0x10000) {
+        out += (char)(0xE0 | (cp >> 12)); out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F));
+        return;
+    }
+    out += (char)(0xF0 | (cp >> 18)); out += (char)(0x80 | ((cp >> 12) & 0x3F));
+    out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F));
+}
+
+enum Mode { kUpper, kLower, kCapitalize };
+
+bool isLetter(uint32_t cp) {
+    if (cp < 0x80) return (cp | 0x20) >= 'a' && (cp | 0x20) <= 'z';
+    return cp >= 0xC0 && cp != 0xD7 && cp != 0xF7 && !(cp >= 0x2000 && cp <= 0x2BFF) && !(cp >= 0x3000 && cp <= 0x303F);
+}
+
+// A capital letter starting a word keeps its tonos (Άλφα).
+uint32_t capitalKeepTonos(uint32_t cp) {
+    switch (cp) {
+        case 0x3AC: return 0x386;
+        case 0x3AD: return 0x388;
+        case 0x3AE: return 0x389;
+        case 0x3AF: return 0x38A;
+        case 0x3CC: return 0x38C;
+        case 0x3CD: return 0x38E;
+        case 0x3CE: return 0x38F;
+    }
+    return nanoToUpperCp(cp);
+}
+
+// Greek capitals lose their tonos when a whole string is upper-cased (as Greek is written).
+uint32_t upperNoTonos(uint32_t cp) {
+    switch (cp) {
+        case 0x390: return 0x3AA;   // ΐ -> Ϊ
+        case 0x3B0: return 0x3AB;   // ΰ -> Ϋ
+        case 0x386: return 0x391;
+        case 0x388: return 0x395;
+        case 0x389: return 0x397;
+        case 0x38A: return 0x399;
+        case 0x38C: return 0x39F;
+        case 0x38E: return 0x3A5;
+        case 0x38F: return 0x3A9;
+    }
+    return cp;
+}
+
+std::string convert(const std::string& s, Mode mode) {
+    std::string out;
+    out.reserve(s.size());
+    bool wordStart = true, prevLetter = false;
+    for (size_t i = 0; i < s.size();) {
+        size_t len;
+        bool ok;
+        const uint32_t cp = decode(s, i, len, ok);
+        if (!ok) { out += s[i]; i += 1; wordStart = false; prevLetter = false; continue; }
+        const bool space = cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r' || cp == '\f' || cp == '\v';
+        const bool up = mode == kUpper || (mode == kCapitalize && wordStart);
+        if (up && cp == 0xDF) out += mode == kUpper ? "SS" : "Ss";
+        else if (up) encode(mode == kUpper ? upperNoTonos(nanoToUpperCp(cp)) : capitalKeepTonos(cp), out);
+        else if (cp == 0x3A3 && prevLetter) {   // sigma ending a word is written ς
+            size_t nlen;
+            bool nok;
+            const bool nextLetter = i + len < s.size() && isLetter(decode(s, i + len, nlen, nok)) && nok;
+            encode(nextLetter ? 0x3C3 : 0x3C2, out);
+        } else encode(nanoToLowerCp(cp), out);
+        wordStart = space;
+        prevLetter = isLetter(cp);
+        i += len;
+    }
+    return out;
+}
+
+}  // namespace
+
+uint32_t nanoToUpperCp(uint32_t cp) {
+    if (cp < 0x80) return (cp >= 'a' && cp <= 'z') ? cp - 32 : cp;
+    if (cp >= 0xE0 && cp <= 0xFE && cp != 0xF7) return cp - 0x20;
+    if (cp == 0xFF) return 0x178;
+    if (cp == 0x131) return 'I';
+    if (cp == 0x17F) return 'S';
+    if (cp == 0x1A1 || cp == 0x1B0) return cp - 1;   // Vietnamese ơ ư
+    if (evenUpperPair(cp)) return (cp & 1) ? cp - 1 : cp;
+    if (oddUpperPair(cp)) return (cp & 1) ? cp : cp - 1;
+    switch (cp) {   // Greek with tonos: capitals drop it, as Greek all-caps text does
+        case 0x3AC: return 0x391;
+        case 0x3AD: return 0x395;
+        case 0x3AE: return 0x397;
+        case 0x3AF: return 0x399;
+        case 0x3CC: return 0x39F;
+        case 0x3CD: return 0x3A5;
+        case 0x3CE: return 0x3A9;
+        case 0x3CA: return 0x3AA;
+        case 0x3CB: return 0x3AB;
+        case 0x3C2: return 0x3A3;   // final sigma
+    }
+    if (cp >= 0x3B1 && cp <= 0x3C9) return cp - 0x20;
+    if (cp >= 0x430 && cp <= 0x44F) return cp - 0x20;
+    if (cp >= 0x450 && cp <= 0x45F) return cp - 0x50;
+    if (cp >= 0x561 && cp <= 0x586) return cp - 0x30;
+    if (cp >= 0xFF41 && cp <= 0xFF5A) return cp - 0x20;
+    return cp;
+}
+
+uint32_t nanoToLowerCp(uint32_t cp) {
+    if (cp < 0x80) return (cp >= 'A' && cp <= 'Z') ? cp + 32 : cp;
+    if (cp >= 0xC0 && cp <= 0xDE && cp != 0xD7) return cp + 0x20;
+    if (cp == 0x178) return 0xFF;
+    if (cp == 0x130) return 'i';
+    if (cp == 0x1A0 || cp == 0x1AF) return cp + 1;
+    if (evenUpperPair(cp)) return (cp & 1) ? cp : cp + 1;
+    if (oddUpperPair(cp)) return (cp & 1) ? cp + 1 : cp;
+    switch (cp) {
+        case 0x386: return 0x3AC;
+        case 0x388: return 0x3AD;
+        case 0x389: return 0x3AE;
+        case 0x38A: return 0x3AF;
+        case 0x38C: return 0x3CC;
+        case 0x38E: return 0x3CD;
+        case 0x38F: return 0x3CE;
+        case 0x3AA: return 0x3CA;
+        case 0x3AB: return 0x3CB;
+    }
+    if (cp >= 0x391 && cp <= 0x3A9 && cp != 0x3A2) return cp + 0x20;
+    if (cp >= 0x410 && cp <= 0x42F) return cp + 0x20;
+    if (cp >= 0x400 && cp <= 0x40F) return cp + 0x50;
+    if (cp >= 0x531 && cp <= 0x556) return cp + 0x30;
+    if (cp >= 0xFF21 && cp <= 0xFF3A) return cp + 0x20;
+    return cp;
+}
+
+std::string nanoUtf8Upper(const std::string& s) { return convert(s, kUpper); }
+std::string nanoUtf8Lower(const std::string& s) { return convert(s, kLower); }
+std::string nanoUtf8Capitalize(const std::string& s) { return convert(s, kCapitalize); }
+
+}  // namespace android
