+// Work in flight whose result is picked up by a tick inside render(): a copy, scrape or move job,
+// a File Explorer operation, a folder listing, the ES-DE bulk add or theme download, the BIOS
+// installer, the setup's background deletion, the video auto-thumbnails, and the screens that poll
+// while open (Network Shares, Syncthing, App Information).
+bool NanoMenu::frameTicksPending() {
+    { std::lock_guard<std::mutex> lk(mScrapeMutex); if (mScrapeRunning) return true; }
+    if (mFeOp || mBulkAddScanning.load() || mEsdeDlFetching.load() || mEsdeDlInstalling.load() || biosWorkerBusy()
+        || sdAutoDeleting()) return true;
+    if ((mVidThumbState != VT_IDLE || mVidThumbQIdx < mVidThumbQueue.size()) && !videoThumbContended()) return true;
+    { std::lock_guard<std::mutex> lk(mFbLock); if (!mFbPending.empty()) return true; }
+    if (stScreenOpen()) return true;
+    if (!mPs3Stack.empty() && mPs3Stack.back().screenKind == EXT_DISPLAY) return true;   // externalDisplayTick
+    if (mMonModeCall != MMC_NONE || mMonTrialOpen || mMonModeRevertDue) return true;     // monitorModeTick
+    for (const auto& l : mPs3Stack)
+        if (l.screenKind == NS_LIST || l.screenKind == NS_EDITOR || l.screenKind == APP_INFO
+            || l.screenKind == APP_STORAGE || l.screenKind == APP_PERMS) return true;
+    return false;
+}
