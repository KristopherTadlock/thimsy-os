+}
+
+// The open External Display list follows a change made elsewhere (the Quick Settings tile, the
+// Quick Menu's copy of the list, restored as it was), a monitor plugged in or out, its mode and a
+// game starting or ending: rebuilt within half a second, the cursor kept on its row. Also runs the
+// monitor mode calls and dialog (monitorModeTick), whatever is open.
+void NanoMenu::externalDisplayTick() {
+    monitorModeTick();
+    if (mPs3Stack.empty() || mPs3Stack.back().screenKind != EXT_DISPLAY) return;
+    const long now = (long)android::uptimeMillis();
+    if (now - mExtDisplayCheckMs < 500) return;
+    mExtDisplayCheckMs = now;
+    if (externalDisplayMode() + "|" + monitorModeSig() == mExtDisplaySig) return;
+    Ps3Level& lvl = mPs3Stack.back();
+    const int keep = lvl.sel;
+    // The row under the cursor, by what it does: rows come and go with the monitor.
+    std::string keepPayload;
+    int keepA = -1, keepB = -1;
+    if (keep >= 0 && keep < (int)lvl.items.size()) {
+        keepPayload = lvl.items[keep].payloadStr;
+        keepA = lvl.items[keep].kind == PS3_QUICK ? lvl.items[keep].a : -1;
+        keepB = lvl.items[keep].b;
+    }
+    buildExternalDisplaySubmenu(lvl);
+    lvl.sel = std::min(keep, (int)lvl.items.size() - 1);
+    for (int i = 0; i < (int)lvl.items.size(); i++) {
+        const Ps3Item& it = lvl.items[i];
+        const bool same = keepA == QA_EXT_DISPLAY_PICK ? it.kind == PS3_QUICK && it.payloadStr == keepPayload
+                        : keepA >= 0 ? it.kind == PS3_QUICK && it.a == keepA && it.b == keepB
+                                     : it.kind != PS3_QUICK;   // Controller Screen
+        if (same) { lvl.sel = i; break; }
+    }
+    if (lvl.sel < 0) lvl.sel = 0;
+    mDisplayDirty = true;
+}
