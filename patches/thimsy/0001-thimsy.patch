diff --git a/frameworks/base/cmds/gammaos-nano/NanoMenuHakux.cpp b/frameworks/base/cmds/gammaos-nano/NanoMenuHakux.cpp
new file mode 100644
index 00000000000..db5a023c14a
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoMenuHakux.cpp
@@ -0,0 +1,145 @@
+/*
