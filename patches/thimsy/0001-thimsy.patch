+// Thimsy 4:3 Cropped and 8:7 Cropped: samples a layer's buffer through its projection
+// (gammaCropProjection) with a sharp bilinear kernel, directly while the layer is drawn.
+struct ThimsySurfaceScaler {
+    struct Result {
+        // Expects logical display coordinates as its local coordinates.
+        sk_sp<SkShader> shader;
+        // The visible picture in logical display coordinates.
+        SkRect dstRect;
+    };
+
+    // layerToTexel maps coordinates relative to the layer bounds' top-left corner to image
+    // texels, as the regular layer draw does. None when the picture is drawn unmodified.
+    static std::optional<Result> make(const sk_sp<SkImage>& image, const SkMatrix& layerToTexel,
+                                      SkSize layerSize, const SkRect& displayClip,
+                                      GammaCrop crop);
+
+    // A mirroring monitor's copy of the panel's frame (LayerSettings::thimsySharpBilinear): the
+    // whole buffer, with the same kernel at the scale layerToDevice gives it. layerToTexel maps the
+    // layer's own coordinates (its local coordinates) to texels. Null when it can't be built.
+    static sk_sp<SkShader> makeSharp(const sk_sp<SkImage>& image, const SkMatrix& layerToTexel,
+                                     const SkMatrix& layerToDevice);
+};
+
