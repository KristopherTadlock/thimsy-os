+    if (push && card != mine) {
+        const std::string tmp = path + ".nanotmp";
+        mkdir((esdeDataDir() + "/nano").c_str(), 0775);
+        FILE* f = fopen(tmp.c_str(), "we");
+        const bool ok = f && fwrite(mine.data(), 1, mine.size(), f) == mine.size() && fflush(f) == 0 && fsync(fileno(f)) == 0;
+        if (f) fclose(f);
