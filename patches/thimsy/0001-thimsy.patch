+package com.android.server.display;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.function.Function;
+
+/**
+ * GammaOS: the screens with a monitor (HDMI or DisplayPort), in the mode
+ * persist.gammaos.display.mode chooses. Docked (the default): the monitor is display 0 and drives the
+ * system; the internal panels (and any other monitor) are in the default layout disabled, so they
+ * are switched off and apps don't see them. Dual screen: the monitor is display 0 and the panels stay
+ * on as secondary displays, each screen at its own native mode. Mirror: the panel stays display 0
+ * and the monitors are in the layout disabled, so apps see one display; DisplayManagerService shows
+ * display 0 on them, scaled to fit (SurfaceFlinger scales the panel's frame, sharp bilinear). Once no
+ * monitor is left, the panel that was display 0 is display 0 again. A monitor runs at Auto, its
+ * stored mode or a trial (monitorMode; DisplayManagerService keeps the choices, LocalDisplayAdapter
+ * holds the mode). LogicalDisplayMapper applies the plan; this holds only the decisions, with no
+ * Android dependencies, so
+ * cmds/gammaos-nano/test/java/GammaosScreenArrangementCheck.java runs it on the build host. A is a
+ * display address.
+ */
+final class GammaosScreenArrangement {
+    private GammaosScreenArrangement() {}
+
+    /** What a monitor does while connected (MODE_PROP). */
+    enum Mode { DOCKED, DUAL, MIRROR }
+
+    /** The default layout to build. */
+    static final class Plan<A> {
+        /** Display 0. */
+        final A display0;
+        /** In the layout, disabled. */
+        final List<A> off;
+        /** In the layout, enabled: the other panels, switched back on once no monitor is left. */
+        final List<A> on;
+        /** The panel to give display 0 back to once no monitor is left; null when there is none. */
+        final A panel;
+        /** The monitors (among off) that show display 0: all of them in mirror mode. */
+        final List<A> mirrored;
+
+        Plan(A display0, List<A> off, List<A> on, A panel, List<A> mirrored) {
+            this.display0 = display0;
+            this.off = off;
+            this.on = on;
+            this.panel = panel;
+            this.mirrored = mirrored;
+        }
+    }
+
+    /**
+     * The layout for the displays there now, or null to leave the default layout as it is (no
+     * monitor is or was involved).
+     *
+     * @param current the display at display 0 in the layout now, null if none
+     * @param panels the internal panels, in the order the devices came
+     * @param monitors the monitors, in the order the devices came
+     * @param panel the panel that was display 0 before a monitor took it (or, in mirror mode, the
+     *     panel kept as display 0), null while none did
+     * @param mode what the monitor does
+     */
+    static <A> Plan<A> plan(A current, List<A> panels, List<A> monitors, A panel, Mode mode) {
+        if (monitors.isEmpty()) {
+            if (panel == null) return null;
+            final List<A> on = new ArrayList<>(panels);
+            on.remove(panel);
+            return new Plan<>(panel, new ArrayList<>(), on, null, new ArrayList<>());
+        }
+        A keep = panel;
+        if (keep == null) {
+            keep = current != null && panels.contains(current) ? current
+                    : (panels.isEmpty() ? null : panels.get(0));
+        }
+        if (mode == Mode.MIRROR && keep != null) {
+            final List<A> on = new ArrayList<>(panels);
+            on.remove(keep);
+            return new Plan<>(keep, new ArrayList<>(monitors), on, keep,
+                    new ArrayList<>(monitors));
+        }
+        // The monitor that has display 0 keeps it.
+        final boolean dual = mode == Mode.DUAL;
+        final A monitor = current != null && monitors.contains(current) ? current : monitors.get(0);
+        final List<A> off = new ArrayList<>(dual ? new ArrayList<A>() : panels);
+        for (A m : monitors) {
+            if (!m.equals(monitor)) off.add(m);
+        }
+        return new Plan<>(monitor, off, dual ? new ArrayList<>(panels) : new ArrayList<>(), keep,
+                new ArrayList<>());
+    }
+
+    /**
+     * Whether the layout is already the plan: display 0 is the plan's, every display the plan
+     * switches off is in the layout disabled, every one it switches on is in it enabled, and the
+     * layout holds nothing else.
+     *
+     * @param layoutSize the number of displays in the layout
+     * @param enabled whether a display is in the layout enabled: true, disabled: false, else null
+     */
+    static <A> boolean arranged(Plan<A> plan, A current, int layoutSize,
+            Function<A, Boolean> enabled) {
+        if (!plan.display0.equals(current)
+                || layoutSize != 1 + plan.off.size() + plan.on.size()) {
+            return false;
+        }
+        for (A a : plan.off) {
+            if (!Boolean.FALSE.equals(enabled.apply(a))) return false;
+        }
+        for (A a : plan.on) {
+            if (!Boolean.TRUE.equals(enabled.apply(a))) return false;
+        }
+        return true;
+    }
+
+    /**
+     * Whether a display the composer calls external is a monitor. When the composer doesn't say,
+     * every display but the first is called external, a second built-in panel included; a
+     * monitor's EDID names it, so on a device with two panels only a display with one counts.
+     */
+    static boolean externalIsMonitor(boolean hasProductInfo, boolean twoPanels) {
+        return hasProductInfo || !twoPanels;
+    }
+
+    /**
+     * Set by a build whose SurfaceFlinger composes a monitor at 3840 wide into one client layer.
+     * Without it the vendor composer drops every layer that isn't 3840 wide at that width (the
+     * Keep/Revert dialog included), so no 3840-wide mode is listed.
+     */
+    static final String UHD_PROP = "ro.gammaos.display.uhd";
+
+    /**
+     * The mode a monitor is held at and why, for Nano: WxH@HZ;trial, ;user (its stored mode) or
+     * ;auto, empty with no monitor (monitorModeProp).
+     */
+    static final String MONITOR_MODE_PROP = "sys.gammaos.display.monitor_mode";
+
+    /** The stored monitor modes (MonitorModes), in /data/system. */
+    static final String MODES_FILE = "gammaos_monitor_modes.txt";
+
+    /** How long a trial runs before it is reverted, unless kept. */
+    static final long TRIAL_MS = 15000;
+
+    /** How long a trial's mode has to become active before it is reverted at once. */
+    static final long VERIFY_MS = 3000;
+
+    /** How long a stored mode has to stay active before its applying marker is cleared. */
+    static final long APPLYING_MS = 20000;
+
+    /** In Dual Screen no mode below this is offered: the monitor paces the panel's frames. */
+    static final float MIN_DUAL_HZ = 50f;
+
+    static final String WHY_TRIAL = "trial";
+    static final String WHY_USER = "user";
+    static final String WHY_AUTO = "auto";
+
+    /** A monitor mode as the user picks it (cmd display gammaos-monitor-mode): size and rate. */
+    static final class MonitorMode {
+        final int width;
+        final int height;
+        final float hz;
+
+        MonitorMode(int width, int height, float hz) {
+            this.width = width;
+            this.height = height;
+            this.hz = hz;
+        }
+
+        /**
+         * The mode the three numbers of "try W H HZ" name, or null when one isn't a number or is
+         * out of range.
+         */
+        static MonitorMode of(String width, String height, String hz) {
+            try {
+                final int w = Integer.parseInt(width);
+                final int h = Integer.parseInt(height);
+                final float r = Float.parseFloat(hz);
+                if (w < 1 || w > 16384 || h < 1 || h > 16384 || !(r >= 1f && r <= 1000f)) {
+                    return null;
+                }
+                return new MonitorMode(w, h, r);
+            } catch (NumberFormatException | NullPointerException e) {
+                return null;
+            }
+        }
+
+        /** The mode a toString value names, or null for any other value. */
+        static MonitorMode parse(String value) {
+            if (value == null) return null;
+            final int x = value.indexOf('x');
+            final int at = value.indexOf('@');
+            if (x <= 0 || at <= x + 1) return null;
+            return of(value.substring(0, x), value.substring(x + 1, at), value.substring(at + 1));
+        }
+
+        /**
+         * Whether a listed mode is this one: the same size, and a rate within 0.5 Hz (DisplayPort
+         * modes report whole-number rates, so 59.94 Hz reads 60).
+         */
+        boolean matches(int w, int h, float r) {
+            return w == width && h == height && Math.abs(r - hz) < 0.5f;
+        }
+
+        /** WxH@HZ, the rate as a whole number when it is one, else to 0.01 Hz. */
+        @Override
+        public String toString() {
+            final int whole = Math.round(hz);
+            String rate = Integer.toString(whole);
+            if (Math.abs(hz - whole) >= 0.005f) {
+                rate = String.format(Locale.ROOT, "%.2f", hz);
+                if (rate.endsWith("0")) rate = rate.substring(0, rate.length() - 1);
+            }
+            return width + "x" + height + "@" + rate;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (!(o instanceof MonitorMode)) return false;
+            final MonitorMode m = (MonitorMode) o;
+            return m.width == width && m.height == height
+                    && Float.floatToIntBits(m.hz) == Float.floatToIntBits(hz);
+        }
+
+        @Override
+        public int hashCode() {
+            return (width * 31 + height) * 31 + Float.floatToIntBits(hz);
+        }
+    }
+
+    /**
+     * Whether a monitor mode is listed at all; LocalDisplayAdapter leaves the others out of the
+     * monitor's modes, so no app, frame rate vote or cmd can pick one. Not: wider than 3840 (DCI
+     * 4096, rejected by the kernel too), smaller than 640x480 (720x400 too), or 3840 wide in a
+     * build without UHD_PROP.
+     */
+    static boolean listed(int width, int height, boolean uhd) {
+        if (width > 3840 || width < 640 || height < 480) return false;
+        return uhd || width < 3840;
+    }
+
+    /** Whether a mode can be chosen now: listed, and in Dual Screen at least MIN_DUAL_HZ. */
+    static boolean offered(int width, int height, float hz, boolean dual, boolean uhd) {
+        return listed(width, height, uhd) && (!dual || hz >= MIN_DUAL_HZ - 0.5f);
+    }
+
+    /** The index of the listed mode that is m (the nearest rate), or -1. */
+    static int find(int[] widths, int[] heights, float[] rates, MonitorMode m) {
+        int best = -1;
+        if (m == null) return best;
+        for (int i = 0; i < widths.length; i++) {
+            if (!m.matches(widths[i], heights[i], rates[i])) continue;
+            if (best < 0 || Math.abs(rates[i] - m.hz) < Math.abs(rates[best] - m.hz)) best = i;
+        }
+        return best;
+    }
+
+    /**
+     * Auto: the mode a monitor runs at unless the user chose one, as an index into its modes, -1
+     * only with none. 1080p nearest 60 Hz (within 1 Hz), the mode the DisplayPort driver makes
+     * preferred; else the largest offered mode at 50-61 Hz (the nearer 60 Hz on a tie); else
+     * the mode the composer set at connect, if offered; else the first offered mode; else the
+     * one at connect, or the first.
+     *
+     * @param atConnect the index of the mode the composer set at connect, -1 if unknown
+     */
+    static int autoMode(int[] widths, int[] heights, float[] rates, int atConnect, boolean dual,
+            boolean uhd) {
+        int best = -1;
+        for (int i = 0; i < widths.length; i++) {
+            if (widths[i] != 1920 || heights[i] != 1080) continue;
+            final float off = Math.abs(rates[i] - 60f);
+            if (off <= 1f && (best < 0 || off < Math.abs(rates[best] - 60f))) best = i;
+        }
+        if (best >= 0) return best;
+        for (int i = 0; i < widths.length; i++) {
+            if (rates[i] < 49.5f || rates[i] > 61.5f
+                    || !offered(widths[i], heights[i], rates[i], dual, uhd)) {
+                continue;
+            }
+            final long area = (long) widths[i] * heights[i];
+            final long bestArea = best < 0 ? -1 : (long) widths[best] * heights[best];
+            if (area > bestArea || (area == bestArea
+                    && Math.abs(rates[i] - 60f) < Math.abs(rates[best] - 60f))) {
+                best = i;
+            }
+        }
+        if (best >= 0) return best;
+        final boolean known = atConnect >= 0 && atConnect < widths.length;
+        if (known && offered(widths[atConnect], heights[atConnect], rates[atConnect], dual, uhd)) {
+            return atConnect;
+        }
+        for (int i = 0; i < widths.length; i++) {
+            if (offered(widths[i], heights[i], rates[i], dual, uhd)) return i;
+        }
+        if (known) return atConnect;
+        return widths.length > 0 ? 0 : -1;
+    }
+
+    /** The mode a monitor is held at, as an index into its modes, and why (WHY_*). */
+    static final class Choice {
+        final int index;
+        final String why;
+
+        Choice(int index, String why) {
+            this.index = index;
+            this.why = why;
+        }
+    }
+
+    /**
+     * The mode a monitor is held at, so frame rate votes and apps can't move it to another of its
+     * modes; everything above the display follows whatever mode it has. A running trial if it is
+     * still offered; else the monitor's stored mode if it is still listed and offered (a dock
+     * that trains fewer lanes no longer lists it; in Dual Screen one below MIN_DUAL_HZ isn't
+     * offered, and stays stored for Docked and Mirror); else Auto (autoMode). The index is -1
+     * only for a monitor with no modes.
+     *
+     * @param trial the trial running on this monitor, null if none
+     * @param stored the mode stored for this monitor, null if none
+     */
+    static Choice monitorMode(int[] widths, int[] heights, float[] rates, int atConnect,
+            MonitorMode trial, MonitorMode stored, boolean dual, boolean uhd) {
+        if (trial != null && offered(trial.width, trial.height, trial.hz, dual, uhd)) {
+            final int i = find(widths, heights, rates, trial);
+            if (i >= 0) return new Choice(i, WHY_TRIAL);
+        }
+        if (stored != null && offered(stored.width, stored.height, stored.hz, dual, uhd)) {
+            final int i = find(widths, heights, rates, stored);
+            if (i >= 0) return new Choice(i, WHY_USER);
+        }
+        return new Choice(autoMode(widths, heights, rates, atConnect, dual, uhd), WHY_AUTO);
+    }
+
+    /**
+     * Why "try" refuses a mode, or null to run it: system_server checks it, since cmd is an entry
+     * point of its own beside Nano's menu.
+     */
+    static String tryRefusal(int[] widths, int[] heights, float[] rates, MonitorMode m,
+            boolean dual, boolean uhd) {
+        if (m.width > 3840) return "wider than 3840";
+        if (m.width < 640 || m.height < 480) return "smaller than 640x480";
+        if (!listed(m.width, m.height, uhd)) {
+            return "3840 wide needs a build that composes it into one layer (" + UHD_PROP + ")";
+        }
+        if (!offered(m.width, m.height, m.hz, dual, uhd)) {
+            return "below " + Math.round(MIN_DUAL_HZ) + " Hz in Dual Screen";
+        }
+        if (find(widths, heights, rates, m) < 0) return "not one of the monitor's modes";
+        return null;
+    }
+
+    /** The offered modes, largest first, then the higher rate first: what "list" shows. */
+    static int[] listOrder(int[] widths, int[] heights, float[] rates, boolean dual, boolean uhd) {
+        final List<Integer> order = new ArrayList<>();
+        for (int i = 0; i < widths.length; i++) {
+            if (offered(widths[i], heights[i], rates[i], dual, uhd)) order.add(i);
+        }
+        order.sort((a, b) -> {
+            final int area = Long.compare((long) widths[b] * heights[b],
+                    (long) widths[a] * heights[a]);
+            if (area != 0) return area;
+            if (widths[a] != widths[b]) return Integer.compare(widths[b], widths[a]);
+            return Float.compare(rates[b], rates[a]);
+        });
+        final int[] out = new int[order.size()];
+        for (int i = 0; i < out.length; i++) out[i] = order.get(i);
+        return out;
+    }
+
+    /** MONITOR_MODE_PROP's value: the held mode and why, or empty with no monitor. */
+    static String monitorModeProp(MonitorMode held, String why) {
+        return held == null ? "" : held + ";" + why;
+    }
+
+    /**
+     * The key a monitor's stored mode is kept under: a hash of its EDID's PnP id, product id,
+     * model year and name (DeviceProductInfo), the same for every monitor of one model. Not the
+     * display's uniqueId: the composer may derive that from the port, and then one stored mode
+     * would apply to every monitor. Null without a PnP id and product id: such a monitor's mode is
+     * kept only until it is unplugged, never stored.
+     */
+    static String monitorKey(String pnpId, String productId, int modelYear, String name) {
+        if ((pnpId == null || pnpId.isEmpty()) && (productId == null || productId.isEmpty())) {
+            return null;
+        }
+        final String id = pnpId + "\n" + productId + "\n" + modelYear + "\n" + name;
+        final byte[] digest;
+        try {
+            digest = MessageDigest.getInstance("SHA-256").digest(
+                    id.getBytes(StandardCharsets.UTF_8));
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+        final StringBuilder key = new StringBuilder();
+        for (int i = 0; i < 8; i++) {
+            key.append(String.format(Locale.ROOT, "%02x", digest[i] & 0xff));
+        }
+        return key.toString();
+    }
+
+    /**
+     * The stored monitor modes by monitorKey (MODES_FILE), and the monitors whose stored mode is
+     * being applied. Applying a stored mode at connect writes the monitor's marker first and
+     * clears it once the mode has been active for APPLYING_MS (Applying), or when the monitor is
+     * unplugged before then (system_server saw it go, so nothing panicked or hung). A marker still
+     * there at the next connect (or after a reboot) means the mode panicked or hung the system,
+     * or the framework restarted, before then: the monitor comes up at Auto and its stored mode
+     * is dropped.
+     */
+    static final class MonitorModes {
+        final TreeMap<String, MonitorMode> modes = new TreeMap<>();
+        final TreeSet<String> applying = new TreeSet<>();
+
+        /** The store a format() text holds; lines it doesn't know are skipped. */
+        static MonitorModes parse(String text) {
+            final MonitorModes store = new MonitorModes();
+            if (text == null) return store;
+            for (String line : text.split("\n")) {
+                final String[] f = line.trim().split(" +");
+                if (f.length == 3 && f[0].equals("mode") && isKey(f[1])) {
+                    final MonitorMode m = MonitorMode.parse(f[2]);
+                    if (m != null) store.modes.put(f[1], m);
+                } else if (f.length == 2 && f[0].equals("applying") && isKey(f[1])) {
+                    store.applying.add(f[1]);
+                }
+            }
+            return store;
+        }
+
+        /** One "mode KEY WxH@HZ" line per stored mode, then one "applying KEY" per marker. */
+        String format() {
+            final StringBuilder text = new StringBuilder();
+            for (Map.Entry<String, MonitorMode> e : modes.entrySet()) {
+                text.append("mode ").append(e.getKey()).append(' ').append(e.getValue())
+                        .append('\n');
+            }
