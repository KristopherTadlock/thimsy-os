+
+# Thimsy OS: apps kept out of the image. AOSP and LineageOS product makefiles list them; overriding
+# them here drops them, and anything only they `required`, from the install list. None of the
+# supported handhelds has a camera, modem/SIM or NFC; GammaOS's updater and the extra gallery,
+# browser, screensavers, Easter egg and print service are not wanted either.
+include $(CLEAR_VARS)
+LOCAL_MODULE := thimsy-removed-apps
+LOCAL_OVERRIDES_MODULES := \
+	Updater \
+	Aperture \
+	ApertureLensLauncher \
+	CameraExtensionsProxy \
+	Stk \
+	messaging \
+	EmergencyInfo \
+	NfcNci \
