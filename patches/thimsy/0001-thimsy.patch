+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.wm;
+
+/**
+ * The retroarch.cfg GammaOS Nano's home-screen RetroArch launches pass: the same rule as Nano's
+ * own launches (cmds/gammaos-nano/NanoRaConfig.h raVolumeRoot, raMountListed, raLaunchConfig).
+ * Plain Java so the shared cases in cmds/gammaos-nano/test/fixtures/retroarch run against it on
+ * the host (cmds/gammaos-nano/test/java/NanoRetroArchConfigCheck.java).
+ */
+final class NanoRetroArchConfig {
+    static final String DIR_PROP = "persist.gammaos.retroarch.dir";
+    /** The folder whose retroarch.cfg Nano last found there as root, "" when none. */
+    static final String CFG_DIR_PROP = "sys.gammaos.retroarch.cfg_dir";
+    static final String DEFAULT_CONFIG =
+            "/storage/emulated/0/Android/data/com.retroarch.aarch64/files/retroarch.cfg";
+
+    private NanoRetroArchConfig() {}
+
+    /** The folder's mount point as apps see it, "" when it is not under /storage. */
+    static String volumeRoot(String dir) {
+        final String storage = "/storage/";
+        if (!dir.startsWith(storage)) return "";
+        final int end = dir.indexOf('/', storage.length());
+        final String vol = end < 0 ? dir.substring(storage.length())
+                : dir.substring(storage.length(), end);
+        if (vol.isEmpty()) return "";
+        return storage + (vol.equals("self") ? "emulated" : vol);
+    }
+
+    /** Whether a /proc/self/mounts listing has a mount at exactly {@code root}. */
+    static boolean mountListed(String mounts, String root) {
+        if (root.isEmpty()) return false;
+        for (String line : mounts.split("\n")) {
+            final int a = line.indexOf(' ');
+            if (a < 0) continue;
+            int b = line.indexOf(' ', a + 1);
+            if (b < 0) b = line.length();
+            if (line.substring(a + 1, b).equals(root)) return true;
+        }
+        return false;
+    }
+
+    static String launchConfig(String dir, boolean volumeMounted, boolean cfgThere) {
+        if (dir.startsWith("/") && volumeMounted && cfgThere) return dir + "/retroarch.cfg";
+        return DEFAULT_CONFIG;
+    }
+
+    /**
+     * From the two properties and this process's mount table. Nothing on the card is touched:
+     * system_server cannot read its raw folder, and a FUSE call can block while storage mounts.
+     */
+    static String choose(String dir, String verifiedDir, String mounts) {
+        final String root = volumeRoot(dir);
+        final boolean mounted = root.isEmpty() || mountListed(mounts, root);
+        return launchConfig(dir, mounted, !dir.isEmpty() && dir.equals(verifiedDir));
+    }
+}
