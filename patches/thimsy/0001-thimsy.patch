+    if (!mPs3MenuBuilt) initPs3Menu();
+    int quickIdx = (mPs3QuickCatIdx >= 0) ? mPs3QuickCatIdx : 0;
+    if (quickIdx < 0 || quickIdx >= (int)mPs3Cats.size()) return;
+    // Leaving the ES-DE menu (or a screen opened from it): the Quick Menu returns to the game list.
+    if (esdeMenuInContext()) {
+        mEsdeMenuReturn = false;
+        mPs3Stack.clear();
+        mEsdeMenuActive = false; mEsdeMenuClosing = false; mEsdeMenuAnim = 0.0f;
+    }
+    // The Wi-Fi / Bluetooth screens are not stack levels: close them (stopping their scans) rather
+    // than leave them running behind the Quick Menu.
+    if (mMenuState == MENU_WIFI) closeWifiScreen();
+    else if (mMenuState == MENU_BT) closeBtScreen();
+    mQsReturn.valid = true;
+    mQsReturn.stack = mPs3Stack;
+    mQsReturn.cat = mPs3CatIdx; mQsReturn.item = mPs3ItemIdx;
+    mQsReturn.atRoot = mNdsAtRoot; mQsReturn.camera = mNdsCamera;
+    mPs3Stack.clear();
+    mPs3DlgActive = false; mPs3OptActive = false; mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    mPs3CatIdx  = quickIdx;
+    mPs3ItemIdx = 0;
+    mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+    mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f; mPs3SubAnimStart = -1.0f;
+    mPs3CatAnimActive = false; mPs3CatT = 1.0f; mPs3CatFromOffset = 0.0f;
+    mNdsAtRoot = false;
+    if (mEsdeTheme || mEsdeSettingsMinima) {
+        Ps3Level lvl; lvl.title = mPs3Cats[quickIdx].name; lvl.items = mPs3Cats[quickIdx].items;
+        mPs3Stack.push_back(lvl);
+    }
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
+
+// Anbernic + Start: the Applications view from any home state. Dialogs, option menus, choosers, the
+// global search, the ES-DE menu and overlays and the Wi-Fi / Bluetooth screens close; the setup,
+// the keyboard and the media players keep it from opening.
+void NanoMenu::openApplicationsView() {
+    if (mSetupWizardActive || mPs3WizActive || mPs3TzActive || mPs3LangActive || mOskActive
+        || mVidActive || mMpActive || mPvActive || mPhotoMultiActive || mScrapeProgActive
+        || ps3TopScreenKind() == PHOTO_GRID || mPspClockOn || mPspClockReveal > 0.0f) return;
+    mAppsSummoned = false;   // opened here; overlayShow sets it again when it raised the overlay for it
+    if (mPs3OptActive) closeXmbOpt();
+    if (mPs3DlgActive) closePs3Dialog(false);
+    if (mPs3DlgActive || mPs3OptActive) return;   // a dialog that must stay up
+    if (mGSearchActive) gsearchClose();
+    if (mMpPlChooserActive) mpPlChooserCancel();
+    if (mPvPlChooserActive) pvPlChooserCancel();
+    if (mVidPlChooserActive) vidPlChooserCancel();
+    esdeOverlayCloseAll();
+    if (esdeMenuInContext()) {
+        mEsdeMenuReturn = false;
+        mPs3Stack.clear();
+        mEsdeMenuActive = false; mEsdeMenuClosing = false; mEsdeMenuAnim = 0.0f;
+    }
+    if (mMenuState == MENU_WIFI) closeWifiScreen();
+    else if (mMenuState == MENU_BT) closeBtScreen();
+    if (!mPs3MenuBuilt) initPs3Menu();
+    mAppsReturn.valid = true;
+    mAppsReturn.stack = mPs3Stack;
+    mAppsReturn.cat = mPs3CatIdx; mAppsReturn.item = mPs3ItemIdx;
+    if (mPs3CatIdx >= 0 && mPs3CatIdx < (int)mPs3Cats.size()
+        && mPs3ItemIdx >= 0 && mPs3ItemIdx < (int)mPs3Cats[mPs3CatIdx].items.size()) {
+        mAppsReturn.itemKind = mPs3Cats[mPs3CatIdx].items[mPs3ItemIdx].kind;
+        mAppsReturn.itemLabel = mPs3Cats[mPs3CatIdx].items[mPs3ItemIdx].label;
+    }
+    mAppsReturn.atRoot = mNdsAtRoot; mAppsReturn.camera = mNdsCamera;
+    mPs3Stack.clear();
+    mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    // The XMB, DSi and Minima homes reach Applications from a category: land on its row there.
+    if (!mEsdeTheme && !mEsdeSettingsMinima) {
+        for (int c = 0; c < (int)mPs3Cats.size(); c++) {
+            const std::vector<Ps3Item>& items = mPs3Cats[c].items;
+            auto it = std::find_if(items.begin(), items.end(), [](const Ps3Item& i) { return i.kind == PS3_APP_LIST; });
+            if (it == items.end()) continue;
+            mAppsReturn.appCat = c;
+            mAppsReturn.appCatSel = mPs3CatItemSel[c];
+            mPs3CatIdx = c;
+            mPs3ItemIdx = (int)(it - items.begin());
+            mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+            mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+            mPs3CatAnimActive = false; mPs3CatT = 1.0f; mPs3CatFromOffset = 0.0f;
+            break;
+        }
+        mNdsAtRoot = false;
+    }
+    mPs3SubAnimStart = -1.0f;
+    Ps3Level lvl; buildAppSubmenu(lvl); mPs3Stack.push_back(lvl);
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
+
+// Anbernic + Start or Start on the Applications view: back to where it was opened from. Over a
+// running app, when Anbernic + Start opened it there, the app resumes.
+void NanoMenu::closeApplicationsView() {
+    if (mOskActive) {
+        if (!mAppGridOskOpen) return;   // another text field is being typed in
+        mOskPasswordCallback = nullptr;
+        closeOsk();
+        mAppGridOskOpen = false;
+    }
+    if (mPs3OptActive) closeXmbOpt();
+    if (mPs3DlgActive) closePs3Dialog(false);
+    if (mPs3DlgActive || mPs3OptActive) return;   // a dialog that must stay up
+    if (mAppsSummoned && mOverlayMode && mOverlayShown && !mOverlayWallpaper) {
+        mAppsSummoned = false;
+        mAppsReturn = QsReturn();
+        overlayResume();
+        return;
+    }
+    mAppsSummoned = false;
+    esdeOverlayCloseAll();
+    if (mAppsReturn.valid && mPs3Stack.size() == 1 && mAppsReturn.cat >= 0 && mAppsReturn.cat < (int)mPs3Cats.size()) {
+        mPs3Stack = mAppsReturn.stack;
+        if (mAppsReturn.appCat >= 0 && mAppsReturn.appCat < (int)mPs3Cats.size()
+            && mAppsReturn.appCatSel < (int)mPs3Cats[mAppsReturn.appCat].items.size())
+            mPs3CatItemSel[mAppsReturn.appCat] = mAppsReturn.appCatSel;   // the category it landed on
+        mPs3CatIdx = mAppsReturn.cat; mPs3ItemIdx = mAppsReturn.item;
+        // Pinning an app meanwhile adds or removes the Pinned Apps row: find the row again.
+        const auto& ci = mPs3Cats[mPs3CatIdx].items;
+        bool same = mPs3ItemIdx >= 0 && mPs3ItemIdx < (int)ci.size()
+                    && ci[mPs3ItemIdx].kind == mAppsReturn.itemKind && ci[mPs3ItemIdx].label == mAppsReturn.itemLabel;
+        for (int k = 0; k < (int)ci.size() && !same; k++)
+            if (ci[k].kind == mAppsReturn.itemKind && ci[k].label == mAppsReturn.itemLabel) { mPs3ItemIdx = k; same = true; }
+        if (mPs3ItemIdx >= (int)ci.size()) mPs3ItemIdx = ci.empty() ? 0 : (int)ci.size() - 1;
+        if (mPs3ItemIdx < 0) mPs3ItemIdx = 0;
+        mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+        mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+        mNdsAtRoot = mAppsReturn.atRoot; mNdsCamera = mAppsReturn.camera;
+    } else {
+        if (!mPs3Stack.empty()) mPs3Stack.pop_back();
+        mNdsCamera = mPs3Stack.empty() ? (float)mPs3ItemIdx : (float)mPs3Stack.back().sel;
+    }
+    mAppsReturn = QsReturn();
+    mPs3SubAnimStart = -1.0f;
+    mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_BACK);
+    mDisplayDirty = true;
+}
