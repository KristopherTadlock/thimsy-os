+#include "NanoDisplayTarget.h"
+
+namespace android {
+namespace nanodisplay {
+
+Choice choose(const std::vector<Display>& displays, int primaryPort, bool dualMode) {
+    Choice c;
+    if (displays.empty()) return c;
+    int display0 = -1, atPort = -1;
+    for (size_t i = 0; i < displays.size(); i++) {
+        const Display& d = displays[i];
+        // A panel showing layer stack 0 is display 0, even beside a monitor mirroring it.
+        if (d.hasLayerStack && d.layerStack == 0 &&
+            (display0 < 0 || (d.internal && !displays[display0].internal)))
+            display0 = (int)i;
+        if (atPort < 0 && primaryPort > 0 && d.port == primaryPort && d.internal) atPort = (int)i;
+    }
+    c.shown = display0 >= 0;
+    if (display0 >= 0 && !displays[display0].internal) {
+        c.target = display0;
+        c.monitor = true;
+        if (!dualMode) return c;
+        // Only once DisplayManager has switched the panel on beside the monitor: until then it is
+        // blanked (docked), and the mode property alone says nothing about the screens. The screens
+        // also blank one after the other around sleep: blankSecond lets dual screen stay on then.
+        for (size_t i = 0; i < displays.size(); i++) {
+            const Display& d = displays[i];
+            if (d.internal && (atPort < 0 || (int)i == atPort)) {
+                if (d.hasLayerStack && d.layerStack != kBlankLayerStack) c.second = (int)i;
+                else c.blankSecond = (int)i;
+                break;
+            }
+        }
+        return c;
+    }
+    c.target = atPort >= 0 ? atPort : (display0 >= 0 ? display0 : 0);
+    c.monitor = !displays[c.target].internal;
+    if (c.monitor) return c;
+    for (size_t i = 0; i < displays.size(); i++)
+        if ((int)i != c.target && displays[i].internal) { c.second = (int)i; break; }
+    return c;
+}
+
+bool isMonitor(bool external, bool connectorConnected, bool hasProductInfo, bool twoPanels) {
+    return external && connectorConnected && (hasProductInfo || !twoPanels);
+}
+
+bool uiOnPanel(const UiState& s) {
+    if (s.overGame) return true;
+    if (s.media) return false;
+    return s.menu || s.settingsOpen;
+}
+
+}  // namespace nanodisplay
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoDisplayTarget.h b/frameworks/base/cmds/gammaos-nano/NanoDisplayTarget.h
new file mode 100644
index 00000000000..67becb3c1c8
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoDisplayTarget.h
@@ -0,0 +1,76 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// The display Nano and drastic-nano draw on. Docked (the default): while a monitor is plugged in it
+// is Android's display 0 (layer stack 0) and the panel is switched off; unplugged, the panel is
+// display 0 again (LogicalDisplayMapper.gammaosArrangeLocked). So the target is the display showing
+// layer stack 0, except on a device with two panels, where persist.gammaos.nano.primary_display
+// names the panel Nano draws on unless a monitor has display 0. A second screen is another panel:
+// beside a panel target, or, in dual screen mode (persist.gammaos.display.mode=dual, where the panel
+// stays on beside the monitor), beside a monitor target. In mirror mode the panel stays display 0 and
+// the monitor shows layer stack 0 too: the panel is the target and the monitor is never a second
+// screen. Pure, so host tests can use it; NanoDisplayTargetSf.h gathers the displays from
+// SurfaceFlinger.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace android {
+namespace nanodisplay {
+
+// The layer stack DisplayManager gives a display it blanks or switches off.
+constexpr uint32_t kBlankLayerStack = UINT32_MAX;
+
+struct Display {
+    uint64_t id = 0;            // physical display id
+    int port = 0;
+    bool hasLayerStack = false; // SurfaceFlinger reported its state
+    uint32_t layerStack = 0;
+    bool internal = true;       // a built-in panel, not a monitor
+};
+
+struct Choice {
+    int target = -1;      // index into the displays; -1 when there are none
+    int second = -1;      // a second panel to draw on, -1 for none
+    int blankSecond = -1; // dual screen mode: the panel beside the monitor while it shows nothing
+    bool monitor = false; // the target is a monitor (the touchscreen belongs to the second, if any)
+    bool shown = false;   // a display shows layer stack 0 (none while the screens are off)
+};
+
+Choice choose(const std::vector<Display>& displays, int primaryPort, bool dualMode = false);
+
+// A display SurfaceFlinger reports is a monitor, as system_server decides it
+// (GammaosScreenArrangement.externalIsMonitor): one the composer calls external while a DisplayPort
+// or HDMI connector has a monitor, and, on a device with two panels (where the composer calls the
+// second panel external too), only one whose EDID names it.
+bool isMonitor(bool external, bool connectorConnected, bool hasProductInfo, bool twoPanels);
+
+// Dual screen mode: what Nano shows, for where its UI draws.
+struct UiState {
+    bool overGame = false;      // the overlay is up over a running game
+    bool media = false;         // a video, photo, PDF, music or ES-DE media viewer is up
+    bool menu = false;          // the Quick Menu, Applications, the button map or the ES-DE menu
+    bool settingsOpen = false;  // inside Nano's settings (past the Settings category itself)
+};
+
+// The UI draws on the panel beside the monitor: over a game always (the game keeps the monitor),
+// else for the menus and settings; media and the home stay on the monitor.
+bool uiOnPanel(const UiState& s);
+
+}  // namespace nanodisplay
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoDisplayTargetSf.h b/frameworks/base/cmds/gammaos-nano/NanoDisplayTargetSf.h
new file mode 100644
index 00000000000..67e40b60d64
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoDisplayTargetSf.h
@@ -0,0 +1,105 @@
+/*
+ * Copyright (C) 2026 The Thimsy OS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// NanoDisplayTarget's displays, from SurfaceFlinger: shared by gammaos-nano and drastic-nano.
+#pragma once
+
+#include <cutils/properties.h>
+#include <dirent.h>
+#include <gui/SurfaceComposerClient.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ui/DisplayState.h>
+#include <ui/StaticDisplayInfo.h>
+
+#include <string>
+#include <vector>
+
+#include "NanoDisplayTarget.h"
+
+namespace android {
+namespace nanodisplay {
+
+// A DisplayPort or HDMI connector reports a monitor connected.
+inline bool monitorConnected() {
+    DIR* d = opendir("/sys/class/drm");
+    if (!d) return false;
+    bool found = false;
+    while (struct dirent* e = readdir(d)) {
+        const std::string name = e->d_name;
+        if (name.find("-DP-") == std::string::npos && name.find("-HDMI-") == std::string::npos) continue;
+        char status[16] = {0};
+        if (FILE* f = fopen(("/sys/class/drm/" + name + "/status").c_str(), "r")) {
+            if (fgets(status, sizeof(status), f) == nullptr) status[0] = 0;
+            fclose(f);
+        }
+        if (std::string(status).rfind("connected", 0) == 0) { found = true; break; }
+    }
+    closedir(d);
+    return found;
+}
+
+// A device with two panels: Nano draws on a chosen port, or the dual-stack screens are on.
+inline bool twoPanels() {
+    return property_get_int32("persist.gammaos.nano.primary_display", 0) > 0 ||
+           property_get_bool("persist.gammaos.dualstack.enabled", false);
+}
+
+// SurfaceFlinger calls every display but the first external when the composer doesn't say, a second
+// panel included: which are monitors is isMonitor's rule.
+inline std::vector<Display> sfDisplays(const std::vector<PhysicalDisplayId>& ids) {
+    std::vector<Display> out;
+    const bool connected = monitorConnected();
+    const bool dual = twoPanels();
+    for (const PhysicalDisplayId& id : ids) {
+        Display d;
+        d.id = id.value;
+        d.port = static_cast<int>(id.getPort());
+        ui::StaticDisplayInfo info;
+        const bool known = SurfaceComposerClient::getStaticDisplayInfo(id.value, &info) == NO_ERROR;
+        d.internal = !(known && isMonitor(info.connectionType != ui::DisplayConnectionType::Internal,
+                                          connected, info.deviceProductInfo.has_value(), dual));
+        if (const sp<IBinder> token = SurfaceComposerClient::getPhysicalDisplayToken(id)) {
+            ui::DisplayState state;
+            if (SurfaceComposerClient::getDisplayState(token, &state) == NO_ERROR) {
+                d.hasLayerStack = true;
+                d.layerStack = state.layerStack.id;
+            }
+        }
+        out.push_back(d);
+    }
+    return out;
+}
+
+// A monitor is in use: SurfaceFlinger lists one (as the screen, beside the panel, or mirroring it),
+// not merely a connector reading connected.
+inline bool monitorListed() {
+    for (const Display& d : sfDisplays(SurfaceComposerClient::getPhysicalDisplayIds()))
+        if (!d.internal) return true;
+    return false;
+}
+
+inline Choice sfChoose(const std::vector<PhysicalDisplayId>& ids) {
+    char port[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.nano.primary_display", port, "0");
+    char mode[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.display.mode", mode, "docked");
+    return choose(sfDisplays(ids), atoi(port), strcmp(mode, "dual") == 0);
+}
+
+}  // namespace nanodisplay
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoEmuSync.cpp b/frameworks/base/cmds/gammaos-nano/NanoEmuSync.cpp
new file mode 100644
index 00000000000..f64c2819b09
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoEmuSync.cpp
@@ -0,0 +1,217 @@
+// GammaOS Nano: emulator settings in app-private folders, kept in step with the microSD card.
+//
+// Move Emulator Files to microSD points each emulator at its folder on the card where it has a
+// setting for one (NanoSdMove.cpp). Some of what makes an emulator yours has no such setting: its
+// Android preferences, the button maps several keep beside them, ScummVM's scummvm.ini, Vita3K's
+// config.yml, RetroArch's controller profiles. Those stay in the app's folder, and the card keeps a
+// copy of each in <card>/emulator_config/<emu>/app (app/external for a file in Android/data).
+//
+// The two are kept in step file by file, three ways: what changed since the last sync goes to the
+// other side (a file deleted on one side is deleted on the other); changed on both, or never synced
+// on this card (a reinstall, another card), the card's copy wins. So the card is the master: a file
+// edited on it is what the emulator gets, and a reinstalled Thimsy gets its settings back from it.
+// What looks like a mass deletion (an emulator installed again, a card folder deleted or unreadable)
+// is taken as never synced, so what is left is copied back rather than deleted; an app copy another
+// card's sync wrote, unchanged since, gives way to this card's.
+// Settings that name the emulator_config folder of a card that is out (a copy of the card with
+// another id, the card this one replaced) are pointed at this card when they come in.
+// Nano syncs when a card is adopted, every few seconds at the home screen, and for an emulator just
+// before it starts; never into an emulator that is running.
+
+#define LOG_TAG "GammaOSNano"
+
+#include "NanoEmuSync.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+
+namespace android {
+namespace emusync {
+
+const std::vector<Item>& items() {
+    static const std::vector<Item> kItems = {
+        {"retroarch", "com.retroarch.aarch64", false, "autoconfig", {}, true},   // controller profiles
+        {"ppsspp", "org.ppsspp.ppsspp", false, "shared_prefs", {}},
+        {"m64plus", "org.mupen64plusae.v3.fzurita", false, "shared_prefs", {}},
+        {"m64plus", "org.mupen64plusae.v3.fzurita", false, "files/Profiles", {}},   // controller and emulation profiles
+        {"dolphin", "org.dolphinemu.dolphinemu", false, "shared_prefs", {}},
+        {"armsx2", "com.armsx2", false, "shared_prefs", {}},
+        {"scummvm", "org.scummvm.scummvm", false, "shared_prefs", {}},
+        {"scummvm", "org.scummvm.scummvm", false, "files/scummvm.ini", {}},   // settings, games, key maps
+        {"vita3k", "org.vita3k.emulator", false, "shared_prefs", {}},
+        {"vita3k", "org.vita3k.emulator", true, "config.yml", {}},
+        {"azahar", "org.azahar_emu.azahar", false, "shared_prefs", {}},   // its Android settings and button maps
+        {"watermelonds", "me.magnum.melondualds", false, "shared_prefs", {}},
+        {"watermelonds", "me.magnum.melondualds", false, "files/controller_config.json", {}},
+        {"seedlessds", "com.seedlessds.app", false, "shared_prefs", {}},   // settings, keymap.xml
+        // Its saves and states move with the move when kept here (emulator_config/seedlessds).
+        {"seedlessds", "com.seedlessds.app", false, "files/SeedlessDS/user", {"backup", "savestates"}},
+        {"hakux", "com.rfandango.haku_x", false, "shared_prefs", {}},
+        {"hakux", "com.rfandango.haku_x", false, "files/controllers.json", {}},
+        {"drastic", "com.dsemu.drastic", false, "shared_prefs", {}},
+    };
+    return kItems;
+}
+
+std::string appPath(const Item& it) {
+    return it.media ? std::string("/data/media/0/Android/data/") + it.pkg + "/files/" + it.rel
+                    : std::string("/data/data/") + it.pkg + "/" + it.rel;
+}
+
+std::string cardPath(const std::string& card, const Item& it) {
+    return card + "/emulator_config/" + it.emu + (it.media ? "/app/external/" : "/app/") + it.rel;
+}
+
+bool skipFile(const std::string& n) {
+    auto ends = [&](const char* s) {
+        const size_t l = strlen(s);
+        return n.size() >= l && n.compare(n.size() - l, l, s) == 0;
+    };
+    auto starts = [&](const char* s) { return n.compare(0, strlen(s), s) == 0; };
+    // Libraries' own preferences (ids, crash and WebView state): the device's, not the user's.
+    if (starts("com.google.") || starts("com.facebook.") || starts("com.crashlytics") || starts("FirebaseHeartBeat")
+        || starts("WebViewChromiumPrefs"))
+        return true;
+    return n.empty() || n[0] == '.' || ends(".bak") || ends(".nanotmp") || ends(".tmp") || ends("~");
+}
+
+Act decide(bool haveBase, int64_t baseApp, int64_t baseCard, int64_t app, int64_t card, bool preferApp) {
+    if (!haveBase) {   // never synced on this card: the card's copy wins (or this device's), else the one there is
+        if (preferApp && app >= 0) return app == card ? Act::None : Act::ToCard;
+        if (card >= 0) return app == card ? Act::None : Act::ToApp;
+        return app >= 0 ? Act::ToCard : Act::None;
+    }
+    const bool appChanged = app != baseApp, cardChanged = card != baseCard;
+    if (cardChanged) {
+        if (card >= 0) return Act::ToApp;   // also when both changed: the card wins
+        return app >= 0 ? Act::DeleteApp : Act::None;
+    }
+    if (appChanged) return app >= 0 ? Act::ToCard : (card >= 0 ? Act::DeleteCard : Act::None);
+    return Act::None;
+}
+
+std::string baseKey(const std::string& cardId, const std::string& emu, const std::string& rel) {
+    return cardId + "\x1f" + emu + "\x1f" + rel;
+}
+
+// One line per file: key, then the app state, the card state and the card copy's hash, tab separated.
+std::string baseSave(const Base& b) {
+    std::string out;
+    for (const auto& kv : b)
+        out += kv.first + "\t" + std::to_string(kv.second.app) + "\t" + std::to_string(kv.second.card) + "\t" +
+               std::to_string(kv.second.hash) + "\n";
+    return out;
+}
+
+Base baseLoad(const std::string& text) {
+    Base b;
+    for (size_t p = 0; p < text.size();) {
+        size_t nl = text.find('\n', p);
+        if (nl == std::string::npos) nl = text.size();
+        const std::string l = text.substr(p, nl - p);
+        p = nl + 1;
+        const size_t t1 = l.find('\t'), t2 = t1 == std::string::npos ? t1 : l.find('\t', t1 + 1);
+        const size_t t3 = t2 == std::string::npos ? t2 : l.find('\t', t2 + 1);
+        if (t3 == std::string::npos || t1 == 0) continue;
+        b[l.substr(0, t1)] = {atoll(l.c_str() + t1 + 1), atoll(l.c_str() + t2 + 1), strtoull(l.c_str() + t3 + 1, nullptr, 10)};
+    }
+    return b;
+}
+
+uint64_t hash(const std::string& data) {   // FNV-1a
+    uint64_t h = 1469598103934665603ULL;
+    for (unsigned char c : data) { h ^= c; h *= 1099511628211ULL; }
+    return h ? h : 1;
+}
+
+static bool isHex(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }
+
+bool isVolumeId(const std::string& s) {
+    if (s.size() == 9) {
+        for (size_t i = 0; i < 9; i++)
+            if (i == 4 ? s[i] != '-' : !isHex(s[i])) return false;
+        return true;
+    }
+    if (s.size() != 32) return false;
+    for (char c : s) if (!isHex(c)) return false;
+    return true;
+}
+
+std::string repoint(const std::string& text, const std::string& id, const std::function<bool(const std::string&)>& absent) {
+    static const char* const kAfter[] = {"/emulator_config", "%3Aemulator_config", "%253Aemulator_config", ":emulator_config"};
+    std::string out;
+    size_t from = 0;
+    for (size_t at = 1; at < text.size(); at++) {   // at: where a volume id may start, after / or %2F
+        const bool slash = text[at - 1] == '/' ||
+                           (at >= 3 && text[at - 3] == '%' && text[at - 2] == '2' && (text[at - 1] == 'F' || text[at - 1] == 'f'));
+        if (!slash || !isHex(text[at])) continue;
+        size_t end = at;
+        while (end < text.size() && (isHex(text[end]) || text[end] == '-') && end - at < 32) end++;
+        const std::string vol = text.substr(at, end - at);
+        if (!isVolumeId(vol) || vol == id) continue;
+        bool follows = false;
+        for (const char* a : kAfter) follows = follows || text.compare(end, strlen(a), a) == 0;
+        if (!follows || !absent(vol)) continue;
+        out.append(text, from, at - from);
+        out += id;
+        from = end;
+        at = end - 1;
+    }
+    return from == 0 ? text : out + text.substr(from);
+}
+
+static std::string uriDecode(const std::string& s) {
+    std::string out;
+    for (size_t i = 0; i < s.size(); i++) {
+        if (s[i] == '%' && i + 2 < s.size() && isHex(s[i + 1]) && isHex(s[i + 2])) {
+            out += (char)strtol(s.substr(i + 1, 2).c_str(), nullptr, 16);
+            i += 2;
+        } else {
+            out += s[i];
+        }
+    }
+    return out;
+}
+
+std::vector<std::pair<std::string, std::string>> treeUris(const std::string& text) {
+    // A grant's tree id, encoded: after content://.../tree/ (a document below it, ".../document/...",
+    // names it again), or after ScummVM's /saf/ in its paths (Uri.encode leaves !'()* as they are).
+    static const char* const kStarts[] = {"content://com.android.externalstorage.documents/tree/", "/saf/"};
+    std::vector<std::pair<std::string, std::string>> out;
+    for (const char* start : kStarts) {
+        const size_t n = strlen(start);
+        for (size_t at = text.find(start); at != std::string::npos; at = text.find(start, at + 1)) {
+            size_t end = at + n;
+            while (end < text.size() && (isalnum((unsigned char)text[end]) || strchr("%-_.~!'()*", text[end]))) end++;
+            const std::string doc = uriDecode(uriDecode(text.substr(at + n, end - at - n)));
+            const size_t colon = doc.find(':');
+            if (colon == std::string::npos || colon == 0) continue;
+            std::pair<std::string, std::string> u{doc.substr(0, colon), doc.substr(colon + 1)};
+            while (!u.second.empty() && u.second.back() == '/') u.second.pop_back();
+            if (std::find(out.begin(), out.end(), u) == out.end()) out.push_back(u);
+        }
+    }
+    return out;
+}
+
+std::vector<size_t> unpackedTogether(const std::vector<int64_t>& mtimes, size_t minCount) {
+    std::map<int64_t, size_t> perMinute;
+    for (int64_t t : mtimes) perMinute[t / 60]++;
+    int64_t best = 0;
+    size_t bestCount = 0;
+    for (const auto& kv : perMinute) {
+        auto next = perMinute.find(kv.first + 1);
+        const size_t n = kv.second + (next == perMinute.end() ? 0 : next->second);
+        if (n > bestCount) { best = kv.first; bestCount = n; }
+    }
+    std::vector<size_t> out;
+    if (bestCount < minCount) return out;
+    for (size_t i = 0; i < mtimes.size(); i++)
+        if (mtimes[i] / 60 == best || mtimes[i] / 60 == best + 1) out.push_back(i);
+    return out;
+}
+
+}  // namespace emusync
+}  // namespace android
diff --git a/frameworks/base/cmds/gammaos-nano/NanoEmuSync.h b/frameworks/base/cmds/gammaos-nano/NanoEmuSync.h
new file mode 100644
index 00000000000..a20aafdaa10
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/NanoEmuSync.h
@@ -0,0 +1,74 @@
+// The emulator settings that live in an app's private folder (Android preferences, button maps,
+// ScummVM's scummvm.ini, Vita3K's config.yml, RetroArch's controller profiles), kept in step with a
+// copy on the microSD card (NanoEmuSync.cpp has why and how). No Android code: host tested.
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace android {
+namespace emusync {
+
+// One thing kept in step: rel under the app's private folder (/data/data/<pkg>), or with media under
+// its shared one (Android/data/<pkg>/files); a file or a folder (all of it but skip, top level).
+struct Item {
+    const char* emu;    // its folder under <card>/emulator_config
+    const char* pkg;
+    bool media;
+    const char* rel;
+    std::vector<std::string> skip;
+    bool many = false;   // many files: not checked just before the emulator starts (that waits for it)
+};
+const std::vector<Item>& items();
+
+std::string appPath(const Item& it);                              // where the app keeps it
+std::string cardPath(const std::string& card, const Item& it);    // <card>/emulator_config/<emu>/app[/external]/<rel>
+
+// A file the sync never copies: an editor's or SharedPreferences' leftovers, libraries' own preferences.
+bool skipFile(const std::string& name);
+
+// A file's state on one side: -1 when it is not there, else its modification time and size in one number.
+// haveBase: both sides as the last sync left them (none: never synced on this card, when the card's
+// copy wins, or with preferApp this device's).
+enum class Act { None, ToApp, ToCard, DeleteApp, DeleteCard };
+Act decide(bool haveBase, int64_t baseApp, int64_t baseCard, int64_t app, int64_t card, bool preferApp = false);
+
+// What the last sync left, per card, emulator and file ("<card>\x1f<emu>\x1f<rel>"): the app side's
+// state, the card side's, and the card copy's contents hash (0: not known), which tells a card file
+// whose time alone moved (a FAT card's times are local time) from one that was edited.
+struct State {
+    int64_t app = -1, card = -1;
+    uint64_t hash = 0;
+    bool operator==(const State& o) const { return app == o.app && card == o.card && hash == o.hash; }
+    bool operator!=(const State& o) const { return !(*this == o); }
+};
+using Base = std::map<std::string, State>;
+std::string baseKey(const std::string& cardId, const std::string& emu, const std::string& rel);
+std::string baseSave(const Base& b);
+Base baseLoad(const std::string& text);
+uint64_t hash(const std::string& data);   // never 0
+
+// A card volume id as Android names it (XXXX-XXXX, or 32 hex digits).
+bool isVolumeId(const std::string& s);
+
+// text with the emulator_config folder of a card that is out (absent(id)) named on the card with id
+// instead: as a path (/storage/<id>/..., /mnt/media_rw/<id>/...) or in a content:// folder grant
+// (<id>%3Aemulator_config, also encoded twice). A copy of the card with another id, or settings from
+// a card that was replaced, then name this card's folders.
+std::string repoint(const std::string& text, const std::string& id, const std::function<bool(const std::string&)>& absent);
+
+// The external storage folder grants text names (content://com.android.externalstorage.documents/
+// tree/<volume>%3A<path>, or ScummVM's /saf/<volume>%3A<path>): {volume, path}, path decoded.
+std::vector<std::pair<std::string, std::string>> treeUris(const std::string& text);
+
+// The files of a folder an app filled from its own package in one go (RetroArch's controller
+// profiles, hundreds unpacked within a minute): those of the minute (and the next) holding at least
+// minCount of mtimes (seconds), by index. What the user added or changed is outside it.
+std::vector<size_t> unpackedTogether(const std::vector<int64_t>& mtimes, size_t minCount = 50);
+
+}  // namespace emusync
+}  // namespace android
