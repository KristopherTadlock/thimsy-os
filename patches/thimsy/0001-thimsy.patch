+TEST_F(ArchiveTest, ZipHostileNamesAreSkipped) {
+    const std::string a = zip("evil.zip", {
+        {"ok.txt", "ok"},
+        {"../evil.txt", "evil"},
+        {"/abs.txt", "abs"},
