+        Key(String label, int linux, String android, boolean gamepadOnly) {
+            this(label, linux, android, gamepadOnly, "");
+        }
+
+        Key(String label, int linux, String android, boolean gamepadOnly, String prompt) {
+            this.label = label;
+            this.linux = linux;
+            this.android = android;
+            this.gamepadOnly = gamepadOnly;
+            this.prompt = prompt;
+        }
+    }
