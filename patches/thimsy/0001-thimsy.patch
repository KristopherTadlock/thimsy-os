+    /**
+     * Returns {@code null} if {@code path} is not protected, {@link #OWNED_FILES_ONLY} if it is
+     * in a top-level folder where apps reach only their own files, {@link #NO_OWNER} if it is in
+     * a refused top-level folder, or the owning package's folder name if it is in an
+     * {@code Android/data|obb|media/<pkg>} folder.
+     */
+    public static String getProtectedOwner(String path) {
+        path = normalize(path);
+        if (path == null) {
+            return null;
+        }
+        final int rel = relativePathStart(path);
+        if (rel < 0 || rel >= path.length()) {
+            return null;
+        }
+        final int end1 = segmentEnd(path, rel);
+        for (String folder : OWNED_FILES_TOP_LEVEL_FOLDERS) {
+            if (segmentEquals(path, rel, end1, folder)) {
+                return OWNED_FILES_ONLY;
+            }
+        }
+        for (String folder : REFUSED_TOP_LEVEL_FOLDERS) {
+            if (segmentEquals(path, rel, end1, folder)) {
+                return NO_OWNER;
+            }
+        }
+        if (!segmentEquals(path, rel, end1, "Android") || end1 >= path.length()) {
+            return null;
+        }
+        final int start2 = end1 + 1;
+        final int end2 = segmentEnd(path, start2);
+        if (!isAppDirContainer(path, start2, end2) || end2 >= path.length()) {
+            return null;
+        }
+        final int start3 = end2 + 1;
+        final int end3 = trimmedEnd(path, start3, segmentEnd(path, start3));
+        if (end3 <= start3 || segmentEquals(path, start3, end3, ".nomedia")) {
+            return null;
+        }
+        return path.substring(start3, end3);
+    }
+
+    /**
+     * Returns true if {@code path} is {@code Android} or {@code Android/data|obb|media} at the
+     * root of a volume: folders whose rename would move protected app folders.
+     */
+    public static boolean isAppDirContainer(String path) {
+        path = normalize(path);
+        if (path == null) {
+            return false;
+        }
+        final int rel = relativePathStart(path);
+        if (rel < 0 || rel >= path.length()) {
+            return false;
+        }
+        final int end1 = segmentEnd(path, rel);
+        if (!segmentEquals(path, rel, end1, "Android")) {
+            return false;
+        }
+        if (end1 >= path.length() - 1) {
+            return true;
+        }
+        final int start2 = end1 + 1;
+        final int end2 = segmentEnd(path, start2);
+        return isAppDirContainer(path, start2, end2) && end2 >= path.length() - 1;
+    }
+
+    /**
+     * Returns true if {@code path} is a volume root, {@code Android}, {@code Android/data|obb|media}
+     * or one of the denylist's top-level folders itself: folders that hold other apps' or
+     * protected files, so deleting, renaming or moving them would take those files along.
+     */
+    public static boolean isProtectedFolderOrAncestor(String path) {
+        path = normalize(path);
+        if (path == null) {
+            return false;
+        }
+        final int rel = relativePathStart(path);
+        if (rel < 0) {
+            return false;
+        }
+        if (rel >= path.length()) {
+            return true;
+        }
+        if (isAppDirContainer(path)) {
+            return true;
+        }
+        final String owner = getProtectedOwner(path);
+        return (NO_OWNER.equals(owner) || OWNED_FILES_ONLY.equals(owner))
+                && segmentEnd(path, rel) >= path.length() - 1;
+    }
+
+    /**
+     * Returns the absolute path of the folder in {@code path} that may be a FAT 8.3 alias of a
+     * folder the denylist names, such as {@code DOCUME~1}, else null. That is the top-level
+     * folder, or the folder below a top-level {@code Android}, if its name has the form an alias
+     * of such a folder's name takes (see {@link #isShortNameAlias}).
+     */
+    public static String getAmbiguousFolder(String path) {
+        path = normalize(path);
+        if (path == null) {
+            return null;
+        }
+        final int rel = relativePathStart(path);
+        if (rel < 0 || rel >= path.length()) {
+            return null;
+        }
+        final int end1 = segmentEnd(path, rel);
+        if (getAliasTargets(path.substring(rel, end1), TOP_LEVEL_ALIAS_TARGETS).length > 0) {
+            return path.substring(0, end1);
+        }
+        if (!segmentEquals(path, rel, end1, "Android") || end1 >= path.length()) {
+            return null;
+        }
+        final int end2 = segmentEnd(path, end1 + 1);
+        return getAliasTargets(path.substring(end1 + 1, end2), APP_DIR_CONTAINERS).length > 0
+                ? path.substring(0, end2) : null;
+    }
+
+    /**
+     * Returns the names {@code folder}, as returned by {@link #getAmbiguousFolder}, may be an
+     * alias of, to be resolved against.
+     */
+    public static String[] getAliasTargets(String folder) {
+        final int rel = relativePathStart(folder);
+        final int slash = folder.lastIndexOf('/');
+        final String name = folder.substring(slash + 1);
+        if (rel >= 0 && rel < folder.length() && segmentEnd(folder, rel) < folder.length()) {
+            return getAliasTargets(name, APP_DIR_CONTAINERS);
+        }
+        return getAliasTargets(name, TOP_LEVEL_ALIAS_TARGETS);
+    }
+
+    private static final String[] TOP_LEVEL_ALIAS_TARGETS = {
+            "DCIM", "Pictures", "Movies", "Recordings", "Documents", "Nano Backup", "Android",
+    };
+
+    private static String[] getAliasTargets(String segment, String[] names) {
+        final ArrayList<String> out = new ArrayList<>();
+        for (String name : names) {
+            if (isShortNameAlias(segment, name)) {
+                out.add(name);
+            }
+        }
+        return out.toArray(new String[0]);
+    }
+
+    /**
+     * Returns true if {@code segment} has the form of a FAT 8.3 alias of a folder named
+     * {@code name}: the first letters of the upper-cased name without spaces and dots, '~' and a
+     * number, in at most 8 characters ({@code DOCUME~1}); or its first 2 letters, 4 hex digits,
+     * '~' and a digit ({@code DO1A2B~1}).
+     */
+    public static boolean isShortNameAlias(String segment, String name) {
+        final String base = name.toUpperCase(Locale.ROOT).replace(" ", "").replace(".", "");
+        final String s = segment.toUpperCase(Locale.ROOT);
+        final int tilde = s.lastIndexOf('~');
+        if (s.length() > 8 || tilde <= 0 || tilde == s.length() - 1) {
+            return false;
+        }
+        for (int i = tilde + 1; i < s.length(); i++) {
+            if (s.charAt(i) < '0' || s.charAt(i) > '9') {
+                return false;
+            }
+        }
+        final String prefix = s.substring(0, tilde);
+        final int digits = s.length() - tilde - 1;
+        if (prefix.length() == Math.min(base.length(), 8 - 1 - digits)
+                && base.startsWith(prefix)) {
+            return true;
+        }
+        final int lead = Math.min(base.length(), 2);
+        if (digits != 1 || tilde != lead + 4 || !base.startsWith(s.substring(0, lead))) {
+            return false;
+        }
+        for (int i = lead; i < tilde; i++) {
+            if (Character.digit(s.charAt(i), 16) < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Returns {@code name} folded the way volumes compare names: Unicode default-ignorable code
+     * points removed, trailing dots and spaces removed, canonically decomposed and case-folded.
+     * Copied, with isDefaultIgnorable and isShortNameAlias, in UriGrantsManagerService and
+     * NanoUriGrant (frameworks/base/services); keep the copies identical.
+     */
+    public static String foldName(String name) {
+        boolean ascii = true;
+        for (int i = 0; i < name.length() && ascii; i++) {
+            ascii = name.charAt(i) <= 0x7e;
+        }
+        String folded = name;
+        if (!ascii) {
+            final String nfd = Normalizer.normalize(name, Normalizer.Form.NFD);
+            final StringBuilder sb = new StringBuilder(nfd.length());
+            for (int i = 0; i < nfd.length(); ) {
+                final int cp = nfd.codePointAt(i);
+                i += Character.charCount(cp);
+                if (!isDefaultIgnorable(cp)) {
+                    sb.appendCodePoint(cp);
+                }
+            }
+            folded = sb.toString().toUpperCase(Locale.ROOT);
+        }
+        int end = folded.length();
+        while (end > 0 && (folded.charAt(end - 1) == '.' || folded.charAt(end - 1) == ' ')) {
+            end--;
+        }
+        folded = folded.substring(0, end).toLowerCase(Locale.ROOT);
+        return ascii ? folded : Normalizer.normalize(folded, Normalizer.Form.NFC);
+    }
+
+    /** Returns true for Unicode Default_Ignorable_Code_Point code points. */
+    private static boolean isDefaultIgnorable(int cp) {
+        return cp == 0x00AD || cp == 0x034F || cp == 0x061C || cp == 0x115F || cp == 0x1160
+                || cp == 0x17B4 || cp == 0x17B5 || (cp >= 0x180B && cp <= 0x180F)
+                || (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x202A && cp <= 0x202E)
+                || (cp >= 0x2060 && cp <= 0x206F) || cp == 0x3164
+                || (cp >= 0xFE00 && cp <= 0xFE0F) || cp == 0xFEFF || cp == 0xFFA0
+                || (cp >= 0xFFF0 && cp <= 0xFFF8) || (cp >= 0x1BCA0 && cp <= 0x1BCA3)
+                || (cp >= 0x1D173 && cp <= 0x1D17A) || (cp >= 0xE0000 && cp <= 0xE0FFF);
+    }
+
+    /**
+     * Returns {@code path}, normalized, with {@code folder}, as returned by
+     * {@link #getAmbiguousFolder}, renamed to {@code name}.
+     */
+    public static String replaceFolder(String path, String folder, String name) {
+        final String normalized = normalize(path);
+        if (normalized == null || !normalized.startsWith(folder)) {
+            return path;
+        }
+        return folder.substring(0, folder.lastIndexOf('/') + 1) + name
+                + normalized.substring(folder.length());
+    }
+
+    /**
+     * Returns an SQL selection, for the MediaStore files table and its views, that keeps only
+     * rows an app with packages {@code ownPackages} may see: everything outside protected
+     * folders, its own files in the owned-files folders, and its own
+     * {@code Android/data|obb|media} folders. Rows are matched on their volume-relative path,
+     * which for a folder row includes the folder's own name. Only plain column comparisons are
+     * used, so rows are rejected cheaply.
+     */
+    public static String buildHiddenRowsSelection(String[] ownPackages) {
+        final ArrayList<String> refused = new ArrayList<>();
+        for (String folder : REFUSED_TOP_LEVEL_FOLDERS) {
+            addTopLevelFolder(refused, folder);
+        }
+        final ArrayList<String> ownedOnly = new ArrayList<>();
+        for (String folder : OWNED_FILES_TOP_LEVEL_FOLDERS) {
+            addTopLevelFolder(ownedOnly, folder);
+        }
+        final ArrayList<String> appDirs = new ArrayList<>();
+        for (String container : APP_DIR_CONTAINERS) {
+            appDirs.add(like(REL_PATH, "Android/" + container + "/%/%"));
+            appDirs.add("(" + like(REL_PATH, "Android/" + container + "/") + " AND " + NAME
+                    + " <> '')");
+        }
+        final ArrayList<String> ownAppDirs = new ArrayList<>();
+        final ArrayList<String> ownNames = new ArrayList<>();
+        if (ownPackages != null) {
+            for (String packageName : ownPackages) {
+                final String escaped = escapeForLike(packageName);
+                for (String container : APP_DIR_CONTAINERS) {
+                    ownAppDirs.add(like(REL_PATH, "Android/" + container + "/" + escaped + "/%"));
+                    ownAppDirs.add("(" + like(REL_PATH, "Android/" + container + "/") + " AND "
+                            + like(NAME, escaped) + ")");
+                }
+                ownNames.add("'" + packageName.replace("'", "''") + "'");
+            }
+        }
+        final String ownedOnlyHidden = ownNames.isEmpty() ? "(" + String.join(" OR ", ownedOnly)
+                + ")" : "((" + String.join(" OR ", ownedOnly) + ") AND " + OWNER + " NOT IN ("
+                + String.join(", ", ownNames) + "))";
+        final String appDirsHidden = ownAppDirs.isEmpty() ? "(" + String.join(" OR ", appDirs)
+                + ")" : "((" + String.join(" OR ", appDirs) + ") AND NOT ("
+                + String.join(" OR ", ownAppDirs) + "))";
+        return "NOT ((" + String.join(" OR ", refused) + ") OR " + ownedOnlyHidden + " OR "
+                + appDirsHidden + ")";
+    }
+
+    private static void addTopLevelFolder(ArrayList<String> out, String folder) {
+        out.add(like(REL_PATH, escapeForLike(folder) + "/%"));
+        out.add("(" + REL_PATH + " IN ('/', '') AND " + like(NAME, escapeForLike(folder)) + ")");
+    }
+
+    private static final String OWNER = "ifnull(owner_package_name, '')";
+    private static final String REL_PATH = "ifnull(relative_path, '')";
+    private static final String NAME = "ifnull(_display_name, '')";
+
+    /**
+     * Returns the protected folder {@code path} is in, lower-cased, such as {@code dcim} or
+     * {@code android/obb/com.foo}, for grouping refusal logs; or {@code path} if unprotected.
+     */
+    public static String getRefusalLogKey(String path) {
+        final String owner = getProtectedOwner(path);
+        if (owner == null) {
+            return path;
+        }
+        final String normalized = normalize(path);
+        final int rel = relativePathStart(normalized);
+        int end = segmentEnd(normalized, rel);
+        if (!owner.isEmpty() && !OWNED_FILES_ONLY.equals(owner)) {
+            end = segmentEnd(normalized, segmentEnd(normalized, end + 1) + 1);
+        }
+        return normalized.substring(rel, end).toLowerCase(Locale.ROOT);
+    }
+
+    private static String like(String column, String pattern) {
+        return column + " LIKE '" + pattern.replace("'", "''") + "' ESCAPE '\\'";
+    }
+
+    private static String escapeForLike(String value) {
+        final StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            final char c = value.charAt(i);
+            if (c == '%' || c == '_' || c == '\\') {
+                sb.append('\\');
+            }
+            sb.append(c);
+        }
+        return sb.toString();
+    }
+
+    /**
+     * Returns the packages GammaOS grants All files access to itself, which therefore never
+     * exempts them: the pack-in emulators plus the comma-separated packages in
+     * {@code base} and {@code chunks}, the values of {@link #SELF_GRANTED_PACKAGES_PROP} and
+     * its numbered chunks. Parsed the way NanoPermGrantBridge.readMesAllowlist() parses them.
+     */
+    public static Set<String> parseSelfGrantedPackages(String base, String[] chunks) {
+        final Set<String> out = new HashSet<>(Arrays.asList(PACK_IN_EMULATORS));
+        final StringBuilder sb = new StringBuilder();
+        if (base != null && !base.trim().isEmpty()) {
+            sb.append(base.trim());
+        }
+        if (chunks != null) {
+            for (String chunk : chunks) {
+                final String part = chunk == null ? "" : chunk.trim();
+                if (part.isEmpty()) {
+                    continue;
+                }
+                if (sb.length() > 0 && sb.charAt(sb.length() - 1) != ',') {
+                    sb.append(',');
+                }
+                sb.append(part);
+            }
+        }
+        for (String raw : sb.toString().split(",")) {
+            final String spec = raw.trim();
+            if (!spec.isEmpty() && spec.indexOf(' ') == -1) {
+                out.add(spec);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Returns an SQL subquery of the {@code _id}s of files table rows of the given media types
+     * hidden by {@link #buildHiddenRowsSelection}, for filtering tables that reference them.
+     */
+    public static String buildHiddenIdsSubquery(String[] ownPackages, int... mediaTypes) {
+        return "SELECT _id FROM files WHERE " + mediaTypeSelection(mediaTypes) + "NOT ("
+                + buildHiddenRowsSelection(ownPackages) + ")";
+    }
+
+    /**
+     * Returns an SQL subquery of the non-null values of {@code column}, such as
+     * {@code album_id}, of the files table rows of the given media types that
+     * {@link #buildHiddenRowsSelection} keeps.
+     */
+    public static String buildVisibleValuesSubquery(String column, String[] ownPackages,
+            int... mediaTypes) {
+        return "SELECT " + column + " FROM files WHERE " + mediaTypeSelection(mediaTypes)
+                + column + " IS NOT NULL AND (" + buildHiddenRowsSelection(ownPackages) + ")";
+    }
+
+    private static String mediaTypeSelection(int[] mediaTypes) {
+        if (mediaTypes == null || mediaTypes.length == 0) {
+            return "";
+        }
+        final StringBuilder sb = new StringBuilder("media_type IN (");
+        for (int i = 0; i < mediaTypes.length; i++) {
+            sb.append(i == 0 ? "" : ", ").append(mediaTypes[i]);
+        }
+        return sb.append(") AND ").toString();
+    }
+
+    /** Returns true if {@code owner} names the same folder as package {@code packageName}. */
+    public static boolean isOwnerPackage(String owner, String packageName) {
+        return owner != null && packageName != null && owner.equalsIgnoreCase(packageName);
+    }
+
+    private static boolean isAppDirContainer(String path, int start, int end) {
+        for (String container : APP_DIR_CONTAINERS) {
+            if (segmentEquals(path, start, end, container)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Returns the index where the volume-relative path starts, {@code path.length()} for a volume
+     * root, or -1 if {@code path} is not on a shared-storage volume.
+     */
+    private static int relativePathStart(String path) {
+        if (startsWithIgnoreCase(path, 0, "/storage/")) {
+            return afterVolume(path, "/storage/".length(), true);
+        }
+        if (startsWithIgnoreCase(path, 0, "/sdcard")) {
+            return afterRoot(path, "/sdcard".length());
+        }
+        if (startsWithIgnoreCase(path, 0, "/mnt/user/")
+                || startsWithIgnoreCase(path, 0, "/mnt/pass_through/")) {
+            final int user = path.indexOf('/', 5) + 1;
+            final int userEnd = segmentEnd(path, user);
+            if (!isDigits(path, user, userEnd) || userEnd >= path.length()) {
+                return -1;
+            }
+            return afterVolume(path, userEnd + 1, false);
+        }
+        if (startsWithIgnoreCase(path, 0, "/mnt/media_rw/")) {
+            final int start = "/mnt/media_rw/".length();
+            final int end = segmentEnd(path, start);
+            return end > start ? afterRoot(path, end) : -1;
+        }
+        if (startsWithIgnoreCase(path, 0, "/data/media/")) {
+            final int start = "/data/media/".length();
+            final int end = segmentEnd(path, start);
+            return isDigits(path, start, end) ? afterRoot(path, end) : -1;
+        }
+        return -1;
+    }
+
+    /** Parses {@code emulated/<user>}, {@code self/primary} or {@code <volume>} at {@code start}. */
+    private static int afterVolume(String path, int start, boolean allowSelf) {
+        final int end = segmentEnd(path, start);
+        if (end <= start) {
+            return -1;
+        }
+        if (end - start == "emulated".length()
+                && path.regionMatches(true, start, "emulated", 0, end - start)) {
+            if (end >= path.length()) {
+                return -1;
+            }
+            final int userEnd = segmentEnd(path, end + 1);
+            return isDigits(path, end + 1, userEnd) ? afterRoot(path, userEnd) : -1;
+        }
+        if (allowSelf && end - start == "self".length()
+                && path.regionMatches(true, start, "self", 0, end - start)) {
+            if (end >= path.length()) {
+                return -1;
+            }
+            final int primaryEnd = segmentEnd(path, end + 1);
+            return segmentEquals(path, end + 1, primaryEnd, "primary")
+                    ? afterRoot(path, primaryEnd) : -1;
+        }
+        return afterRoot(path, end);
+    }
+
+    /** {@code rootEnd} is the end of the volume root; returns where the relative path starts. */
+    private static int afterRoot(String path, int rootEnd) {
+        if (rootEnd >= path.length()) {
+            return path.length();
+        }
+        return path.charAt(rootEnd) == '/' ? rootEnd + 1 : -1;
+    }
+
+    /** Collapses empty, "." and ".." segments; returns {@code path} itself if there are none. */
+    static String normalize(String path) {
+        if (path == null || path.isEmpty() || path.charAt(0) != '/') {
+            return null;
+        }
+        if (path.indexOf("//") < 0 && path.indexOf("/./") < 0 && path.indexOf("/../") < 0
+                && !path.endsWith("/.") && !path.endsWith("/..")) {
+            return path;
+        }
+        final ArrayList<String> segments = new ArrayList<>();
+        for (String segment : path.split("/")) {
+            if (segment.isEmpty() || segment.equals(".")) {
+                continue;
+            }
+            if (segment.equals("..")) {
+                if (!segments.isEmpty()) {
+                    segments.remove(segments.size() - 1);
+                }
+                continue;
+            }
+            segments.add(segment);
+        }
+        return "/" + String.join("/", segments);
+    }
+
+    private static int segmentEnd(String path, int start) {
+        final int slash = path.indexOf('/', start);
+        return slash < 0 ? path.length() : slash;
+    }
+
+    private static int trimmedEnd(String path, int start, int end) {
+        while (end > start && (path.charAt(end - 1) == '.' || path.charAt(end - 1) == ' ')) {
+            end--;
+        }
+        return end;
+    }
+
+    private static boolean segmentEquals(String path, int start, int end, String name) {
+        boolean ascii = true;
+        for (int i = start; i < end; i++) {
+            final char c = path.charAt(i);
+            if (c > 0x7e) {
+                // Only these fold to ASCII letters or vanish, so other names skip folding.
+                if (!(c == 0x212A || c == 0x017F || c == 0x0131 || (c >= 0xFB00 && c <= 0xFB06)
+                        || Character.isSurrogate(c) || isDefaultIgnorable(c))) {
+                    return false;
+                }
+                ascii = false;
+            }
+        }
+        if (!ascii) {
+            return foldName(path.substring(start, end)).equals(name.toLowerCase(Locale.ROOT));
+        }
+        end = trimmedEnd(path, start, end);
+        return end - start == name.length() && path.regionMatches(true, start, name, 0,
+                name.length());
+    }
+
+    private static boolean startsWithIgnoreCase(String path, int start, String prefix) {
+        return path.regionMatches(true, start, prefix, 0, prefix.length());
+    }
+
+    private static boolean isDigits(String path, int start, int end) {
+        if (end <= start) {
+            return false;
+        }
+        for (int i = start; i < end; i++) {
+            final char c = path.charAt(i);
+            if (c < '0' || c > '9') {
+                return false;
+            }
+        }
+        return true;
+    }
+}
