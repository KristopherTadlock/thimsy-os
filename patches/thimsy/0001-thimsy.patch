+// The kernel escapes space, tab, newline and backslash in mountinfo paths as three octal digits.
+static std::string unescapeMountPath(const char* p, size_t n) {
+    std::string out;
+    out.reserve(n);
+    for (size_t i = 0; i < n; i++) {
+        if (p[i] == '\\' && i + 3 < n && p[i + 1] >= '0' && p[i + 1] <= '3' &&
+            p[i + 2] >= '0' && p[i + 2] <= '7' && p[i + 3] >= '0' && p[i + 3] <= '7') {
+            out.push_back(static_cast<char>((p[i + 1] - '0') * 64 + (p[i + 2] - '0') * 8 +
+                                            (p[i + 3] - '0')));
+            i += 3;
+        } else {
+            out.push_back(p[i]);
+        }
+    }
+    return out;
