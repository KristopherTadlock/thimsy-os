+// Thimsy: a monitor in mirror mode shows the panel's frame. The layers are composed as for the panel,
+// at the layer stack's own size (the panel's pixels, with any composition shader), and that frame is
+// scaled sharp bilinear into the monitor's projection, which DisplayManagerService fits to it. Both
+// passes run in this frame on the GPU, so the monitor is at most one of its frames behind the panel.
+FenceResult Output::composeThimsyMirror(renderengine::RenderEngine& renderEngine,
+                                        const renderengine::DisplaySettings& display,
+                                        const std::vector<renderengine::LayerSettings>& layers,
+                                        const std::shared_ptr<renderengine::ExternalTexture>& tex,
+                                        base::unique_fd&& fd) {
+    const Rect content = getState().layerStackSpace.getContent();
+    const int32_t w = content.getWidth();
+    const int32_t h = content.getHeight();
+    renderengine::DisplaySettings direct = display;   // the fallback: the layers straight on
+    direct.thimsyMirrorPass = false;
+    if (w <= 0 || h <= 0) {
+        return renderEngine.drawLayers(direct, layers, tex, std::move(fd)).get();
+    }
+    const PixelFormat format = tex->getBuffer()->getPixelFormat();
+    if (!mThimsyMirrorFrame || mThimsyMirrorFrame->getWidth() != static_cast<uint32_t>(w) ||
+        mThimsyMirrorFrame->getHeight() != static_cast<uint32_t>(h) ||
+        mThimsyMirrorFrame->getBuffer()->getPixelFormat() != format) {
+        mThimsyMirrorFrame.reset();
+        const auto buffer =
+                sp<GraphicBuffer>::make(static_cast<uint32_t>(w), static_cast<uint32_t>(h), format,
+                                        1U,
+                                        static_cast<uint64_t>(GraphicBuffer::USAGE_HW_RENDER |
+                                                              GraphicBuffer::USAGE_HW_TEXTURE),
+                                        "ThimsyMirror");
+        if (buffer->initCheck() != NO_ERROR) {
+            ALOGE("ThimsyMirror: no %dx%d buffer; composing the monitor directly", w, h);
+            return renderEngine.drawLayers(direct, layers, tex, std::move(fd)).get();
+        }
+        mThimsyMirrorFrame = std::make_shared<renderengine::impl::ExternalTexture>(
+                buffer, renderEngine,
+                renderengine::impl::ExternalTexture::Usage::READABLE |
+                        renderengine::impl::ExternalTexture::Usage::WRITEABLE);
+    }
+
+    renderengine::DisplaySettings panel = display;
+    panel.physicalDisplay = Rect(w, h);
+    panel.orientation = ui::Transform::ROT_0;
+    panel.thimsyMirrorPass = false;
+    panel.thimsyMirrorReplay = true;
+    auto frame = renderEngine.drawLayers(panel, layers, mThimsyMirrorFrame, base::unique_fd()).get();
+    if (!frame.ok()) {
+        return frame;
+    }
