+TEST(ScummvmList, SyncDirKeepsTheFolderToTheList) {
+    TempDir t("scummvmlist");
+    const std::string dir = t / "org.scummvm.scummvm/scummvm";
+    ASSERT_TRUE(syncDir(dir, {game("sky", "sky", "Beneath a Steel Sky (CD/DOS/English)"),
