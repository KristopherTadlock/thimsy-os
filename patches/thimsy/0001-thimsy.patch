+// A Quick Menu action row (PS3_QUICK, dispatched by its QA_ code).
+NanoMenu::Ps3Item NanoMenu::quickActionItem(const char* label, int action, int icon) {
+    Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = action;
+    // The flat mono icon too (as makeDataItem sets), so the DSi carousel draws these flat like
+    // every other row; the XMB keeps the glass nmap.
+    it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon);
+    it.iconR = it.iconG = it.iconB = 1.0f;
+    return it;
+}
+
+// A Quick Menu settings row bound to a kPs3Bindings entry (A opens its chooser), named after the
+// GammaOS Quick Settings tile that drives the same setting. A tile the device blacklists for
+// Android's shade (persist.gammaos.qs.blacklist) is left out here too.
+void NanoMenu::quickLeafItem(std::vector<Ps3Item>& out, const char* label, const char* bindLabel,
+                             int icon, const char* spec, const char* desc) {
+    if (qsTileHidden(spec)) return;
+    Ps3Item it; it.label = label; it.kind = PS3_DATA_LEAF; it.action = 1;
+    it.binding = ps3BindingFor(bindLabel ? bindLabel : label);
+    if (it.binding) it.value = resolvePs3ItemValue(it);
+    if (desc) it.desc = desc;
+    it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon);
+    it.iconR = it.iconG = it.iconB = 1.0f;
+    out.push_back(it);
+}
+
+// The Quick Menu's rows. Kiosk Mode is the last row, or the first while it is on.
+void NanoMenu::buildQuickMenuItems(std::vector<Ps3Item>& out) {
+    out.clear();
+    const std::string kioskDesc =
+        fnText("Start opens Applications instead of the ES-DE menu, and Select does nothing in a game list. "
+               "Turning it on also turns %s Button Opens Quick Menu back on.");
+    const bool kiosk = kioskMode();
+    if (kiosk) quickLeafItem(out, "Kiosk Mode (ON)", "Kiosk Mode", 5, "kiosk", kioskDesc.c_str());
+    out.push_back(quickActionItem("Power", QA_POWER_SUBMENU, 54));
+    // Resume Audio Player: only while music plays in the background (musicTick rebuilds the
+    // categories as it starts and stops).
+    if (mMusicResumeShown) out.push_back(quickActionItem("Resume Audio Player", QA_RESUME_AUDIO, 3));
+    // Close Current App acts on the foreground app: only over a running app, never at the home.
+    if (quickAppBehind()) out.push_back(quickActionItem("Close Current App", QA_CLOSE_APP, 83));
+    // Dual screen: the app on the built-in screen.
+    // A move never closes what is on the other screen: offered only where that screen is free.
+    if (!mPanelApp.empty()) {
+        if (panelPinAllowed())
+            out.push_back(quickActionItem("Use Built-in Screen App", QA_PANEL_APP_FOCUS, 83));
+        if (!quickAppBehind())
+            out.push_back(quickActionItem("Move Built-in Screen App to Monitor", QA_PANEL_APP_TO_MONITOR, 83));
+        out.push_back(quickActionItem("Close Built-in Screen App", QA_PANEL_APP_CLOSE, 83));
+    }
+    if (mDualPanel && mPanelApp.empty() && quickAppBehind() && !mOverlayPausedPkg.empty() && !gameOnMonitor())
+        out.push_back(quickActionItem("Move Current App to Built-in Screen", QA_APP_TO_PANEL, 83));
+    if (!qsTileHidden("gammashader")) out.push_back(quickActionItem("Global Shaders", QA_SHADER_MENU, 16));
+    out.push_back(quickActionItem("Notifications", QA_NOTIFICATIONS, 71));
+    quickLeafItem(out, "Wi-Fi",     nullptr, 85, "internet");
+    quickLeafItem(out, "Bluetooth", nullptr, 86, "bt");
+    out.push_back(quickActionItem("Display",    QA_DISPLAY_MENU,    73));
+    out.push_back(quickActionItem("Device",     QA_DEVICE_MENU,     81));
+    out.push_back(quickActionItem("Controller", QA_CONTROLLER_MENU,  5));
+    if (!kiosk) quickLeafItem(out, "Kiosk Mode", nullptr, 5, "kiosk", kioskDesc.c_str());
+    // Seed the cached Performance Mode row value from the persisted governor prop.
+    { char pm[PROPERTY_VALUE_MAX]; property_get("persist.gammaos.performance_mode", pm, "stock");
+      mPs3PerfModeLabel = !strcmp(pm, "max") ? "Max Performance"
+                        : (!strcmp(pm, "powersave") ? "Power Saver" : "Normal"); }
+}
+
+// The Quick Menu is over an app (launched_pkg set), not the home.
+bool NanoMenu::quickAppBehind() const {
+    // The overlay is also the home once an app has run, with launched_pkg still naming that app:
+    // app_launched says whether one is behind it now.
+    if (!mOverlayMode || !property_get_bool("sys.gammaos.nano.app_launched", false)) return false;
+    char lp[PROPERTY_VALUE_MAX] = {};
+    property_get("sys.gammaos.nano.launched_pkg", lp, "");
+    return lp[0] != 0;
+}
+
+// Quick Menu > Display.
+void NanoMenu::buildQuickDisplaySubmenu(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Display";
+    out.items.push_back(quickActionItem("Screen Brightness", QA_BRIGHTNESS, 73));
+    if (quickAppBehind()) out.items.push_back(quickActionItem("Screen Orientation", QA_APP_ORIENT_MENU, 70));
+    // The External Display submenu of Settings > Display Settings, the same rows.
+    for (const Ps3DataItem& d : kDisplayCh)
+        if (!strcmp(d.name, "External Display")) out.items.push_back(makeDataItem(&d, "settings/Display Settings/"));
+}
+
+// The release this device runs: "Thimsy " + ro.thimsy.version, then ro.thimsy.release when the build
+// was given one ("test 39"); both are set by the build's version mod (mods/05-version.sh). Empty
+// on a system that isn't Thimsy.
+static std::string thimsyReleaseName() {
+    char ver[PROPERTY_VALUE_MAX], rel[PROPERTY_VALUE_MAX];
+    property_get("ro.thimsy.version", ver, "");
+    if (!ver[0]) return std::string();
+    property_get("ro.thimsy.release", rel, "");
+    std::string name = std::string("Thimsy ") + ver;
+    if (rel[0]) name += std::string(" ") + rel;
+    return name;
+}
+
+// The LineageOS version the system is built on ("LineageOS 21.0"): ro.lineage.build.version, else
+// the leading version of a stock ro.lineage.version ("21.0-20261002-UNOFFICIAL-arm64_bgN"); GammaOS
+// and Thimsy rename ro.lineage.version, so that one counts only when it starts with a digit.
+static std::string lineageVersionName() {
+    char v[PROPERTY_VALUE_MAX];
+    property_get("ro.lineage.build.version", v, "");
+    std::string ver = v;
+    if (ver.empty()) {
+        property_get("ro.lineage.version", v, "");
+        if (isdigit((unsigned char)v[0])) { ver = v; ver = ver.substr(0, ver.find('-')); }
+    }
+    return ver.empty() ? std::string() : "LineageOS " + ver;
+}
+
+// Quick Menu > Device.
+void NanoMenu::buildQuickDeviceSubmenu(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Device";
+    out.items.push_back(quickActionItem("Performance Mode", QA_PERFORMANCE, 81));
+    quickLeafItem(out.items, "Fan Speed", nullptr,     81, "fan");
+    quickLeafItem(out.items, "RGB",       "Effect",    80, "gammargb");
+    quickLeafItem(out.items, "EQ",        "Enable EQ", 17, "gammaeq");
+    // Quick Resume's On/Off value is resolved live from mQuickResumeEnabled (resolvePs3ItemValue).
+    Ps3Item qr = quickActionItem("Quick Resume", QA_QUICK_RESUME_TOGGLE, 8);
+    qr.desc = "Saves your game when you power off or restart, and resumes it automatically on the next boot.";
+    out.items.push_back(qr);
+    quickLeafItem(out.items, "Deep Sleep Mode", "Ultra Low Power Saving", 89, "deepsleepmode");
+    // Last, what this device runs, so a report can name the build: the release ("Thimsy 1.0a test 39"),
+    // the LineageOS version under it and the Thimsy commit it was built from (ro.thimsy.commit).
+    const std::string release = thimsyReleaseName();
+    if (!release.empty()) out.items.push_back(quickActionItem(release.c_str(), QA_INFO_ROW, 22));
+    const std::string lineage = lineageVersionName();
+    if (!lineage.empty()) out.items.push_back(quickActionItem(lineage.c_str(), QA_INFO_ROW, 22));
+    char commit[PROPERTY_VALUE_MAX];
+    property_get("ro.thimsy.commit", commit, "");
+    if (commit[0]) out.items.push_back(quickActionItem(ps3Fmt(trDyn("Commit %s"), commit).c_str(), QA_INFO_ROW, 22));
+}
