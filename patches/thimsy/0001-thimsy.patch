+SysCore core(const char* id, const char* coreSo, bool builtin = true) {
+    SysCore s;
+    s.id = id;
+    s.romDir = id;
+    s.builtin = builtin;
+    s.libretro = true;
+    s.coreSo = coreSo;
+    return s;
+}
