+            return heldMs < SHARED_BACK_MENU_MS ? BACK_RELEASE_QUICK_MENU : BACK_RELEASE_NOTHING;
+        }
+        return heldMs < RECOVERY_HOLD_MS ? BACK_RELEASE_BACK : BACK_RELEASE_NOTHING;
+    }
