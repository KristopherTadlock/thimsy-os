+package com.android.providers.media.util;
+
+import static com.android.providers.media.util.ThimsyStorageDenylist.NO_OWNER;
+import static com.android.providers.media.util.ThimsyStorageDenylist.getProtectedOwner;
+import static com.android.providers.media.util.ThimsyStorageDenylist.isAppDirContainer;
+import static com.android.providers.media.util.ThimsyStorageDenylist.isOwnerPackage;
