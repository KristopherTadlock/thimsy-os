+// A motion sensor exposed as an input device streams events (hundreds a second) that the menu does
+// not act on, so the idle wait leaves it out.
+static bool inputIsMotionSensor(int fd) {
+    constexpr size_t kBits = 8 * sizeof(unsigned long);
+    unsigned long props[(INPUT_PROP_CNT + kBits - 1) / kBits] = {};
+    return ioctl(fd, EVIOCGPROP(sizeof(props)), props) >= 0
+           && ((props[INPUT_PROP_ACCELEROMETER / kBits] >> (INPUT_PROP_ACCELEROMETER % kBits)) & 1UL) != 0;
+}
+
+// Waits up to ms for input (every input fd but motion sensors, the hotplug inotify) or a frame request
+// (FrameFlag's eventfd, any thread; a property change also nudges it). seenSeq is the request count the
+// caller decided on: one made since returns at once. Returns 1 input, 2 a frame request, 3 the timeout,
+// 6 a nudge. A device that reports an error or hang-up is left out until hotplug closes it.
+int NanoMenu::idleWait(int ms, uint32_t seenSeq) {
+    static const int efd = [] {
+        const int fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+        if (fd >= 0) FrameFlag::sWakeFd.store(fd, std::memory_order_relaxed);
+        // Any property change wakes the loop (no frame by itself), for the hooks it polls each pass:
+        // the scripted nav, AVRCP media keys, the external-display raise, boot and storage state.
+        std::thread([] {
+            nanoThreadNormalPriority();
+            uint32_t serial = 0;   // the first wait returns the current global serial at once
+            for (;;) {
+                uint32_t next = serial;
+                if (!__system_property_wait(nullptr, serial, &next, nullptr)) { usleep(250000); continue; }
+                if (next == serial) continue;
+                if (serial != 0) FrameFlag::nudge();
+                serial = next;
+            }
+        }).detach();
+        return fd;
+    }();
+    // Drained before re-arming: re-armed first, a wake landing between the two would be read here
+    // and leave the flag armed, so no later wake would write until the next call. A wake or nudge
+    // landing between them finds the flag armed and skips its write: the counts catch it.
+    const uint32_t nudges = FrameFlag::nudges();
+    if (efd >= 0) { uint64_t v; ssize_t n = read(efd, &v, sizeof(v)); (void)n; }
+    FrameFlag::rearm();
+    if (FrameFlag::seq() != seenSeq) return 2;
+    if (FrameFlag::nudges() != nudges) return 6;
+    for (auto it = mPollSkipFd.begin(); it != mPollSkipFd.end(); )
+        it = std::find(mInputFds.begin(), mInputFds.end(), it->first) == mInputFds.end() ? mPollSkipFd.erase(it) : std::next(it);
+    struct pollfd pfds[66];
+    int nf = 0;
+    for (int fd : mInputFds) {
+        if (fd < 0 || nf >= 63) continue;
+        auto sk = mPollSkipFd.find(fd);
+        if (sk == mPollSkipFd.end()) sk = mPollSkipFd.emplace(fd, inputIsMotionSensor(fd)).first;
+        if (sk->second) continue;
+        pfds[nf].fd = fd; pfds[nf].events = POLLIN; pfds[nf].revents = 0; nf++;
+    }
+    if (mInotifyFd >= 0) { pfds[nf].fd = mInotifyFd; pfds[nf].events = POLLIN; pfds[nf].revents = 0; nf++; }
+    const int evIdx = nf;
+    if (efd >= 0) { pfds[nf].fd = efd; pfds[nf].events = POLLIN; pfds[nf].revents = 0; nf++; }
+    if (nf == 0) { usleep((useconds_t)ms * 1000); return 3; }
+    const int r = poll(pfds, nf, ms);
+    if (r <= 0) return 3;
+    bool input = false;
+    for (int i = 0; i < evIdx; i++) {
+        // Checked before POLLIN: a removed node with events still queued reports both, and its reads
+        // fail, so it would wake every wait until hotplug closes it.
+        if ((pfds[i].revents & (POLLERR | POLLHUP | POLLNVAL)) && pfds[i].fd != mInotifyFd)
+            mPollSkipFd[pfds[i].fd] = true;
+        else if (pfds[i].revents & POLLIN) input = true;
+    }
+    if (input) return 1;
+    if (efd < 0 || !(pfds[evIdx].revents & POLLIN)) return 3;
+    return FrameFlag::seq() != seenSeq ? 2 : 6;
+}
+
+// Sleeps out the rest of a slowed frame. Only real activity ends it early: a frame request, or input
+// that pollInput (run here, so the wait goes on) found to be user activity. A nudge (any property
+// change, constant during boot) or stick noise, triggers and pad touchpads would otherwise pace the
+// frames at their own rate. Ended early, the frame still lasts at least 16 ms.
+void NanoMenu::paceWait(int ms) {
+    const int64_t start = (int64_t)android::uptimeMillis();
+    const int64_t end = start + ms, minEnd = mLastFrameNs / 1000000 + 16;   // both CLOCK_MONOTONIC
+    const uint32_t seq = FrameFlag::seq();
+    const int64_t inputMs = mLastInputMs;
+    for (;;) {
+        const int64_t now = (int64_t)android::uptimeMillis();
+        if (now >= end) return;
+        const int r = idleWait((int)(end - now), seq);
+        if (r == 1) pollInput();
+        if (r == 2 || FrameFlag::seq() != seq || mLastInputMs != inputMs || mTouchDown) {
+            const int64_t rest = std::min(end, minEnd) - (int64_t)android::uptimeMillis();
+            if (rest > 0) usleep((useconds_t)rest * 1000);
+            return;
+        }
+    }
+}
