+// The button map in drastic-nano (button_map_overlay_plan.md phase 5): Anbernic + the Button Map
+// Button shows how the pad maps onto the DS, drawn by Nano's NanoButtonMapArt into one texture over
+// the game. It does not pause: the game keeps running while the pad goes to the map instead
+// (main.cpp polls the input as for a menu, and drives no menu).
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace android {
+namespace drastic_gfx { class OverlayGfx; }
+namespace drastic_input { struct InputActions; }
+namespace drastic_nano {
+
+class ButtonMapOverlay {
+public:
+    ButtonMapOverlay();
+    ~ButtonMapOverlay();
+    bool isOpen() const;
+    // Opens the map for the running game (romPath: its per-game override), w x h the overlay's pixels.
+    // False when there is nothing to show.
+    bool open(const std::string& romPath, int w, int h);
+    void close();
+    // The pad while the map is up (the actions of a menu poll): D-pad and stick move, L1 / R1 page,
+    // B, Start, Back or the chord again close. True when the map closed.
+    bool onActions(const drastic_input::InputActions& a);
+    // A finger on the touchscreen (InputState's touchReal and touchDs): a drag scrolls with a fling,
+    // a swipe across changes section, and where the touchscreen shows the map (tapCloses) a tap
+    // outside the panel closes it. True when the map closed.
+    bool onTouch(bool down, int dsX, int dsY, bool tapCloses);
+    // Draws the panel; call between gfx.beginFrame() and gfx.endFrame().
+    void draw(drastic_gfx::OverlayGfx& gfx);
+    // The texture is the GL context's: drop it before the context goes.
+    void releaseGl(drastic_gfx::OverlayGfx& gfx);
+
+    struct State;
+
+private:
+    std::unique_ptr<State> mS;
+};
+
+}  // namespace drastic_nano
+}  // namespace android
