+    k("dpad-right", {Input::axis(aaxis::kHatX, 1), Input::axis(aaxis::kX, 1)});
+    k("dpad-up", {Input::axis(aaxis::kHatY, -1), Input::axis(aaxis::kY, -1)});
+    k("dpad-down", {Input::axis(aaxis::kHatY, 1), Input::axis(aaxis::kY, 1)});
