+// Two hotkeys cannot share a button: the one that had the button takes this one's old button. The
+// rows are compared as the buttons they name (Button Map's Bottom is the hotkeys' A with gammapad off).
+void NanoMenu::hotkeyTakeButton(const Ps3SettingBinding* b, const std::string& v) {
+    static const char* const kRows[] = {"Save State Button", "Load State Button", "Fast Forward Button",
+                                        "Rewind Button", "Quit Game Button", "Button Map Button",
+                                        "Switch Screen Button"};
+    const auto at = std::find_if(std::begin(kRows), std::end(kRows), [&](const char* r) { return !strcmp(r, b->label); });
+    if (at == std::end(kRows) || v == "NONE") return;
+    std::vector<bmap::ButtonRow> rows;
+    for (const char* r : kRows) {
+        const Ps3SettingBinding* o = ps3BindingFor(r);
+        rows.push_back({o ? readSettingValue(o->source, o->key, o->def) : std::string("NONE"),
+                        !strcmp(r, "Button Map Button") || !strcmp(r, "Switch Screen Button")});
+    }
+    for (const auto& take : nanoBmapTakeButton(rows, (int)(at - std::begin(kRows)), v)) {
+        const Ps3SettingBinding* o = ps3BindingFor(kRows[take.first]);
+        if (!o) continue;
+        writeSettingValue(o->source, o->key, take.second);
+        mPs3BindCache.erase(o->label);
+    }
+}
