+    private ThimsyDeviceKeys(String id, String name, List<Key> function, List<Key> back,
+            boolean sharedBack) {
+        this.id = id;
+        this.name = name;
+        this.function = Collections.unmodifiableList(function);
+        this.back = Collections.unmodifiableList(back);
+        this.sharedBack = sharedBack && !back.isEmpty();
+    }
