+        keys.add(new Key("Mode", 316, "BUTTON_MODE", false));
+        return keys;
+    }
+
+    private static List<Key> builtinBack() {
+        List<Key> keys = new ArrayList<>();
+        keys.add(new Key("Back", 158, "BACK", false));
+        return keys;
+    }
