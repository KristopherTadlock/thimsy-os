-                                 0.90f, 0.90f, 0.92f, 1.0f, warnBlur, /*waveSpace=*/true);
-            else
-                drawQuad(0.0f, 0.0f, (float)mWidth, (float)mHeight, 0.0f, 0.0f, 0.0f, 0.55f * warnBlur);
-        }
-    }
