+    constexpr nsecs_t kStale = ms2ns(3000);
+    const nsecs_t now = systemTime();
+    auto stale = [&](PhysicalDisplayId id) REQUIRES(mGammaVsyncMutex) {
+        const auto enabled = mGammaVsyncEnabledAt.find(id);
+        if (enabled == mGammaVsyncEnabledAt.end()) return false;
+        nsecs_t since = enabled->second;
+        if (const auto last = mGammaLastHwVsync.find(id); last != mGammaLastHwVsync.end()) {
+            since = std::max(since, last->second);
