+// The bottom digitizer's contacts (Type-B slots): a gesture a second finger joins taps, swipes and
+// drags nothing.
+constexpr int kCcSlots = 5;
+int  sCcSlot = 0;
+int  sCcIds[kCcSlots] = { -1, -1, -1, -1, -1 };
+bool sCcMulti = false;
+bool sCcDropped = false;   // a SYN_DROPPED: the rest of the packet is skipped, then the device is read
+void ccResetContacts() {
+    sCcSlot = 0; sCcMulti = false; sCcDropped = false;
+    for (int& id : sCcIds) id = -1;
+}
+// Reads the contacts from the device; true when any is down.
+bool ccReadContacts(int fd) {
+    ccResetContacts();
+    struct { uint32_t code; int32_t v[kCcSlots]; } mt;
+    mt.code = ABS_MT_TRACKING_ID;
+    std::fill(mt.v, mt.v + kCcSlots, -1);
+    if (ioctl(fd, EVIOCGMTSLOTS(sizeof(mt)), &mt) >= 0) std::copy(mt.v, mt.v + kCcSlots, sCcIds);
+    struct input_absinfo a{};
+    if (ioctl(fd, EVIOCGABS(ABS_MT_SLOT), &a) >= 0) sCcSlot = a.value;
+    constexpr size_t kBits = 8 * sizeof(unsigned long);
+    unsigned long keys[(KEY_MAX + kBits) / kBits] = {};
+    bool down = ioctl(fd, EVIOCGKEY(sizeof(keys)), keys) >= 0
+                && ((keys[BTN_TOUCH / kBits] >> (BTN_TOUCH % kBits)) & 1UL) != 0;
+    if (!down) for (int& id : sCcIds) id = -1;
+    int n = 0;
+    for (int id : sCcIds) n += id >= 0;
+    sCcMulti = n >= 2;
+    return down;
+}
