+    private static int getThimsyPlacementMode(@Nullable String path) {
+        if (path == null || (ThimsyStorageDenylist.getProtectedOwner(path) == null
+                && ThimsyStorageDenylist.getAmbiguousFolder(path) == null)) {
+            return THIMSY_CREATE;
