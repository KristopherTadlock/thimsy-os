+        for (const auto& r : repairs) {
+            XmbSystem& s = mXmbSystems[r.index];
+            ALOGW("NanoMenu: system %s named Nano's own core %s, which is not installed; now the build's %s",
+                  s.id.c_str(), s.coreSo.c_str(), r.coreSo.c_str());
