--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/nano_test_util.h
@@ -0,0 +1,36 @@
+// Shared helpers for the Nano host tests.
+#pragma once
+
+#include <limits.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <string>
+
+namespace nanotest {
+
+// The checked-in fixtures. Soong installs `data` next to the test binary, keeping the path relative
+// to the module directory (<bin dir>/test/fixtures); NANO_TEST_FIXTURES overrides it for a binary
+// run from somewhere else.
+inline std::string fixtureDir() {
+    if (const char* env = getenv("NANO_TEST_FIXTURES")) return env;
+    char exe[PATH_MAX];
+    const ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (n <= 0) return "test/fixtures";
+    exe[n] = '\0';
+    std::string dir(exe);
+    dir.resize(dir.find_last_of('/'));
+    return dir + "/test/fixtures";
+}
+
+inline std::string fixture(const std::string& rel) { return fixtureDir() + "/" + rel; }
+
+// A fresh, empty directory under $TMPDIR (or /tmp), removed by the caller if it cares.
+inline std::string makeTempDir(const char* tag) {
+    const char* base = getenv("TMPDIR");
+    std::string t = std::string(base && *base ? base : "/tmp") + "/nano_" + tag + "_XXXXXX";
+    if (!mkdtemp(&t[0])) return std::string();
+    return t;
+}
+
+}  // namespace nanotest
diff --git a/frameworks/base/cmds/gammaos-nano/test/unit/nano_test_zip.h b/frameworks/base/cmds/gammaos-nano/test/unit/nano_test_zip.h
new file mode 100644
index 00000000000..8040178d45b
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/test/unit/nano_test_zip.h
@@ -0,0 +1,79 @@
+// Builds small zip archives in memory for the Nano parser tests (stored or raw-deflated members,
+// with the directory fields overridable so a test can lie about sizes and CRCs).
+#pragma once
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <zlib.h>
+
+#include <string>
+#include <vector>
+
+namespace nanotest {
+
+struct ZipMember {
+    std::string name;
+    std::vector<uint8_t> data;
+    int method = 0;          // 0 stored, 8 deflated
+    bool fakeCrc = false;    // use crc below instead of the real one
+    uint32_t crc = 0;
+};
+
+inline void put16(std::vector<uint8_t>& v, size_t at, uint16_t x) { v[at] = (uint8_t)x; v[at + 1] = (uint8_t)(x >> 8); }
+inline void put32(std::vector<uint8_t>& v, size_t at, uint32_t x) {
+    for (int i = 0; i < 4; i++) v[at + i] = (uint8_t)(x >> (8 * i));
+}
+
+inline std::vector<uint8_t> rawDeflate(const std::vector<uint8_t>& in) {
+    z_stream zs{};
+    deflateInit2(&zs, 1, Z_DEFLATED, -MAX_WBITS, 8, Z_DEFAULT_STRATEGY);   // fast: the 24 MB cap test deflates 48 MB
+    std::vector<uint8_t> out(deflateBound(&zs, in.size()));
+    zs.next_in = const_cast<Bytef*>(in.data());
+    zs.avail_in = (uInt)in.size();
+    zs.next_out = out.data();
+    zs.avail_out = (uInt)out.size();
+    deflate(&zs, Z_FINISH);
+    out.resize(zs.total_out);
+    deflateEnd(&zs);
+    return out;
+}
+
+inline std::vector<uint8_t> makeZip(const std::vector<ZipMember>& members) {
+    std::vector<uint8_t> z, cd;
+    for (const auto& m : members) {
+        const std::vector<uint8_t> data = m.method == 8 ? rawDeflate(m.data) : m.data;
+        const uint32_t crc = m.fakeCrc ? m.crc : (uint32_t)crc32(0, m.data.data(), (uInt)m.data.size());
+        const uint16_t nl = (uint16_t)m.name.size();
+        const uint32_t lho = (uint32_t)z.size();
+        std::vector<uint8_t> lh(30 + nl, 0);
+        put32(lh, 0, 0x04034b50); put16(lh, 8, (uint16_t)m.method); put32(lh, 14, crc);
+        put32(lh, 18, (uint32_t)data.size()); put32(lh, 22, (uint32_t)m.data.size()); put16(lh, 26, nl);
+        memcpy(&lh[30], m.name.data(), nl);
+        z.insert(z.end(), lh.begin(), lh.end());
+        z.insert(z.end(), data.begin(), data.end());
+        std::vector<uint8_t> c(46 + nl, 0);
+        put32(c, 0, 0x02014b50); put16(c, 10, (uint16_t)m.method); put32(c, 16, crc);
+        put32(c, 20, (uint32_t)data.size()); put32(c, 24, (uint32_t)m.data.size()); put16(c, 28, nl);
+        put32(c, 42, lho);
+        memcpy(&c[46], m.name.data(), nl);
+        cd.insert(cd.end(), c.begin(), c.end());
+    }
+    const uint32_t cdOff = (uint32_t)z.size();
+    z.insert(z.end(), cd.begin(), cd.end());
+    std::vector<uint8_t> e(22, 0);
+    put32(e, 0, 0x06054b50); put16(e, 8, (uint16_t)members.size()); put16(e, 10, (uint16_t)members.size());
+    put32(e, 12, (uint32_t)cd.size()); put32(e, 16, cdOff);
+    z.insert(z.end(), e.begin(), e.end());
+    return z;
+}
+
+inline bool writeFile(const std::string& path, const void* data, size_t n) {
+    FILE* f = fopen(path.c_str(), "wb");
+    if (!f) return false;
+    const bool ok = fwrite(data, 1, n, f) == n;
+    return fclose(f) == 0 && ok;
+}
+inline bool writeFile(const std::string& path, const std::vector<uint8_t>& d) { return writeFile(path, d.data(), d.size()); }
+
+}  // namespace nanotest
diff --git a/frameworks/base/cmds/gammaos-nano/thimsy-dexopt.sh b/frameworks/base/cmds/gammaos-nano/thimsy-dexopt.sh
new file mode 100644
index 00000000000..aae161013af
--- /dev/null
+++ b/frameworks/base/cmds/gammaos-nano/thimsy-dexopt.sh
@@ -0,0 +1,29 @@
+#!/system/bin/sh
+# Compiles the apps setup installed (setup.sh installs them without dexopt to keep setup short).
+# Emulators and games are compiled ahead of time in full ("speed"), so they start without
+# interpreting or verifying their code at launch; every other installed app gets "verify". Runs
+# once, at background priority, a minute after a boot that follows a completed setup.
+
+[ "$(getprop persist.thimsy.dexopt_done)" = 1 ] && exit 0
+[ -e /data/setupcompleted ] || exit 0
+sleep 60
+
+SPEED="com.retroarch.aarch64 org.ppsspp.ppsspp com.flycast.emulator org.dolphinemu.dolphinemu
+com.armsx2 org.azahar_emu.azahar org.vita3k.emulator org.mupen64plusae.v3.fzurita
+org.scummvm.scummvm com.dsemu.drastic me.magnum.melondualds com.seedlessds.app com.rfandango.haku_x
+com.shatteredpixel.shatteredpixeldungeon"
+
+installed=$(pm list packages -3 2>/dev/null | sed 's/^package://')
+[ -n "$installed" ] || exit 0
+failed=0
+for pkg in $installed; do
+    filter=verify
+    for s in $SPEED; do [ "$pkg" = "$s" ] && filter=speed; done
+    out=$(cmd package compile -r bg-dexopt -m "$filter" "$pkg" 2>&1)
+    case "$out" in
+        *Success*) log -t thimsy-dexopt "$pkg: $filter" ;;
+        *) log -t thimsy-dexopt "$pkg: $filter failed: $out"; failed=1 ;;
+    esac
+done
+[ "$failed" = 0 ] && setprop persist.thimsy.dexopt_done 1
+exit 0
diff --git a/frameworks/base/cmds/gammaos-nano/tools/gen_esde_emulators.py b/frameworks/base/cmds/gammaos-nano/tools/gen_esde_emulators.py
