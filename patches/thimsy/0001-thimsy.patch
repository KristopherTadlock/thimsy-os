+
+class ChargerTestPeer {
+  public:
+    explicit ChargerTestPeer(Charger* charger) : charger_(charger) {
+        charger_->InitDefaultAnimationFrames();
+        charger_->batt_anim_.frames = charger_->owned_frames_.data();
+        charger_->batt_anim_.num_frames = charger_->owned_frames_.size();
+    }
+    const animation& anim() const { return charger_->batt_anim_; }
+    int64_t next_screen_transition() const { return charger_->next_screen_transition_; }
+    bool idle_blanked() const { return charger_->idle_blanked_; }
+
+    // What UpdateScreenState() takes from the health info as an animation starts, before it draws.
+    void LatchAsAnimationStarts() {
+        charger_->batt_anim_.cur_level = charger_->health_info_.battery_level;
+        charger_->batt_anim_.cur_status = static_cast<int>(charger_->health_info_.battery_status);
+    }
+
+    // The state UpdateScreenState() leaves once the animation's cycles are over and it blanked.
+    void FinishAnimation() {
+        charger_->batt_anim_.cur_cycle = 0;
+        charger_->batt_anim_.cur_frame = 0;
+        charger_->batt_anim_.run = false;
+        charger_->next_screen_transition_ = -1;
+        charger_->screen_blanked_ = true;
+        charger_->idle_blanked_ = true;
+    }
+
+  private:
+    Charger* charger_;
+};
+
+static int64_t NowMs() {
+    timespec tm;
+    clock_gettime(CLOCK_MONOTONIC, &tm);
+    return tm.tv_sec * 1000LL + tm.tv_nsec / 1000000LL;
+}
+
+using aidl::android::hardware::health::BatteryStatus;
+
+TEST(ChargerBatteryAppears, UnknownThenChargingRestartsAnimation) {
+    FakeChargerConfiguration config;
+    Charger charger(&config);
+    ChargerTestPeer peer(&charger);
+
+    charger.OnHealthInfoChanged({.battery_level = 0, .battery_status = BatteryStatus::UNKNOWN});
+    peer.LatchAsAnimationStarts();
+    EXPECT_TRUE(HealthdDraw::ShowsUnknown(&peer.anim()));
+    peer.FinishAnimation();
+
+    charger.OnHealthInfoChanged({.battery_level = 50, .battery_status = BatteryStatus::CHARGING});
+    EXPECT_TRUE(peer.anim().run);
+    EXPECT_EQ(0, peer.anim().cur_cycle);
+    EXPECT_EQ(0, peer.anim().cur_frame);
+    EXPECT_NE(-1, peer.next_screen_transition());
+    EXPECT_LE(peer.next_screen_transition(), NowMs());
+    EXPECT_FALSE(peer.idle_blanked());
+    peer.LatchAsAnimationStarts();
+    EXPECT_EQ(50, peer.anim().cur_level);
+    EXPECT_FALSE(HealthdDraw::ShowsUnknown(&peer.anim()));
+}
+
+TEST(ChargerBatteryAppears, StillUnknownDoesNotRestart) {
+    FakeChargerConfiguration config;
+    Charger charger(&config);
+    ChargerTestPeer peer(&charger);
+
+    charger.OnHealthInfoChanged({.battery_level = 0, .battery_status = BatteryStatus::UNKNOWN});
+    peer.FinishAnimation();
+    charger.OnHealthInfoChanged({.battery_level = 0, .battery_status = BatteryStatus::UNKNOWN});
+    EXPECT_FALSE(peer.anim().run);
+    EXPECT_EQ(-1, peer.next_screen_transition());
+}
+
+TEST(ChargerBatteryAppears, LaterUnknownReadingDoesNotRestart) {
+    FakeChargerConfiguration config;
+    Charger charger(&config);
+    ChargerTestPeer peer(&charger);
+
+    charger.OnHealthInfoChanged({.battery_level = 0, .battery_status = BatteryStatus::UNKNOWN});
+    charger.OnHealthInfoChanged({.battery_level = 50, .battery_status = BatteryStatus::CHARGING});
+    peer.FinishAnimation();
+
+    // A status read that fails now and then must not light the screen at each recovery.
+    for (int i = 0; i < 3; i++) {
+        charger.OnHealthInfoChanged({.battery_level = 50, .battery_status = BatteryStatus::UNKNOWN});
+        charger.OnHealthInfoChanged({.battery_level = 50, .battery_status = BatteryStatus::CHARGING});
+    }
+    EXPECT_FALSE(peer.anim().run);
+    EXPECT_EQ(-1, peer.next_screen_transition());
+    EXPECT_TRUE(peer.idle_blanked());
+}
+
+TEST(ChargerBatteryAppears, KnownUpdateDoesNotRestart) {
+    FakeChargerConfiguration config;
+    Charger charger(&config);
+    ChargerTestPeer peer(&charger);
+
+    charger.OnHealthInfoChanged({.battery_level = 50, .battery_status = BatteryStatus::CHARGING});
+    peer.FinishAnimation();
+    charger.OnHealthInfoChanged({.battery_level = 51, .battery_status = BatteryStatus::CHARGING});
+    EXPECT_FALSE(peer.anim().run);
+    EXPECT_EQ(-1, peer.next_screen_transition());
+}
+
