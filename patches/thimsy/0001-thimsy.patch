+// Back on the Quick Menu's own level over a running app returns to the app, not the menu under it,
+// as it does on the Applications view Anbernic + Start opened over the app.
+bool NanoMenu::quickMenuBackResumes() const {
+    if (!(mOverlayMode && mOverlayShown && !mOverlayWallpaper)) return false;
+    if (mAppsSummoned && mPs3Stack.size() == 1 && applicationsViewOpen()) return true;
+    if (!quickMenuOpen()) return false;
+    return (mEsdeTheme || mEsdeSettingsMinima) ? mPs3Stack.size() == 1 : mPs3Stack.empty();
+}
