+// BatteryMonitor against a fake /sys/class/power_supply: a battery registered after init() (a
+// vendor module loading beside the off-mode charger) is found by a later update.
+
+#include <string.h>
+#include <sys/stat.h>
+
+#include <string>
+
+#include <aidl/android/hardware/health/HealthInfo.h>
+#include <android-base/file.h>
+#include <cutils/klog.h>
+#include <gtest/gtest.h>
+#include <healthd/BatteryMonitor.h>
+
+namespace android {
+void BatteryMonitorSetPowerSupplyPathForTest(const char* path);
+}  // namespace android
+
+static int gAppearedLogs = 0;
+
+#if !defined(__ANDROID__)
+// The host libcutils has no kernel log.
+void klog_write(int, const char* fmt, ...) {
+    if (strstr(fmt, "battery appeared after start")) gAppearedLogs++;
+}
+#endif
+
+using aidl::android::hardware::health::BatteryStatus;
+using android::BatteryMonitor;
+using android::base::WriteStringToFile;
+
+namespace {
+
+class BatteryMonitorRescanTest : public ::testing::Test {
+  protected:
+    void SetUp() override { android::BatteryMonitorSetPowerSupplyPathForTest(root_.path); }
+    void TearDown() override {
+        android::BatteryMonitorSetPowerSupplyPathForTest("/sys/class/power_supply");
+    }
+
+    std::string Dir(const std::string& name) { return std::string(root_.path) + "/" + name; }
+
+    void AddSupply(const std::string& name, const std::string& type) {
+        ASSERT_EQ(0, mkdir(Dir(name).c_str(), 0755));
+        Set(name, "type", type);
+    }
+
+    void Set(const std::string& name, const std::string& attr, const std::string& value) {
+        ASSERT_TRUE(WriteStringToFile(value + "\n", Dir(name) + "/" + attr));
+    }
+
+    void AddBattery(const std::string& name, const std::string& status, int capacity) {
+        AddSupply(name, "Battery");
+        Set(name, "status", status);
+        Set(name, "capacity", std::to_string(capacity));
+        Set(name, "present", "1");
+    }
+
+    void AddUsb(bool online) {
+        AddSupply("usb", "USB");
+        Set("usb", "online", online ? "1" : "0");
+    }
+
+    TemporaryDir root_;
+    healthd_config config_{};
+    BatteryMonitor monitor_;
+};
+
+TEST_F(BatteryMonitorRescanTest, BatteryAfterInitIsFound) {
+    monitor_.init(&config_);
+    monitor_.updateValues();
+    EXPECT_EQ(BatteryStatus::UNKNOWN, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_EQ(0, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_FALSE(monitor_.isChargerOnline());
+    EXPECT_TRUE(config_.batteryCapacityPath.empty());
+
+    AddUsb(true);
+    AddBattery("battery", "Charging", 50);
+    monitor_.updateValues();
+    EXPECT_EQ(BatteryStatus::CHARGING, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_EQ(50, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_TRUE(monitor_.getHealthInfo().batteryPresent);
+    EXPECT_TRUE(monitor_.getHealthInfo().chargerUsbOnline);
+    EXPECT_EQ(Dir("battery") + "/capacity", std::string(config_.batteryCapacityPath.c_str()));
+}
+
+TEST_F(BatteryMonitorRescanTest, FoundBatteryIsKept) {
+    monitor_.init(&config_);
+    AddBattery("battery", "Charging", 50);
+    monitor_.updateValues();
+    ASSERT_EQ(50, monitor_.getHealthInfo().batteryLevel);
+
+    // Once found, the paths stay: a second battery does not replace the first.
+    AddBattery("battery2", "Discharging", 10);
+    Set("battery", "capacity", "51");
+    monitor_.updateValues();
+    monitor_.updateValues();
+    EXPECT_EQ(51, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_EQ(BatteryStatus::CHARGING, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_EQ(Dir("battery") + "/status", std::string(config_.batteryStatusPath.c_str()));
+}
+
+TEST_F(BatteryMonitorRescanTest, BatteryAtInitNeedsNoRescan) {
+    AddBattery("battery", "Full", 100);
+    AddUsb(false);
+    monitor_.init(&config_);
+    monitor_.updateValues();
+    EXPECT_EQ(BatteryStatus::FULL, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_EQ(100, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_FALSE(monitor_.isChargerOnline());
+
+    Set("usb", "online", "1");
+    monitor_.updateValues();
+    EXPECT_TRUE(monitor_.getHealthInfo().chargerUsbOnline);
+}
+
+TEST_F(BatteryMonitorRescanTest, ChargerOnlineFollowsRescans) {
+    monitor_.init(&config_);
+    AddUsb(true);
+    // Many updates while no battery, each rescanning.
+    for (int i = 0; i < 5; i++) monitor_.updateValues();
+    EXPECT_TRUE(monitor_.getHealthInfo().chargerUsbOnline);
+    EXPECT_FALSE(monitor_.getHealthInfo().chargerAcOnline);
+    Set("usb", "online", "0");
+    monitor_.updateValues();
+    EXPECT_FALSE(monitor_.isChargerOnline());
+}
+
+TEST_F(BatteryMonitorRescanTest, BatteryFilesAfterItsFolderAreFound) {
+    monitor_.init(&config_);
+    const int logsBefore = gAppearedLogs;
+
+    // The kernel lists the battery before it adds the rest of its files.
+    AddSupply("battery", "Battery");
+    monitor_.updateValues();
+    EXPECT_TRUE(monitor_.getHealthInfo().batteryPresent);
+    EXPECT_EQ(BatteryStatus::UNKNOWN, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_TRUE(config_.batteryStatusPath.empty());
+    EXPECT_TRUE(config_.batteryCapacityPath.empty());
+
+    Set("battery", "status", "Charging");
+    Set("battery", "capacity", "50");
+    monitor_.updateValues();
+    EXPECT_EQ(BatteryStatus::CHARGING, monitor_.getHealthInfo().batteryStatus);
+    EXPECT_EQ(50, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_EQ(Dir("battery") + "/status", std::string(config_.batteryStatusPath.c_str()));
+    EXPECT_EQ(Dir("battery") + "/capacity", std::string(config_.batteryCapacityPath.c_str()));
+#if !defined(__ANDROID__)
+    EXPECT_EQ(logsBefore + 1, gAppearedLogs);
+#else
+    (void)logsBefore;
+#endif
+
+    // With status and capacity known the scans stop: a file added later is not looked for.
+    Set("battery", "present", "1");
+    monitor_.updateValues();
+    EXPECT_TRUE(config_.batteryPresentPath.empty());
+    EXPECT_TRUE(monitor_.getHealthInfo().batteryPresent);
+}
+
+TEST_F(BatteryMonitorRescanTest, BoardPathsAreKept) {
+    const std::string board = Dir("board_capacity");
+    ASSERT_TRUE(WriteStringToFile("77\n", board));
+    config_.batteryCapacityPath = board.c_str();
+    monitor_.init(&config_);
+    AddBattery("battery", "Charging", 50);
+    monitor_.updateValues();
+    EXPECT_EQ(board, std::string(config_.batteryCapacityPath.c_str()));
+    EXPECT_EQ(77, monitor_.getHealthInfo().batteryLevel);
+    EXPECT_EQ(BatteryStatus::CHARGING, monitor_.getHealthInfo().batteryStatus);
+}
+
+}  // namespace
