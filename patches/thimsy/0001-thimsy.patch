+// persist.thimsy.nano.fpslog=1: once a second, the frames drawn and what woke the loop.
+void NanoMenu::fpsLogTick(bool drew) {
+    static int64_t sCheckMs = 0, sWinMs = 0;
+    static bool sOn = false;
+    static int sFrames = 0, sWakes[7] = {};
+    const int64_t now = (int64_t)android::uptimeMillis();
+    if (now - sCheckMs >= 2000) { sCheckMs = now; sOn = property_get_bool("persist.thimsy.nano.fpslog", false); }
+    if (!sOn) { sWinMs = 0; return; }
+    if (sWinMs == 0) { sWinMs = now; sFrames = 0; std::fill(sWakes, sWakes + 7, 0); }
+    if (drew) sFrames++;
+    if (mIdleWaitReason >= 0 && mIdleWaitReason < 7) sWakes[mIdleWaitReason]++;
+    if (now - sWinMs < 1000) return;
