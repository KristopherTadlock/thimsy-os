-void arShapeVector(std::vector<uint32_t>& cps) {
-    const int n = (int)cps.size();
-    std::vector<uint32_t> out;
-    out.reserve(n);
-    for (int i = 0; i < n; i++) {
-        uint32_t cp = cps[i];
-        if (cp == 0x0644 && i + 1 < n) {   // lam + alef variant -> ligature
