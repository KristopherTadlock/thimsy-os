diff --git a/frameworks/base/services/core/java/com/android/server/wm/NanoRetroArchConfig.java b/frameworks/base/services/core/java/com/android/server/wm/NanoRetroArchConfig.java
new file mode 100644
index 00000000000..b50b92cce0f
--- /dev/null
+++ b/frameworks/base/services/core/java/com/android/server/wm/NanoRetroArchConfig.java
@@ -0,0 +1,72 @@
