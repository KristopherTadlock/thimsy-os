+// A DSi bottom-panel button pressed: it lights up briefly (DS units), drawn by drawNdsPressFlash.
+void NanoMenu::ndsPressFlash(float x, float y, float w, float h) {
+    mNdsFlashR = TouchRect{x, y, w, h};
