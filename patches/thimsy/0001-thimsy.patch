+// Finished gamelists into the metadata cache (render thread, once a frame and when waited for).
+void NanoMenu::esdeGamelistAdopt() {
+    if (!mEsdeGlPool) return;
+    std::vector<EsdeGamelistPool::Result> got;
+    mEsdeGlPool->take(&got);
+    for (auto& r : got) {
+        for (auto it = mEsdeGlReading.begin(); it != mEsdeGlReading.end(); ++it) {
+            if (it->second.id != r.id) continue;
+            const std::string sysId = it->first;
+            const bool first = it->second.first;
+            mEsdeGlReading.erase(it);
+            for (int i = 0; i < (int)mXmbSystems.size(); i++) {
+                if (mXmbSystems[i].id != sysId) continue;
+                esdeGamelistApply(i, first, std::move(r.meta));
+                mDisplayDirty = true;
+                break;
+            }   // the system is gone: nothing to apply
+            break;
+        }   // not pending any more: superseded by a newer read of the same system
     }
 }
 
+// The system's games' gamelist metadata replaced by meta. A change to ES-DE's favourites re-orders
+// the list (favoritesFirst), next frame.
+void NanoMenu::esdeGamelistApply(int sysIdx, bool first, std::vector<std::pair<std::string, ScrapeEntry>> meta) {
+    if (sysIdx < 0 || sysIdx >= (int)mXmbSystems.size()) return;
+    const auto& sys = mXmbSystems[sysIdx];
+    auto metaFavs = [&]() {
+        std::vector<std::string> v;
+        for (const auto& r : sys.roms) { auto it = mEsdeGamelistMeta.find(r); if (it != mEsdeGamelistMeta.end() && it->second.favorite) v.push_back(r); }
+        return v;
+    };
+    const std::vector<std::string> before = metaFavs();
+    for (const auto& r : sys.roms) mEsdeGamelistMeta.erase(r);
+    for (auto& kv : meta) mEsdeGamelistMeta[kv.first] = std::move(kv.second);
+    if (metaFavs() == before) return;
+    for (const auto& q : mFavResortSys) if (q.first == sysIdx) return;
+    mFavResortSys.push_back({sysIdx, first});
+}
+
+// Every ES-DE system's gamelist queued at idle priority, the focused one first.
+void NanoMenu::esdeGamelistPrefetch() {
+    mEsdeGlPrefetched = true;
+    const int n = (int)mEsdeSysList.size();
+    const int start = (mEsdeSysSel >= 0 && mEsdeSysSel < n) ? mEsdeSysSel : 0;
+    for (int k = 0; k < n; k++) esdeEnsureGamelistLoaded(mEsdeSysList[(start + k) % n], kGlPrefetch);
+    ALOGI("esde: %zu gamelist(s) queued at %lld ms", mEsdeGlReading.size(), (long long)uptimeMillis());
+}
