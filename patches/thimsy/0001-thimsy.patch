+// ---- Storage-media package: unpacked to the private folder before it is confirmed --------
+
+// A zip member name that stays inside the package folder.
+static bool safeMemberName(const std::string& n) {
+    if (n.empty() || n[0] == '/' || n.find('\\') != std::string::npos || n.find('\0') != std::string::npos)
+        return false;
+    size_t i = 0;
+    while (i <= n.size()) {
+        size_t e = n.find('/', i);
+        if (e == std::string::npos) e = n.size();
+        const std::string seg = n.substr(i, e - i);
+        if (seg == "..") return false;
+        i = e + 1;
+    }
+    return true;
+}
+
+namespace {
+struct UnpackSink {
+    int fd;
+    uint64_t done, total;
+    const std::function<bool()>* cancelled;
+    const std::function<void(int)>* progress;
+    int lastPct;
+    bool stopped;
+};
+}  // namespace
+
+static bool unpackWrite(const uint8_t* buf, size_t len, void* cookie) {
+    UnpackSink& s = *static_cast<UnpackSink*>(cookie);
+    if (*s.cancelled && (*s.cancelled)()) { s.stopped = true; return false; }
+    size_t off = 0;
+    while (off < len) {
+        const ssize_t n = write(s.fd, buf + off, len - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return false;
+        off += (size_t)n;
+    }
+    s.done += len;
+    const int pct = s.total ? (int)(s.done * 100 / s.total) : 100;
+    if (pct != s.lastPct && *s.progress) { s.lastPct = pct; (*s.progress)(pct); }
+    return true;
+}
+
+OtaUnpackStatus otaUnpackPackage(const std::string& zip, const std::function<bool()>& cancelled,
+                                 const std::function<void(int)>& progress) {
+    OtaUnpackStatus st;
+    ZipArchiveHandle za = nullptr;
+    // The archive stays open on one descriptor for the whole copy, so a file renamed over the
+    // chosen path meanwhile is not read.
+    if (OpenArchive(zip.c_str(), &za) != 0) {
+        CloseArchive(za);
+        st.result = OtaUnpackResult::Invalid;
+        return st;
+    }
+    struct Member { ZipEntry64 e; std::string name; };
+    std::vector<Member> members;
+    uint64_t total = 0;
+    bool manifest = false, bad = false;
+    void* cookie = nullptr;
+    if (StartIteration(za, &cookie) == 0) {
+        Member m;
+        int32_t r;
+        while ((r = Next(cookie, &m.e, &m.name)) == 0) {
+            if (!m.name.empty() && m.name.back() == '/') continue;   // folders are made as needed
+            if (!safeMemberName(m.name)) { bad = true; break; }
+            if (m.name == "manifest.json") manifest = true;
+            total += m.e.uncompressed_length;
+            members.push_back(m);
+        }
+        if (r < -1) bad = true;
+        EndIteration(cookie);
+    } else {
+        bad = true;
+    }
+    if (bad || !manifest) {
+        NOC_W("ota: %s is not an update package", zip.c_str());
+        CloseArchive(za);
+        st.result = OtaUnpackResult::Invalid;
+        return st;
+    }
+
+    otaRemovePackage();
+    mkdir(kOtaDir, 0700);
+    chmod(kOtaDir, 0700);
+    mkdir(kPackageDir, 0700);
+    struct statvfs vfs{};
+    const uint64_t margin = 64ull << 20;   // room for the flasher's log and staging files
+    if (statvfs(kOtaDir, &vfs) == 0) {
+        const uint64_t avail = (uint64_t)vfs.f_bavail * vfs.f_frsize;
+        if (total + margin > avail) {
+            CloseArchive(za);
+            st.result = OtaUnpackResult::NoSpace;
+            st.needBytes = total + margin;
+            st.freeBytes = avail;
+            return st;
+        }
+    }
+
+    UnpackSink sink{-1, 0, total, &cancelled, &progress, -1, false};
+    bool ok = true;
+    for (const Member& m : members) {
+        const std::string out = std::string(kPackageDir) + "/" + m.name;
+        for (size_t sl = out.find('/', strlen(kPackageDir) + 1); sl != std::string::npos; sl = out.find('/', sl + 1))
+            mkdir(out.substr(0, sl).c_str(), 0700);
+        sink.fd = open(out.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+        if (sink.fd < 0) { ok = false; break; }
+        const int32_t r = ProcessZipEntryContents(za, &m.e, unpackWrite, &sink);
+        const bool closed = close(sink.fd) == 0;
+        if (r != 0 || !closed) { ok = false; break; }
+    }
+    CloseArchive(za);
+    if (ok) sync();
+    if (!ok) {
+        otaRemovePackage();
+        st.result = sink.stopped ? OtaUnpackResult::Cancelled : OtaUnpackResult::Failed;
+        if (!sink.stopped) NOC_E("ota: could not unpack %s", zip.c_str());
+        return st;
+    }
+    NOC_I("ota: unpacked %s (%llu bytes) to %s", zip.c_str(), (unsigned long long)total, kPackageDir);
+    st.result = OtaUnpackResult::Ok;
+    return st;
+}
+
+void otaRemovePackage() {
+    removeTree(kPackageDir);
+}
+
+void otaDropStalePackage() {
+    if (android::base::GetProperty("init.svc.gammaos-ota", "") == "running") return;
+    if (fileExists(kPackageDir)) removeTree(kPackageDir);
+}
+
 }  // namespace nano
