+// Point the launch hand-off at browser activity comp ("pkg/Activity") opening url. Any browser
+// understands ACTION_VIEW with the URL as intent data, so the hand-off fires an explicit VIEW
+// intent instead of the bare LAUNCHER intent. The component MUST be included: the framework
+// resolves ActivityInfo from it, and without it the launch falls back to LAUNCHER and the URL is
+// dropped. Tab-delimited (parseAmIntent prefers tabs) so a URL can never be split on whitespace,
+// and written to the intent file because a URL routinely exceeds the 92-byte property limit.
+static void nanoWriteUrlLaunch(const std::string& comp, const std::string& url) {
+    const std::string pkg = comp.substr(0, comp.find('/'));
+    const std::string intent = "-n\t" + comp + "\t-a\tandroid.intent.action.VIEW\t-d\t" + url;
+    commitLaunch(LaunchTuple()
+            .app(pkg.c_str())
+            .launchedPkg(pkg.c_str()));
+    const char* f = "/data/system/nano_launch_intent.txt";
+    int ifd = open(f, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (ifd >= 0) { ssize_t w = write(ifd, intent.c_str(), intent.size()); (void)w; close(ifd); chmod(f, 0644); }
+    commitLaunch(LaunchTuple().intent(ifd >= 0 ? "file" : ""));
+}
