-                out.push_back(g ? g : cp);
-                i++;                 // consume the alef
-                continue;
-            }
-        }
-        const OskArShape* sh = arShapeFor(cp);
-        if (!sh) { out.push_back(cp); continue; }
-        bool joinPrev = sh->joinsRight && arNeighbourJoins(cps, i, -1);
-        bool joinNext = sh->joinsLeft  && arNeighbourJoins(cps, i, +1);
