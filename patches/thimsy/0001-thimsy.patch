+        final boolean clearForcedSize;
+
+        OldModes(List<String> clear, boolean clearForcedSize) {
+            this.clear = clear;
+            this.clearForcedSize = clearForcedSize;
+        }
+    }
+
+    /**
+     * @param props the OLD_MODE_PROPS and CLEARED_PROP values ("" or missing when unset)
+     * @param panelIsDisplay0 whether display 0 is the panel; with a monitor there, nothing yet
+     */
+    static OldModes oldModes(Map<String, String> props, boolean panelIsDisplay0) {
+        final List<String> clear = new ArrayList<>();
