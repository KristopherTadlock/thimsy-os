+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public class ThimsyStorageDenylistTest {
+
+    private static void assertOpen(String path) {
+        assertNull(path, getProtectedOwner(path));
+    }
+
+    /** Asserts that {@code path} is in a protected top-level folder of either kind. */
+    private static void assertNoOwner(String path) {
+        final String owner = getProtectedOwner(path);
+        assertTrue(path + " -> " + owner, NO_OWNER.equals(owner)
+                || ThimsyStorageDenylist.OWNED_FILES_ONLY.equals(owner));
+    }
+
+    private static void assertOwner(String owner, String path) {
+        assertEquals(path, owner, getProtectedOwner(path));
+    }
+
+    @Test
+    public void openFoldersStayOpen() {
+        assertOpen("/storage/emulated/0");
+        assertOpen("/storage/emulated/0/");
+        assertOpen("/storage/emulated/0/ROMs/psx/game.chd");
+        assertOpen("/storage/emulated/0/Download/file.zip");
+        assertOpen("/storage/emulated/0/BIOS/scph1001.bin");
+        assertOpen("/storage/emulated/0/Music/song.mp3");
+        assertOpen("/storage/emulated/0/emulator_config");
+        assertOpen("/storage/1234-ABCD/ROMs/gba/game.gba");
+        assertOpen("/storage/1234-ABCD");
+        assertOpen("/storage/emulated/0/ROMs/DCIM/x.png");
+        assertOpen("/storage/emulated/0/DCIMX/x.png");
+        assertOpen("/storage/emulated/0/MyDocuments");
+        assertOpen("/storage/emulated/0/Nano");
+        assertOpen("/storage/emulated/0/Nano Backups");
+    }
+
+    @Test
+    public void nonStoragePathsAreNotClassified() {
+        assertOpen(null);
+        assertOpen("");
+        assertOpen("DCIM/x.png");
+        assertOpen("/storage");
+        assertOpen("/storage/emulated");
+        assertOpen("/storage/emulated/DCIM");
+        assertOpen("/storage/self");
+        assertOpen("/proc/self/DCIM");
+        assertOpen("/sdcardx/DCIM");
+    }
+
+    @Test
+    public void androidFoldersThemselvesStayOpen() {
+        assertOpen("/storage/emulated/0/Android");
+        assertOpen("/storage/emulated/0/Android/data");
+        assertOpen("/storage/emulated/0/Android/obb/");
+        assertOpen("/storage/emulated/0/Android/media");
+        assertOpen("/storage/emulated/0/Android/data/.nomedia");
+        assertOpen("/storage/emulated/0/Android/other/com.foo");
+        assertOpen("/storage/emulated/0/Androidx/data/com.foo");
+    }
+
+    @Test
+    public void topLevelFoldersAreProtected() {
+        assertNoOwner("/storage/emulated/0/DCIM");
+        assertNoOwner("/storage/emulated/0/DCIM/");
+        assertNoOwner("/storage/emulated/0/DCIM/Camera/IMG_1.jpg");
+        assertNoOwner("/storage/emulated/0/Pictures/Screenshots/a.png");
+        assertNoOwner("/storage/emulated/0/Movies/a.mp4");
+        assertNoOwner("/storage/emulated/0/Recordings/a.m4a");
+        assertNoOwner("/storage/emulated/0/Documents/a.pdf");
+        assertNoOwner("/storage/emulated/0/Nano Backup/saves.tar");
+        assertNoOwner("/storage/emulated/10/DCIM/a.jpg");
+        assertNoOwner("/storage/1234-ABCD/Pictures/a.png");
+    }
+
+    @Test
+    public void ownedFilesFoldersAndRefusedFolders() {
+        for (String folder : new String[] {"DCIM", "Pictures", "Movies", "Recordings",
+                "Documents", "dcim", "PICTURES."}) {
+            assertEquals(folder, ThimsyStorageDenylist.OWNED_FILES_ONLY,
+                    getProtectedOwner("/storage/emulated/0/" + folder + "/a.jpg"));
+        }
+        assertEquals(NO_OWNER, getProtectedOwner("/storage/emulated/0/Nano Backup/x"));
+        assertEquals(NO_OWNER, getProtectedOwner("/storage/1234-ABCD/nano backup"));
+        assertFalse(isOwnerPackage(ThimsyStorageDenylist.OWNED_FILES_ONLY, "com.foo"));
+    }
+
+    @Test
+    public void caseAndTrailingDotsAndSpacesDoNotBypass() {
+        assertNoOwner("/storage/emulated/0/dcim/a.jpg");
+        assertNoOwner("/storage/emulated/0/PICTURES");
+        assertNoOwner("/storage/emulated/0/nano backup");
+        assertNoOwner("/storage/emulated/0/NANO BACKUP/x");
+        assertNoOwner("/storage/1234-ABCD/DCIM./a.jpg");
+        assertNoOwner("/storage/1234-ABCD/DCIM .. /a.jpg");
+        assertNoOwner("/storage/emulated/0/Documents /a.pdf");
+        assertNoOwner("/storage/emulated/0/Nano BacKup/x");
+    }
+
+    @Test
+    public void otherSpellingsDoNotBypass() {
+        assertNoOwner("/storage/self/primary/DCIM/a.jpg");
+        assertNoOwner("/sdcard/DCIM/a.jpg");
+        assertNoOwner("/sdcard/Pictures");
+        assertNoOwner("/mnt/user/0/emulated/0/DCIM/a.jpg");
+        assertNoOwner("/mnt/user/0/1234-ABCD/DCIM/a.jpg");
+        assertNoOwner("/mnt/pass_through/0/emulated/0/Movies/a.mp4");
+        assertNoOwner("/mnt/media_rw/1234-ABCD/Documents/a.pdf");
+        assertNoOwner("/data/media/0/Recordings/a.m4a");
+        assertOwner("com.foo", "/mnt/user/0/emulated/0/Android/data/com.foo/x");
+    }
+
+    @Test
+    public void dotSegmentsAndDoubleSlashesDoNotBypass() {
+        assertNoOwner("/storage/emulated/0//DCIM/a.jpg");
+        assertNoOwner("/storage//emulated/0/DCIM/a.jpg");
+        assertNoOwner("/storage/emulated/0/./DCIM/a.jpg");
+        assertNoOwner("/storage/emulated/0/ROMs/../DCIM/a.jpg");
+        assertNoOwner("/storage/emulated/0/Download/../../0/Pictures/a.png");
+        assertNoOwner("/storage/emulated/0/DCIM/Camera/..");
+        assertNoOwner("/storage/emulated/0/DCIM/.");
+        assertOpen("/storage/emulated/0/DCIM/..");
+        assertOpen("/storage/emulated/0/DCIM/../ROMs/a.bin");
+        assertOwner("com.foo", "/storage/emulated/0/Android/data/x/../com.foo/files");
+    }
+
+    @Test
+    public void appFoldersReturnTheirOwner() {
+        assertOwner("com.foo", "/storage/emulated/0/Android/data/com.foo");
+        assertOwner("com.foo", "/storage/emulated/0/Android/data/com.foo/files/save.srm");
+        assertOwner("com.foo", "/storage/emulated/0/Android/obb/com.foo/main.1.com.foo.obb");
+        assertOwner("com.foo", "/storage/emulated/0/Android/media/com.foo/a.jpg");
+        assertOwner("com.foo", "/storage/1234-ABCD/Android/data/com.foo/x");
+        assertOwner("COM.Foo", "/storage/emulated/0/ANDROID/DATA/COM.Foo/x");
+        assertOwner("com.foo", "/storage/1234-ABCD/Android./obb./com.foo./x");
+        assertOwner("com.foo", "/storage/emulated/0/Android/data/com.foo/");
+    }
+
+    @Test
+    public void ownerMatchesPackagesCaseInsensitively() {
+        assertTrue(isOwnerPackage("com.foo", "com.foo"));
+        assertTrue(isOwnerPackage("COM.FOO", "com.foo"));
+        assertFalse(isOwnerPackage("com.foo", "com.foobar"));
+        assertFalse(isOwnerPackage(NO_OWNER, "com.foo"));
+        assertFalse(isOwnerPackage(null, "com.foo"));
+    }
+
+    @Test
+    public void appDirContainers() {
+        assertTrue(isAppDirContainer("/storage/emulated/0/Android"));
+        assertTrue(isAppDirContainer("/storage/emulated/0/Android/"));
+        assertTrue(isAppDirContainer("/storage/emulated/0/android/DATA"));
+        assertTrue(isAppDirContainer("/storage/1234-ABCD/Android/obb/"));
+        assertTrue(isAppDirContainer("/storage/1234-ABCD/Android/media"));
+        assertTrue(isAppDirContainer("/storage/1234-ABCD/Android./data."));
+        assertTrue(isAppDirContainer("/storage/emulated/0/ROMs/../Android/data"));
+        assertFalse(isAppDirContainer("/storage/emulated/0"));
+        assertFalse(isAppDirContainer("/storage/emulated/0/Android/data/com.foo"));
+        assertFalse(isAppDirContainer("/storage/emulated/0/Android/other"));
+        assertFalse(isAppDirContainer("/storage/emulated/0/ROMs/Android/data"));
+        assertFalse(isAppDirContainer(null));
+    }
+
+    @Test
+    public void unicodeNamesAreFoldedWithoutFalsePositives() {
+        assertOpen("/storage/emulated/0/\u30b2\u30fc\u30e0/GBA/a.gba");
+        assertOpen("/storage/emulated/0/Juegos cl\u00e1sicos/a.sfc");
+        assertOpen("/storage/emulated/0/M\u00fasica/a.mp3");
+        assertOpen("/storage/1234-ABCD/\u00c9mulateurs/a.bin");
+        assertOpen("/storage/emulated/0/PICTUR~1/a.png");
+        assertNoOwner("/storage/emulated/0/DC\u200DIM/a.jpg");
+        assertNoOwner("/storage/emulated/0/D\u00ADCIM\uFEFF/a.jpg");
+        assertNoOwner("/storage/emulated/0/DCIM./a.jpg");
+        assertNoOwner("/storage/emulated/0/dcim/a.jpg");
+        assertNoOwner("/storage/emulated/0/Picture\u017F/a.png");
+        assertNoOwner("/storage/emulated/0/Nano Bac\u212Aup/x");
+        assertNoOwner("/storage/emulated/0/DCIM\u200B./a.jpg");
+        assertOwner("com.foo", "/storage/emulated/0/Android/da\u200Bta/com.foo/x");
+        assertEquals("musica", ThimsyStorageDenylist.foldName("MUSICA. "));
+        assertEquals("m\u00fasica", ThimsyStorageDenylist.foldName("Mu\u0301sica"));
+        assertTrue(ThimsyStorageDenylist.isShortNameAlias("PICTUR~1", "Pictures"));
+        assertTrue(ThimsyStorageDenylist.isShortNameAlias("recor~12", "Recordings"));
+        assertFalse(ThimsyStorageDenylist.isShortNameAlias("\u30b2\u30fc\u30e0", "DCIM"));
+        assertFalse(ThimsyStorageDenylist.isShortNameAlias("JUEGOS~1", "Documents"));
+    }
+
+    @Test
+    public void protectedFoldersAndAncestors() {
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/storage/emulated/0"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/storage/1234-ABCD/"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/storage/emulated/0/android"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor(
+                "/storage/emulated/0/Android/obb/"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/storage/emulated/0/DCIM"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor(
+                "/storage/emulated/0/Nano Backup/"));
+        assertTrue(ThimsyStorageDenylist.isProtectedFolderOrAncestor(
+                "/storage/emulated/0/ROMs/.."));
+        assertFalse(ThimsyStorageDenylist.isProtectedFolderOrAncestor(
+                "/storage/emulated/0/DCIM/Camera"));
+        assertFalse(ThimsyStorageDenylist.isProtectedFolderOrAncestor(
+                "/storage/emulated/0/Android/data/com.foo"));
+        assertFalse(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/storage/emulated/0/ROMs"));
+        assertFalse(ThimsyStorageDenylist.isProtectedFolderOrAncestor("/data/user/0"));
+    }
+
+    @Test
+    public void ambiguousFoldersAreFoundAndReplaced() {
+        final String sd = "/storage/1234-ABCD";
+        assertEquals(sd + "/PICTUR~1",
+                ThimsyStorageDenylist.getAmbiguousFolder(sd + "/PICTUR~1/a.png"));
+        assertEquals(sd + "/ANDROI~1", ThimsyStorageDenylist.getAmbiguousFolder(sd + "//ANDROI~1"));
+        assertEquals(sd + "/DOCUME~1", ThimsyStorageDenylist.getAmbiguousFolder(sd + "/DOCUME~1"));
+        assertEquals(sd + "/nanoba~2", ThimsyStorageDenylist.getAmbiguousFolder(sd + "/nanoba~2"));
+        assertEquals(sd + "/RE1A2B~1", ThimsyStorageDenylist.getAmbiguousFolder(sd + "/RE1A2B~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder("/storage/emulated/0/DC\u200DIM/a"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/PICTU~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/GAMES~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/RE1A2G~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/ROMs/a~1.bin"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/ROMs/\u00e9t\u00e9"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/Android/data/COMFOO~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd + "/Other/da~1"));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder(sd));
+        assertNull(ThimsyStorageDenylist.getAmbiguousFolder("/storage/emulated/0/ROMs/psx"));
+
+        assertArrayEquals(new String[] {"Pictures"},
+                ThimsyStorageDenylist.getAliasTargets(sd + "/PICTUR~1"));
+        assertArrayEquals(new String[] {"data"},
+                ThimsyStorageDenylist.getAliasTargets(sd + "/Android/DATA~1"));
+
+        final String resolved = ThimsyStorageDenylist.replaceFolder(sd + "//PICTUR~1/a.png",
+                sd + "/PICTUR~1", "Pictures");
+        assertEquals(sd + "/Pictures/a.png", resolved);
+        assertNoOwner(resolved);
+        assertOwner("com.foo", ThimsyStorageDenylist.replaceFolder(
+                sd + "/ANDROI~1/data/com.foo/x", sd + "/ANDROI~1", "Android"));
+        assertTrue(isAppDirContainer(ThimsyStorageDenylist.replaceFolder(
+                sd + "/ANDROI~1/obb", sd + "/ANDROI~1", "Android")));
+        assertEquals(sd + "/ROMs/a~1",
+                ThimsyStorageDenylist.replaceFolder(sd + "/ROMs/a~1", sd + "/PICTUR~1",
+                        "Pictures"));
+    }
+
+    @Test
+    public void hiddenRowsSelectionCoversProtectedFoldersAndOwnPackages() {
+        final String none = ThimsyStorageDenylist.buildHiddenRowsSelection(new String[0]);
+        assertTrue(none.startsWith("NOT (("));
+        assertFalse(none.contains("AND NOT"));
+        for (String pattern : new String[] {"'DCIM/%'", "'Pictures/%'", "'Movies/%'",
+                "'Recordings/%'", "'Documents/%'", "'Nano Backup/%'", "'Android/data/%/%'",
+                "'Android/obb/%/%'", "'Android/media/%/%'"}) {
+            assertTrue(pattern, none.contains(pattern));
+        }
+        assertTrue(none.contains("ifnull(relative_path, '') IN ('/', '')"));
+        assertFalse(none.contains("||"));
+
+        final String own = ThimsyStorageDenylist.buildHiddenRowsSelection(
+                new String[] {"com.my_app", "it's"});
+        assertTrue(own.contains("AND NOT ("));
+        assertTrue(own.contains("'Android/media/com.my\\_app/%' ESCAPE '\\'"));
+        assertTrue(own.contains("'Android/obb/com.my\\_app/%'"));
+        assertTrue(own.contains("'Android/data/it''s/%'"));
+        assertEquals(count(own, '('), count(own, ')'));
+    }
+
+    private static int count(String s, char c) {
+        int n = 0;
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) == c) {
+                n++;
+            }
+        }
+        return n;
+    }
+
