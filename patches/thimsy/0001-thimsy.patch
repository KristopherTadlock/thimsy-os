+# composer starts when they are there (by ctl.start: a property trigger would run only after the
+# boot action); SurfaceFlinger, started in the post-fs block below, waits for
+# the composer. Its composer is AOSP's default (vendor.hwcomposer-2-4), which other devices also name
+# theirs, so it is started early here only, with the power HAL it waits for before it registers (the
+# hal class starts only after /data is up). Normal boots only: the factory calibration mode loads no
+# display driver.
+on post-fs && property:ro.product.vendor.model=RGCUBE && property:ro.bootmode=normal
+    start vendor.power-default
+    start rgcube-display-wait
+
+service rgcube-display-wait /system/bin/sh -c "i=0; while { [ ! -e /dev/dri/card0 ] || [ ! -e /dev/mali0 ]; } && [ $$i -lt 500 ]; do sleep 0.01; i=$$((i + 1)); done; setprop ctl.start vendor.hwcomposer-2-4"
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
+# RG Cube: its LED driver (cust-leds, a GPIO LED driver that spends about a second in its probe) loads
+# in a process of its own beside the vendor's module loader, which loads one module at a time. It
+# needs only the SoC's GPIO, as when it loaded in the first stage.
+on early-init && property:ro.product.vendor.model=RGCUBE
+    start rgcube-leds-load
+
+service rgcube-leds-load /vendor/bin/modprobe -s -d /vendor/lib/modules cust-leds
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:vendor_modprobe:s0
+
+# RG Cube: the battery is a module the vendor's loader (started on early-init) loads, and the charger
+# (class_start charger, below) looks for it once, when it starts: started first, it shows "battery
+# unknown" for the whole charge. charger-manager registers "battery" last, after the fuel gauge and
+# the charger chip (aw32257). Before "on charger" below: actions on one trigger run in file order.
+on charger && property:ro.product.vendor.model=RGCUBE
+    start rgcube-chglog
+    wait /sys/class/power_supply/battery 10
+
+# RG Cube, TEMPORARY diagnostics for the off-mode charging screen; remove once it is known to show the
+# battery. Snapshots of the kernel log, the properties and the power supplies 3, 8, 20 and 45 s into
+# charger mode, each replacing the last (size-capped), in /metadata/gammaos/charger-*.txt: /metadata
+# is mounted read-write by the first stage in every boot mode. The next normal boot reads them (adb
+# root). The kernel log does not survive the restart out of charger mode.
+service rgcube-chglog /system/bin/sh -c "d=/metadata/gammaos; mkdir -p $$d; for t in 3 5 12 25; do sleep $$t; dmesg 2>&1 | tail -c 1048576 > $$d/charger-dmesg.txt; getprop 2>&1 | head -c 262144 > $$d/charger-props.txt; { cat /proc/uptime; ls -lZ /sys/class/power_supply/; for p in /sys/class/power_supply/*; do echo $$p $$(cat $$p/type $$p/status $$p/capacity $$p/online 2>&1); done; ps -A -o PID,ARGS; } 2>&1 | head -c 65536 > $$d/charger-psy.txt; sync; done"
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
 on post-fs
     # vdc checkpoint bookkeeping should not block the rest of the boot sequence.
     exec_background - system system -- /system/bin/vdc checkpoint markBootAttempt
