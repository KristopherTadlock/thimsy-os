+#if SPD_WIN
+/* What Windows has for the connected Unisoc USB devices (any product
+   ID): seen gets "1782:4d00 sprdvcom Ports COM9; ..." (empty when there's
+   none). For one in download mode (1782:4d00) that WinUSB doesn't run,
+   other gets what it has and the result says what it is: 4 Unisoc's own
+   driver with its serial port (other gets the port, "COM9"), 1 another
+   driver, 3 no driver or a problem (also how a device looks for a moment
+   while Windows sets it up). 0 otherwise. */
+static int win_scan(char *seen, size_t seen_len, char *other, size_t other_len) {
+	SP_DEVINFO_DATA info;
+	DWORD idx;
+	int found = 0;
+	size_t used = 0;
+	HDEVINFO set = SetupDiGetClassDevsA(NULL, "USB", NULL,
+			DIGCF_PRESENT | DIGCF_ALLCLASSES);
+	seen[0] = 0;
+	if (set == INVALID_HANDLE_VALUE) return 0;
+	for (idx = 0; ; idx++) {
+		char ids[2048], cls[64], svc[64], port[64], pid[5], one[200], prob[24];
+		const char *p;
+		DWORD type = 0, size = 0, plen = sizeof(port) - 1, i;
+		ULONG st = 0, pr = 0;
+		HKEY key;
+		info.cbSize = sizeof(info);
+		if (!SetupDiEnumDeviceInfo(set, idx, &info)) break;
+		memset(ids, 0, sizeof(ids));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_HARDWAREID,
+				&type, (BYTE*)ids, sizeof(ids) - 2, &size)) continue;
+		if (size >= 2) ids[size - 1] = ids[size - 2] = 0;
+		for (i = 0; i < size; i++) ids[i] = toupper((unsigned char)ids[i]);
+		p = strstr(ids, "VID_1782&PID_");
+		if (!p) continue;
+		snprintf(pid, sizeof(pid), "%s", p + 13);
+		for (i = 0; i < 4; i++) pid[i] = tolower((unsigned char)pid[i]);
+		memset(cls, 0, sizeof(cls));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_CLASS,
+				NULL, (BYTE*)cls, sizeof(cls) - 1, NULL)) strcpy(cls, "no class");
+		memset(svc, 0, sizeof(svc));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_SERVICE,
+				NULL, (BYTE*)svc, sizeof(svc) - 1, NULL)) svc[0] = 0;
+		memset(port, 0, sizeof(port));
+		key = SetupDiOpenDevRegKey(set, &info, DICS_FLAG_GLOBAL, 0,
+				DIREG_DEV, KEY_READ);
+		if (key != INVALID_HANDLE_VALUE) {
+			if (RegQueryValueExA(key, "PortName", NULL, &type, (BYTE*)port,
+					&plen) != ERROR_SUCCESS || type != REG_SZ) port[0] = 0;
+			RegCloseKey(key);
+		}
+		prob[0] = 0;
+		if (CM_Get_DevNode_Status(&st, &pr, info.DevInst, 0) == CR_SUCCESS &&
+				(st & DN_HAS_PROBLEM))
+			snprintf(prob, sizeof(prob), " problem %lu", (unsigned long)pr);
+		snprintf(one, sizeof(one), "1782:%s %s %s%s%s%s",
+				pid, svc[0] ? svc : "no driver", cls,
+				port[0] ? " " : "", port, prob);
+		if (used + strlen(one) + 3 < seen_len)
+			used += snprintf(seen + used, seen_len - used, "%s%s",
+					used ? "; " : "", one);
+		if (!found && !strcmp(pid, "4d00") &&
+				(_stricmp(svc, "WinUSB") || prob[0])) {
+			snprintf(other, other_len, "%s", one + 10);
+			found = svc[0] && !prob[0] ? 1 : 3;
+			if (found == 1 && !_stricmp(svc, "sprdvcom") &&
+					!_strnicmp(port, "COM", 3) && atoi(port + 3) > 0) {
+				snprintf(other, other_len, "%s", port);
+				found = 4;
+			}
+		}
+	}
+	SetupDiDestroyDeviceInfoList(set);
+	return found;
+}
+
+/* The device through libusb (WinUSB). *err_out: why it couldn't be opened
+   (another driver), or 0 when it isn't connected. */
+static libusb_device_handle *win_usb_open(int *err_out) {
+	libusb_device **list;
+	libusb_device_handle *handle = NULL;
+	ssize_t i, n = libusb_get_device_list(NULL, &list);
+	int err = 0;
+	for (i = 0; i < n; i++) {
+		struct libusb_device_descriptor desc;
+		if (libusb_get_device_descriptor(list[i], &desc) < 0) continue;
+		if (desc.idVendor != 0x1782 || desc.idProduct != 0x4d00) continue;
+		err = libusb_open(list[i], &handle);
+		if (err >= 0) break;
+		handle = NULL;
+	}
+	if (n >= 0) libusb_free_device_list(list, 1);
+	*err_out = handle ? 0 : err;
+	return handle;
+}
+
+/* Unisoc's driver sends the control request smartphone chipsets need
+   (see "fdl" below) itself when its port is opened ("SprdVendorRequest").
+   Its serial port, opened the way Channel9.dll opens it: overlapped,
+   buffers cleared, 115200 8N1 with the driver's own DTR/RTS handling,
+   4 KB queues, 2 s (plus 1 ms a byte) for a write. Reads return as soon
+   as anything arrives, or after 100 ms (the reader thread keeps one
+   going). 0 if it couldn't be opened (*err: why). */
+static HANDLE win_com_open(const char *port, DWORD *err) {
+	char path[32];
+	HANDLE h;
+	DCB dcb;
+	COMMTIMEOUTS t;
+	snprintf(path, sizeof(path), "\\\\.\\%s", port);
+	h = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, 0, NULL,
+			OPEN_EXISTING, FILE_FLAG_OVERLAPPED | FILE_ATTRIBUTE_NORMAL, NULL);
+	if (h == INVALID_HANDLE_VALUE) {
+		*err = GetLastError();
+		return NULL;
+	}
+	PurgeComm(h, PURGE_TXABORT | PURGE_RXABORT | PURGE_TXCLEAR | PURGE_RXCLEAR);
+	memset(&dcb, 0, sizeof(dcb));
+	dcb.DCBlength = sizeof(dcb);
+	if (GetCommState(h, &dcb)) {
+		dcb.BaudRate = 115200;
+		dcb.fBinary = TRUE;
+		dcb.fParity = FALSE;
+		dcb.ByteSize = 8;
+		dcb.Parity = NOPARITY;
+		dcb.StopBits = ONESTOPBIT;
+		SetCommState(h, &dcb);
+	}
+	SetupComm(h, 4096, 4096);
+	memset(&t, 0, sizeof(t));
+	t.ReadIntervalTimeout = MAXDWORD;
+	t.ReadTotalTimeoutMultiplier = MAXDWORD;
+	t.ReadTotalTimeoutConstant = 100;
+	t.WriteTotalTimeoutMultiplier = 1;
+	t.WriteTotalTimeoutConstant = 2000;
+	SetCommTimeouts(h, &t);
+	return h;
+}
+
+/* What the device sends, read as it arrives (the way Channel9.dll does
+   for Unisoc's tools): a thread keeps reading the port, so the device is
+   never left waiting to send, and the protocol takes the data from here.
+   (The bootloader won't take a command while an answer of its own is
+   still waiting to be read.) */
+struct win_rx {
+	CRITICAL_SECTION lock;
+	HANDLE event;	/* set while there's data, or after a failure */
+	HANDLE thread, ready;
+	DWORD tid;
+	uint8_t *buf;
+	size_t head, len, cap;
+	volatile LONG stop;
+	int failed;
+};
+
+static struct win_rx *rx_new(void) {
+	struct win_rx *rx = (struct win_rx*)calloc(1, sizeof(*rx));
+	if (!rx) return NULL;
+	rx->cap = 1 << 20;
+	rx->buf = (uint8_t*)malloc(rx->cap);
+	rx->event = CreateEventA(NULL, TRUE, FALSE, NULL);
+	rx->ready = CreateEventA(NULL, TRUE, FALSE, NULL);
+	if (!rx->buf || !rx->event || !rx->ready) {
+		if (rx->event) CloseHandle(rx->event);
+		if (rx->ready) CloseHandle(rx->ready);
+		free(rx->buf);
+		free(rx);
+		return NULL;
+	}
+	InitializeCriticalSection(&rx->lock);
+	return rx;
+}
+
+static void rx_put(struct win_rx *rx, const void *data, size_t n) {
+	EnterCriticalSection(&rx->lock);
+	if (rx->len + n > rx->cap && rx->head) {
+		memmove(rx->buf, rx->buf + rx->head, rx->len - rx->head);
+		rx->len -= rx->head;
+		rx->head = 0;
+	}
+	if (rx->len + n > rx->cap) {
+		size_t cap = rx->cap;
+		uint8_t *b;
+		while (cap < rx->len + n) cap *= 2;
+		b = (uint8_t*)realloc(rx->buf, cap);
+		if (!b) rx->failed = 1;
+		else {
+			rx->buf = b;
+			rx->cap = cap;
+		}
+	}
+	if (!rx->failed) {
+		memcpy(rx->buf + rx->len, data, n);
+		rx->len += n;
+	}
+	SetEvent(rx->event);
+	LeaveCriticalSection(&rx->lock);
+}
+
+static void rx_fail(struct win_rx *rx) {
+	EnterCriticalSection(&rx->lock);
+	rx->failed = 1;
+	SetEvent(rx->event);
+	LeaveCriticalSection(&rx->lock);
+}
+
+/* Up to len bytes of what arrived, waiting up to timeout ms (<= 0: no
+   limit) for some; 0 on timeout, -1 once reading failed. */
+static int rx_get(struct win_rx *rx, void *buf, int len, int timeout) {
+	DWORD start = GetTickCount();
+	for (;;) {
+		DWORD wait = INFINITE, spent;
+		EnterCriticalSection(&rx->lock);
+		if (rx->len > rx->head) {
+			size_t n = rx->len - rx->head;
+			if (n > (size_t)len) n = (size_t)len;
+			memcpy(buf, rx->buf + rx->head, n);
+			rx->head += n;
+			if (rx->head == rx->len) {
+				rx->head = rx->len = 0;
+				if (!rx->failed) ResetEvent(rx->event);
+			}
+			LeaveCriticalSection(&rx->lock);
+			return (int)n;
+		}
+		if (rx->failed) {
+			LeaveCriticalSection(&rx->lock);
+			return -1;
+		}
+		ResetEvent(rx->event);
+		LeaveCriticalSection(&rx->lock);
+		if (timeout > 0) {
+			spent = GetTickCount() - start;
+			if (spent >= (DWORD)timeout) return 0;
+			wait = (DWORD)timeout - spent;
+		}
+		if (WaitForSingleObject(rx->event, wait) != WAIT_OBJECT_0) return 0;
+	}
+}
+
+/* Forgets what arrived and wasn't read. */
+static void rx_clear(struct win_rx *rx) {
+	EnterCriticalSection(&rx->lock);
+	rx->head = rx->len = 0;
+	if (!rx->failed) ResetEvent(rx->event);
+	LeaveCriticalSection(&rx->lock);
+}
+
+static void rx_free(struct win_rx *rx) {
+	if (!rx) return;
+	if (rx->thread) CloseHandle(rx->thread);
+	CloseHandle(rx->event);
+	CloseHandle(rx->ready);
+	DeleteCriticalSection(&rx->lock);
+	free(rx->buf);
+	free(rx);
+}
+
+/* The reader thread for Windows serial I/O. */
+static DWORD WINAPI com_reader(LPVOID arg) {
+	spdio_t *io = (spdio_t*)arg;
+	struct win_rx *rx = io->rx;
+	uint8_t buf[4096];
+	OVERLAPPED ov;
+	memset(&ov, 0, sizeof(ov));
+	ov.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+	if (!ov.hEvent) {
+		rx_fail(rx);
+		return 1;
+	}
+	while (!rx->stop) {
+		DWORD n = 0;
+		ResetEvent(ov.hEvent);
+		if (!ReadFile(io->com, buf, sizeof(buf), &n, &ov)) {
+			if (GetLastError() != ERROR_IO_PENDING ||
+					!GetOverlappedResult(io->com, &ov, &n, TRUE)) {
+				if (!rx->stop) rx_fail(rx);
+				break;
+			}
+		}
+		if (n) rx_put(rx, buf, n);
+	}
+	CloseHandle(ov.hEvent);
+	return 0;
+}
+
+/* Channel9.dll's COM channel (its interface: a C++ object whose methods
+   are thiscall; the DLL is 32-bit). Loaded only from spd_dump.exe's own
+   folder. */
+#if defined(__i386__)
+#define C9 1
+typedef BOOL (*c9_create_t)(void **channel, int type);
+typedef void (*c9_release_t)(void *channel);
+typedef BOOL (__thiscall *c9_open_t)(void *self, void *attr);
+typedef void (__thiscall *c9_close_t)(void *self);
+typedef DWORD (__thiscall *c9_write_t)(void *self, void *data, DWORD size,
+		DWORD reserved);
+typedef BOOL (__thiscall *c9_set_receiver_t)(void *self, ULONG msg,
+		BOOL by_thread, const void *receiver);
+typedef void (__thiscall *c9_free_mem_t)(void *self, void *mem);
+enum { C9_SET_RECEIVER = 2, C9_OPEN = 4, C9_CLOSE = 5, C9_WRITE = 8,
+		C9_FREE_MEM = 9 };
+/* The message its reading thread sends ours: wParam the data (freed with
+   FreeMem), lParam its size. */
+#define C9_MSG (WM_USER + 1)
+static c9_create_t c9_create;
+static c9_release_t c9_release;
+
+static void *c9_method(void *self, int n) {
+	return (*(void***)self)[n];
+}
+
+/* Whether Channel9.dll is there and could be loaded. */
+static int c9_load(void) {
+	static int tried, ok;
+	WCHAR dir[MAX_PATH + 16];
+	DWORD n;
+	HMODULE lib;
+	if (tried) return ok;
+	tried = 1;
+	n = GetModuleFileNameW(NULL, dir, MAX_PATH);
+	if (!n || n >= MAX_PATH) return 0;
+	while (n && dir[n - 1] != L'\\') n--;
+	if (!n) return 0;
+	wcscpy(dir + n, L"Channel9.dll");
+	if (GetFileAttributesW(dir) == INVALID_FILE_ATTRIBUTES) return 0;
+	lib = LoadLibraryExW(dir, NULL, LOAD_WITH_ALTERED_SEARCH_PATH);
+	if (!lib) {
+		DBG_LOG("Channel9.dll couldn't be loaded (error %lu)\n",
+				(unsigned long)GetLastError());
+		return 0;
+	}
+	c9_create = (c9_create_t)(void*)GetProcAddress(lib, "CreateChannel");
+	c9_release = (c9_release_t)(void*)GetProcAddress(lib, "ReleaseChannel");
+	ok = c9_create && c9_release;
+	if (!ok) DBG_LOG("Channel9.dll has no CreateChannel/ReleaseChannel\n");
+	return ok;
+}
+
+/* Our thread that takes what Channel9.dll's own reading thread got. */
+static DWORD WINAPI c9_receiver(LPVOID arg) {
+	spdio_t *io = (spdio_t*)arg;
+	MSG msg;
+	/* The thread's message queue exists from here. */
+	PeekMessageA(&msg, NULL, 0, 0, PM_NOREMOVE);
+	SetEvent(io->rx->ready);
+	while (GetMessageA(&msg, NULL, 0, 0) > 0) {
+		if (msg.message != C9_MSG) continue;
+		if (msg.wParam && msg.lParam > 0)
+			rx_put(io->rx, (const void*)msg.wParam, (size_t)msg.lParam);
+		if (msg.wParam)
+			((c9_free_mem_t)c9_method(io->c9, C9_FREE_MEM))(io->c9,
+					(void*)msg.wParam);
+	}
+	return 0;
+}
+
+/* Opens the port through Channel9.dll the way Unisoc's tools do: with
+   its reading thread sending what arrives to ours ("async" mode). */
+static int c9_open(spdio_t *io, const char *port) {
+	struct { int type; DWORD port, baud, pad; } attr = { 0, 0, 115200, 0 };
+	void *ch = NULL;
+	attr.port = (DWORD)atoi(port + 3);
+	if (!c9_create(&ch, 0) || !ch) return 0;
+	io->c9 = ch;
+	io->rx->thread = CreateThread(NULL, 0, c9_receiver, io, 0, &io->rx->tid);
+	if (!io->rx->thread ||
+			WaitForSingleObject(io->rx->ready, 5000) != WAIT_OBJECT_0)
+		return 0;
+	if (!((c9_set_receiver_t)c9_method(ch, C9_SET_RECEIVER))(ch, C9_MSG,
+			TRUE, (const void*)(ULONG_PTR)io->rx->tid))
+		return 0;
+	return ((c9_open_t)c9_method(ch, C9_OPEN))(ch, &attr) ? 1 : 0;
+}
+#else
+#define C9 0
+#endif
+
+/* Writes all of buf; -1 on error. */
+static int win_ser_write(spdio_t *io, const void *buf, int len) {
+	int done = 0;
+#if C9
+	if (io->kind == 2)
+		return (int)((c9_write_t)c9_method(io->c9, C9_WRITE))(io->c9,
+				(void*)buf, (DWORD)len, 0);
+#endif
+	while (done < len) {
+		OVERLAPPED ov;
+		DWORD n = 0, e;
+		COMSTAT cs;
+		ClearCommError(io->com, &e, &cs);
+		memset(&ov, 0, sizeof(ov));
+		ov.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+		if (!ov.hEvent) return -1;
+		if (!WriteFile(io->com, (const char*)buf + done, len - done, &n, &ov)) {
+			if (GetLastError() != ERROR_IO_PENDING ||
+					!GetOverlappedResult(io->com, &ov, &n, TRUE)) {
+				CloseHandle(ov.hEvent);
+				return -1;
+			}
+		}
+		CloseHandle(ov.hEvent);
+		if (!n) return -1;
+		done += n;
+	}
+	return done;
+}
+
+/* Reads what arrived within timeout ms (<= 0: no limit); 0 on timeout,
+   -1 on error. */
+static int win_ser_read(spdio_t *io, void *buf, int len, int timeout) {
+	return rx_get(io->rx, buf, len, timeout);
+}
+
+static void win_ser_close(spdio_t *io) {
+	struct win_rx *rx = io->rx;
+#if C9
+	if (io->kind == 2) {
+		if (io->c9) ((c9_close_t)c9_method(io->c9, C9_CLOSE))(io->c9);
+		if (rx && rx->thread) {
+			PostThreadMessageA(rx->tid, WM_QUIT, 0, 0);
+			WaitForSingleObject(rx->thread, 5000);
+		}
+		if (io->c9) c9_release(io->c9);
+		io->c9 = NULL;
+	}
+#endif
+	if (io->kind == 1 && rx && rx->thread) {
+		/* Its read ends within 100 ms. */
+		InterlockedExchange(&rx->stop, 1);
+		WaitForSingleObject(rx->thread, 5000);
+	}
+	if (io->com != INVALID_HANDLE_VALUE) CloseHandle(io->com);
+	io->com = INVALID_HANDLE_VALUE;
+	rx_free(rx);
+	io->rx = NULL;
+}
+#endif
